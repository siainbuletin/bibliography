	author = {Gonzalez, Francisco J.},
	date = {2006-12},
	file = {Gonzalez - 2006 - Whose Metaphysics of Presence Heidegger's Interpretation of Energeia and Dunamis in A.pdf:/Users/siainbuletin/Zotero/storage/ED9JP66Q/Gonzalez - 2006 - Whose Metaphysics of Presence Heidegger's Interpretation of Energeia and Dunamis in A.pdf:application/pdf},
