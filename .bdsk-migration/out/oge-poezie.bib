@article{dillheidegger-,
	author = {Dill, Matt},
	date = {2017},
	journal = {European Journal of Philosophy},
	number = {2},
	pages = {294--311},
	title = {Heidegger, {{Art}}, and the {{Overcoming}} of {{Metaphysics}}},
	volume = {25},
	zotero-field = {Snapshot:/Users/siainbuletin/Zotero/storage/WK9RG5KZ/ejop.html:text/html},
	abstract = {In this paper, I advance a new interpretation of Heidegger's reflections on art as we find them in his essay, `The Origin of the Work of Art'. I begin, in Section 1, by uncovering the fundamental concern that motivates Heidegger's essay. I show that Heidegger's reflections on art are part of his attempt to uncover a path beyond the history of metaphysics. I then suggest, in Section 2, that while Heidegger does think that art may allow for the overcoming of metaphysics, recent interpreters [Dreyfus (), Thomson (), and Young ()] have mistook the kind of art that Heidegger has in mind here. The kind of art that can allow for the overcoming of metaphysics, I argue, is not art that simply thematizes and/or reconfigures cultural worlds (as these interpreters have argued). It is instead what Heidegger calls `primal poesy'. After discussing the nature of primal poesy, I show in more detail how this kind of art may be capable of getting us beyond the history of metaphysics in Section 3. Finally, in Section 4, I reconsider the more common reading of `The Origin of the Work of Art' in light of the interpretation I've offered in Sections 2 and 3.},
	bdsk-url-1 = {https://onlinelibrary.wiley.com/doi/abs/10.1111/ejop.12165},
	bdsk-url-2 = {https://doi.org/10.1111/ejop.12165}}

