@incollection{justthe-poetic,
	author = {Just, Daniel},
	booktitle = {Literature and Its {{Language}}: {{Philosophical Aspects}}},
	date = {2022},
	editor = {Hagberg, Garry L.},
	keywords = {Attention,Language-game,Ordinary language,Performatives,Raymond Carver,Utterance},
	pages = {25--51},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {The {{Poetics}} of the {{Unpoetic}}: {{Literature}}, {{Ordinariness}}, and {{Raymond Carver}}'s {{Minimalist Realism}}},
	abstract = {This study examines the idiosyncratic form of realism in Raymond Carver's short stories as a type of utterance that brings together two ostensibly incompatible varieties or registers of language: the ordinary language of everyday communication with a low level of literariness and the special use of language that Wittgenstein calls \enquote{idling} and that emerges once we stop utilizing language routinely as a tool of our daily interaction, become conscious of it, isolate it, and deploy it in more deliberate and imaginative ways. Carver's stories painstakingly create an impression of plainness and artlessness that draws our attention to the singularity and ordinariness of what is at hand at each moment. Their meaning as a distinctive type of utterance is that nothing matters more than anything else. Carver invents a world and a language-game in which everything is the way it is and in which one does not discriminate or even prefer: a world in which everything is of equal value and a language-game that affirms this world.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12330-6_2}}

