@incollection{parkin-gounelasrehearsing,
	author = {Parkin-Gounelas, Ruth},
	booktitle = {Literature and Its {{Language}}: {{Philosophical Aspects}}},
	date = {2022},
	editor = {Hagberg, Garry L.},
	keywords = {Alain Badiou,Anticipation,Declarative event,Entrainment,Expectation,Poetic utterance,Rhythm,Sound,Uncanny},
	pages = {245--274},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {Rehearsing the {{Unexpected}}: {{Poetry}} and {{Rhythm}} in the ({{New}}) {{Age}} of the {{Poets}}},
	abstract = {This essay explores the recent debates taking place among Continental philosophers to do with the significance for philosophy of poetry, the poetic utterance. Philosophy, Alain Badiou has argued, has been in crisis since the dethroning of the cogito, and needs to explore the way poetry can provide access to new forms of truth. Crucial to the poetic utterance, which is always a declarative \enquote{event}, is the role of rhythm and sound, what Mallarm{\'e} called \enquote{the song beneath the text}. In their disruption of signification, it is well recognized, the formal features of the poem free language up to impact on the senses. But exactly how this comes about is a complex and usually avoided question. This essay attempts some tentative answers to do with involuntary bodily responses, entrained and internalized social rhythms, and the role of anticipation and expectation in poetic reading. Drawing on work in philosophy, psychoanalysis, aesthetics, political ecology and the musicology of perception, it attempts to understand how so much poetry can arouse a \enquote{chills} effect.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12330-6_12}}

