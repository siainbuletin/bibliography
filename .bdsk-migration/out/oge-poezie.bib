@article{coxheada-close-ex,
	author = {Coxhead, Michael A.},
	date = {2012-06-01},
	journal = {Studies in History and Philosophy of Science Part A},
	keywords = {Ancient Greek philosophy,Aristotle,History of science,Mechanics,Poetry},
	number = {2},
	pages = {300--306},
	series = {Structures and {{Strategies}} in {{Ancient Greek}} and {{Roman Technical Writing}}},
	shortjournal = {Studies in History and Philosophy of Science Part A},
	title = {A Close Examination of the Pseudo-{{Aristotelian Mechanical Problems}}: {{The}} Homology between Mechanics and Poetry as Techn{\=e}},
	volume = {43},
	zotero-field = {ScienceDirect Snapshot:/Users/siainbuletin/Zotero/storage/LJRYS28J/S0039368111001269.html:text/html},
	abstract = {The pseudo-Aristotelian Mechanical Problems is the earliest known ancient Greek text on mechanics, principally concerned with the explanation of a variety of mechanical phenomena using a particular construal of the principle of the lever. In the introduction, the author---thought to be an early Peripatetic---quotes the tragic poet Antiphon to summarise a discussion of the techn{\=e}-physis (art-nature) relationship and the status of mechanics as a techn{\=e}. I argue that this citation of a poet is an Aristotelian cultural signature, intended to guide its readers towards a better understanding of the nature of mechanics as expounded in the Mechanical Problems. By analysing several instances where Aristotle cites Antiphon (as well as other tragic poets) in the Aristotelian corpus, I propose that both the author of the Mechanical Problems and Aristotle use poets for the purpose of persuasion. This is in turn explained by understanding the homologous relationship between mechanics-as-techn{\=e} (according to the author of the Mechanical Problems) and poetics-as-techn{\=e} (according to Aristotle) in terms of their shared status as poi{\=e}tik{\=e} techn{\=e} (productive art) and claims to universal knowledge. A final facet of the proposed relationship between mechanics and poetry is hypothesised on the grounds of their mimetic nature.},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0039368111001269},
	bdsk-url-2 = {https://doi.org/10.1016/j.shpsa.2011.12.015}}

@article{creeserhetorical,
	author = {Creese, David},
	date = {2012-06-01},
	journal = {Studies in History and Philosophy of Science Part A},
	keywords = {Canonics,Harmonics,Monochord,Music,Philo of Alexandria,Plutarch},
	number = {2},
	pages = {258--269},
	series = {Structures and {{Strategies}} in {{Ancient Greek}} and {{Roman Technical Writing}}},
	shortjournal = {Studies in History and Philosophy of Science Part A},
	title = {Rhetorical Uses of Mathematical Harmonics in {{Philo}} and {{Plutarch}}},
	volume = {43},
	zotero-field = {ScienceDirect Snapshot:/Users/siainbuletin/Zotero/storage/8V3AVY3D/S0039368111001312.html:text/html},
	abstract = {The branch of harmonic science called `canonics' is rarely discussed outside specialist literature in Greek antiquity. Two exceptions are discussed in this paper: one reference to the science and another to its practitioners, both in non-specialist texts (Philo of Alexandria, De opificio mundi 96; Plutarch, Quaestiones convivales iii.9). Because both texts contain erroneous claims given under the authority of canonics, the interpretation of these references is problematic. The two passages are discussed and compared in an attempt to account for the errors contained in them, and to expose the rhetorical aims of each author and the methods by which the technical terms and concepts of an ancient science could be made to serve very different ends in a non-scientific context.},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0039368111001312},
	bdsk-url-2 = {https://doi.org/10.1016/j.shpsa.2011.12.020}}

