@incollection{wong2022the-flux-o,
	author = {Wong, Kwok Kui},
	booktitle = {Time and {{Poetic Speech}}: {{A Philosophical Investigation}}},
	editor = {Wong, Kwok Kui},
	keywords = {Heideggerian being,Distentio animi,Extension,Flux,Flux of consciousness,Infinite division,Inner sense,Unmoving "I",Zeitigung},
	pages = {9--31},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {The {{Flux}} of {{Time}}},
	year = {2022},
	abstract = {In Western philosophy, time has often been described as or compared with flux, a flow, or a river. These philosophical metaphors can be traced back to Heraclitus, whose metaphysical doctrines, \enquote{you cannot step twice into the same stream} and \enquote{everything flows} (πάντα ῥεῖ), can best be illustrated by the example of time. Plato, for example, quotes Heraclitus in his speculation about the etymology of the names of the gods Chronos and Rhea in Cratylus: while both are rivers, the former means time, while the latter, interestingly, is etymologically related to rheo, which means \enquote{to speak} and also \enquote{to flow.} Plato asks, \enquote{Is the giving of the names of streams to both of them purely accidental?} The same goes for the river Oceanus, and we are reminded that these speculations about river names are inspired by Heraclitus. This crust of the issue is the gigantomachy between Heraclitus and the Eleatic School, Parmenides in particular, who imagines a world of pure space with no change, no movement, and thus no time. It is indeed true that in time nothing abides, for if anything does abide, it will remain the same and therefore contradict the nature of time, which is constant change and difference. It has also to be remarked that when Heraclitus says that \enquote{you cannot step twice into the same stream,} this stream metaphor for time does not mean that the stream itself must show any visible or real change, but only that it, in principle, has become different over time because it is in different points of time. What has really moved does not have to be the flux itself but time, which guarantees movement at every instant. Time can therefore be conceived as \enquote{ideal} flux, a universal movement overarching all other movements and permanence. This idea has lived on in modern philosophy, as Kant and Husserl, among others, have also used the metaphors \enquote{flux} and \enquote{stream} to describe time as inner consciousness in which nothing abides.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12455-6_2}}

@incollection{wong2022introducti,
	author = {Wong, Kwok Kui},
	booktitle = {Time and {{Poetic Speech}}: {{A Philosophical Investigation}}},
	editor = {Wong, Kwok Kui},
	keywords = {Affect,Flux of time,Metaphor,Poetics,Rhetoric,Rhythm,Synatx},
	pages = {1--8},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {Introduction},
	year = {2022},
	abstract = {This book looks at the classical problems of time in Western philosophy from Aristotle, Augustine, and Kant to Husserl, and attempts to take a novel approach in resolving them, that is, by examining literary speech. The main focus is the idea of time as constant flux, and the problems and paradoxes it entails. It looks for possible resolutions to these problems in the human activity and experience of writing and delivering literary speeches in drama and rhetoric. The book is partly inspired by Ricoeur's project Time and Narrative, but it is asking a different question with a different focus. While Ricoeur attempts to resolve the problems of time raised by Aristotle, Augustine, Kant, and Husserl in the framework of narrative, the mise-en-intrigue (emplotment, or mythos), this book moves further back to the medium of narrative as such, namely, language itself, and spoken language in particular. The purpose is to examine how speech responds to the tension in the structure of time, and how it flows with time while creating permanent unities in this flow, such as concepts and meanings.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12455-6_1}}

@incollection{wong2022metaphor,
