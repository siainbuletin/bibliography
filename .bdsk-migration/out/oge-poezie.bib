@article{maslovthe-geneal,
	author = {Maslov, Boris},
	date = {2016},
	journal = {The American Journal of Philology},
	number = {3},
	pages = {411--446},
	publisher = {The Johns Hopkins University Press},
	title = {The {{Genealogy}} of the {{Muses}}: {{An Internal Reconstruction}} of {{Archaic Greek Metapoetics}}},
	volume = {137},
	abstract = {
		This article puts forward a novel approach to the history of poetic forms in Archaic Greece. By investigating the evolution of the \enquote{diegetic frames} involving the figure of the Muse(s), it seeks to trace mutual influences between different genres (Homeric epic, catalogue poetry, the Homeric Hymns, early choral lyric) and, in the case of the Iliad and Hesiod's Theogony, to identify distinct strata in the composition of one text. This genealogical analysis of the invocation of the Muses demonstrates that choral lyric had a significant impact on the evolving forms of hexameter poetry.},
	bdsk-url-1 = {https://www.jstor.org/stable/26360881}}

