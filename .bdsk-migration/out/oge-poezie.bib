@article{althoffpresocrati,
	author = {Althoff, Jochen},
	date = {2012-06-01},
	journal = {Studies in History and Philosophy of Science Part A},
	keywords = {Anaxagoras,Empedocles,Hexameter poetry,Pre-Socratic philosophy,Prose style},
	number = {2},
	pages = {293--299},
	series = {Structures and {{Strategies}} in {{Ancient Greek}} and {{Roman Technical Writing}}},
	shortjournal = {Studies in History and Philosophy of Science Part A},
	title = {Presocratic Discourse in Poetry and Prose: {{The}} Case of {{Empedocles}} and {{Anaxagoras}}},
	volume = {43},
	zotero-field = {ScienceDirect Snapshot:/Users/siainbuletin/Zotero/storage/SPKYQRT2/S0039368111001270.html:text/html},
	abstract = {This paper explores the differences between poetry and prose in philosophical writing by examining two Pre-Socratic fragments, one in verse and one in prose, that express a very similar thought: Empedocles 59 B 17 Diels/Kranz and Anaxagoras 31 B 8 D./K. Although at first it might seem as though there is a simple division between Empedocles' opaque and allusive hexameters and Anaxagoras' sober prose, when we look in detail at the language used by the two authors, a close reading of the passages reveals a more complex picture. Both authors place rhetorical emphasis on their own role as innovator; Anaxagoras' prose shows a careful attention to style and word choice no less than Empedocles' poetry, and Empedocles' poetry itself reflects the range of stylistic registers and types of material that hexameter could be used for in antiquity. There is no simple antithesis between prose style and hexametric poetry, and the words and stylistic devices an author chooses are constitutive of the thought he expresses.},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0039368111001270},
	bdsk-url-2 = {https://doi.org/10.1016/j.shpsa.2011.12.016}}

