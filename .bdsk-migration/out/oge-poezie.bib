@incollection{smith2022kriterion-,
	author = {Smith, Pl{\'\i}nio Junqueira},
	booktitle = {Sextus {{Empiricus}}' {{Neo-Pyrrhonism}}: {{Skepticism}} as a {{Rationally Ordered Experience}}},
	editor = {Smith, Pl{\'\i}nio Junqueira},
	keywords = {aletheia},
	pages = {287--316},
	place = {Cham},
	publisher = {Springer International Publishing},
	series = {Synthese {{Library}}},
	title = {Kriterion {{II}}: Al{\^e}theia: {{Living}} with {{Belief}} and {{Knowledge}}},
	year = {2022},
	abstract = {This chapter claims that the Pyrrhonist not only has beliefs about what appears, but even that he has knowledge. It argues that he accepts everyday criteria of truth, suspending judgment only about the logical criterion of truth. First, I describe Sextus' conception of belief (pistis), which involves truth, and his classification of its kinds. The two basic kinds are assent to what appears and to what is non-evident. Each kind has two further kinds: the Pyrrhonist assents in a mild way to what appears, while the Academic assents with intensity to appearances; everyday assent to what is non-evident is an opinion (doxa) and assent to what is non-evident after investigation is a philosophical theory (dogma), though Sextus also characterizes a philosophical theory as doxa. Next, I explain why I think that there are two kinds of judgment: the dogmatic one, which postulates non-evident objects and makes firm assertions about them; and the skeptical one, which not only expresses what appears, but also may be true or false according to what appears. I finally turn my attention to the everyday criteria of truth, arguing the skeptic endorses them. If so, the skeptic in his everyday life will hold not only beliefs, but may even claim that he knows what appears and that his beliefs are true. Considering philosophy as a historical phenomenon, the skeptic may even have beliefs about some controverted philosophical issues, thought he cannot have opinions or philosophical theories.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-030-94518-3_11}}

