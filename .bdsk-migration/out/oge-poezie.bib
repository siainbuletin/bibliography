@incollection{harrynew-sappho,
	author = {Harry, Chelsea C.},
	booktitle = {Exploring the {{Contributions}} of {{Women}} in the {{History}} of {{Philosophy}}, {{Science}}, and {{Literature}}, {{Throughout Time}}},
	date = {2023},
	editor = {Harry, Chelsea C. and Vlahakis, George N.},
	keywords = {Aristotle,Perception,Phantasia,Sappho,Temporality,Time},
	pages = {39--52},
	place = {Cham},
	publisher = {Springer Nature Switzerland},
	series = {Women in the {{History}} of {{Philosophy}} and {{Sciences}}},
	title = {New {{Sappho}} as a {{Philosopher}} of {{Time}}?},
	abstract = {This chapter considers Sappho of Lesbos an early philosopher of time. It compares the use of temporal markers, especially \enquote{now} (nun) in Sappho's poetry to Aristotle's usage of the same term in the context of his treatise on time in Physics IV.10--14. Likewise, it looks at Aristotle's analysis of phantasia in De Anima III and in the Parva Naturalia as well as Eva Stehle's reading of Sappho's Tithonos poem to suggest ways that both Aristotle and Sappho account for an ability to experience the past, what was \enquote{once} (pota), in the present, now. The chapter concludes that~Sappho, like Aristotle, was a~thinker~primarily~engaged with the existence and experience of natural beings and, as such, of the ways natural beings primarily act and interact with each other in the world. From such an engagement developed a theory of time.~Sappho may have been a hidden influence on Aristotle's understanding of the relationship between being, beings, and time; nevertheless, her poetry is instructive to all of us still grappling with these issues today.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-39630-4_4}}

