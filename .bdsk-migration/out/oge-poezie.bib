@incollection{bassler2022analysis-a,
	author = {Bassler, O. Bradley},
	booktitle = {The {{Legitimacy}} of {{Poetic Reason}}},
	editor = {Bassler, O. Bradley},
	keywords = {Analytic Rationality,Jacques Lacan,Philosophical Praxis,Psychoanalysis},
	pages = {109--131},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {Analysis as {{Opposed}} to {{What}}?},
	year = {2022},
	abstract = {In this chapter I move from the rudiments of a theory of the poetic subject to a report from the field. Just as psychoanalysis must be understood in terms of the fundamental, praxical role played by the analysis itself, so creative reason must be understood as grounded in an analogous praxis. What the psychoanalytic praxis and poetic praxis have in common is that they are both what I call paraphilosophical praxes. In principle any praxis may be understood as one in which desire is enlisted in a praxis which is on its way to philosophical reflection. Analytic work and poetic work are exemplary in this regard, and each in its own way sheds light on the question what rationality could be involved in such a work. The irony of psychoanalysis is that, while cultivating one of the most powerful models of analytic rationality, it paves the way for seeing the poetic rationality implicated in the very transaction of analysis itself. This provides a leading clue for identifying poiesis, making governed by poetic reason, in more general terms and answering the question, \enquote{analysis as opposed to what?}},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12314-6_5}}

@incollection{bassler2022benjamin:s,
	author = {Bassler, O. Bradley},
	booktitle = {The {{Legitimacy}} of {{Poetic Reason}}},
	editor = {Bassler, O. Bradley},
	keywords = {Friedrich Schlegel,Jean-Luc Nancy,Philippe Lacoue-Labarthe,Stanley Cavell,Walter Benjamin,Ludwig Wittgenstein},
	pages = {27--43},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {Benjamin/{{Schlegel}}: {{Cavell}}/{{Wittgenstein}}},
	year = {2022},
	abstract = {In this chapter I look at two receptions of ideas from German Idealism developed in the Athenaeum circle around Friedrich Schlegel: Walter Benjamin's discussion of Schlegel's aesthetic theory and Stanley Cavell's reception of Emerson and Wittgenstein, where both of these latter two are understood in the light of work by Philippe Lacoue-Labarthe and Jean-Luc Nancy on the literary absolute in German Romanticism. In each case, a crucial piece is identified for the project of legitimating poetic reason. Benjamin isolates a core insight from Schlegel concerning the work of art understood as a reflective medium, and extricates it from the theological context in which Schlegel presents it. The structure of the work as reflective medium will become central for the account of the poetic medium as a core structure within the poetic subject. Cavell identifies a way in which Emerson and Wittgenstein can both be understood as extending strategies of transcendental justification deriving from the Kantian background in German Idealism, and these strategies will contribute to the legitimation of poetic reason in later chapters.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12314-6_2}}

@incollection{bassler2022the-esoter,
	author = {Bassler, O. Bradley},
	booktitle = {The {{Legitimacy}} of {{Poetic Reason}}},
	editor = {Bassler, O. Bradley},
	keywords = {Catastrophe Theory,Jacques Derrida,Jacques Lacan,Poetic Reason,Ren{\'e} Thom},
	pages = {327--346},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {The {{Esoteric Geometry}} of {{Poetic Reason}}},
	year = {2022},
	abstract = {What I have called the esoteric function lies at the heart of poetic reason. In this chapter I outline a geometry of poetic reason based on the appeal to this esoteric function. I begin with the closest analogue I know to a geometry of the esoteric, as it is given in Jacques Derrida's work Glas. Following Saussure's investigation of anagrams, the geometry Derrida indicates is a geometry of paragrams, semiotic units which mark the limiting, zero-point of poetic semiosis. The geometry which is intimated exhibits pronounced tendencies in the direction of a catastrophe geometrics along lines first outlined by Ren{\'e} Thom. Here, on the other side of the legitimation of poetic reason, we are first able to see possible obstructions posed by the Lacanian approach to the subject and alternative ways to extend the under-writing of poetic reason. At the end of this enterprise, we see the need for a general theory of such under-writing as legitimation, and for that, a general theory of poetic reason.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12314-6_11}}

@incollection{bassler2022lacans-fre,
	author = {Bassler, O. Bradley},
	booktitle = {The {{Legitimacy}} of {{Poetic Reason}}},
	editor = {Bassler, O. Bradley},
	keywords = {Jacques Lacan,Lacanian diagrams,Psychoanalysis,Psychoanalytic Subject},
	pages = {47--76},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {Lacan's {{Freudian Subject}} in the {{{\'E}crits}}},
	year = {2022},
	abstract = {In this chapter, I initiate the task of securing an account of the subject adequate to the legitimation of poetic reason. Much as I have identified Henrich's account of constructive reason in Chap. 1as the closest precursor to poetic reason, here I identify the Lacanian subject as the most adequate antecedent to the full account of the poetic subject that must eventually be supplied. Lacan's subject, however, remains an analytic subject (specifically, of the psycho-analytic type), and so a deduction of the poetic subject from the analytic (Lacanian) subject must be provided. This makes the status of the Lacanian subject critical for this project, and for that reason I follow it out in the requisite detail. At the heart of Lacan's treatment of the psychoanalytic subject lie the diagrams he uses to indicate its structure, and so in this chapter I follow out Lacan's most fundamental diagram in detail.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12314-6_3}}

