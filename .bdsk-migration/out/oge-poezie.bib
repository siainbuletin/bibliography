	editor = {Horne, Jeremy},
	editorb = {Jennex, Murray},
	editorbtype = {redactor},
	publisher = {IGI Global},
	series = {Advances in {{Knowledge Acquisition}}, {{Transfer}}, and {{Management}}},
	title = {Philosophical {{Perceptions}} on {{Logic}} and {{Order}}:},
	abstract = {The author presents the idea of a \enquote{logical worldview} -- an approach to understanding logic by examining philosophical positions in metaphysics, epistemology, and theories of cognition and perception, and exploring how philosophical and logical positions combine to form a complete logical system. Aristotle's logical worldview is examined in some detail, and the logical systems of Francis Bacon and George Boole are examined by exploring how a new logic results when certain Aristotelian philosophical positions are abandoned. The logical worldview approach is also shown to help explain certain puzzles with Aristotle's logic, such as existential import, the form of the syllogism, and Aristotle's \enquote{missing} moods and figures from the list of valid moods.},
	bdsk-url-1 = {http://services.igi-global.com/resolvedoi/resolve.aspx?doi=10.4018/978-1-5225-2443-4},
	bdsk-url-2 = {https://doi.org/10.4018/978-1-5225-2443-4}}

@article{horrigan-kellyunderstand,
	author = {Horrigan-Kelly, Marcella and Millar, Michelle and Dowling, Maura},
	date = {2016-12-01},
	journal = {International Journal of Qualitative Methods},
	number = {1},
	pages = {160940691668063},
	shortjournal = {International Journal of Qualitative Methods},
	title = {Understanding the {{Key Tenets}} of {{Heidegger}}'s {{Philosophy}} for {{Interpretive Phenomenological Research}}},
	volume = {15},
	zotero-field = {Horrigan-Kelly et al. - 2016 - Understanding the Key Tenets of Heidegger's Philosophy for Interpretive Phenomenological Research.pdf:/Users/siainbuletin/Zotero/storage/WH3NEPLG/Horrigan-Kelly et al. - 2016 - Understanding the Key Tenets of Heidegger's Philosophy for Interpretive Phenomenological Research.pdf:application/pdf},
	abstract = {Martin Heidegger's phenomenology provides methodological guidance for qualitative researchers seeking to explicate the lived experience of study participants. However, most phenomenological researchers apply his philosophy loosely. This is not surprising because Heidegger's phenomenological philosophy is challenging and the influence of his philosophy in shaping the conduct of interpretive phenomenological research is broadly debated. This article presents an exploration of Dasein, a key tenet of Martin Heidegger's interpretive phenomenology and explicates its usefulness for phenomenological research. From this perspective, we present guidance for researchers planning to utilize Heidegger's philosophy underpinning their research.},
	bdsk-url-1 = {http://journals.sagepub.com/doi/10.1177/1609406916680634},
	bdsk-url-2 = {https://doi.org/10.1177/1609406916680634}}

