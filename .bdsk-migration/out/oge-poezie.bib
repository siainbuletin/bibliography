@book{gittlersocial-tho,
	author = {Gittler, Joseph B.},
	date = {1941},
	editora = {Ogburn, William F.},
	editoratype = {collaborator},
	place = {ATHENS},
	publisher = {THE UNIVERSITY OF GEORGIA PRESS},
	title = {Social {{Thought Among}} the {{Early Greeks}}},
	zotero-field = {Social Thought Among the Early Greeks.pdf:/Users/siainbuletin/Zotero/storage/KBC276DJ/Social Thought Among the Early Greeks.pdf:application/pdf},
	abstract = {Much has been written on the social thought and the social philos- ophy of Plato and Aristotle, but lit- tle has been written on pre-Pla- tonic social thought or on the so- cial thinking inherent in the writ- ings of the Attic orators, dramatists, and poets. Social Thought among the Early Greeks fills this gap in the histories of social thought by presenting the social thinking in the Age of Homer and Hesiod, in. the Lyric Age, and in the works of Attic writers, exclusive of Plato and Aristotle. Herein early Greek social thought is classified into various categories. The social and historical setting from which the ideas emanated are presented together with short interpretative analyses. Biographical sketches of the Greek writers are appended, and general. propositions in regard to the nature of early Greek thought are given. It has been the purpose of the author to present the material in such a man- ner as to make it readily under- standable to the reader who has little or no classical background.}}

