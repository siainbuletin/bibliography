	booktitle = {Time and {{Poetic Speech}}: {{A Philosophical Investigation}}},
	editor = {Wong, Kwok Kui},
	keywords = {Gestalt,Imagination,Judgment,Metaphor,Metaphoric of affect,Transference},
	pages = {115--140},
