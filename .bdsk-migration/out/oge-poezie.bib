@incollection{hagberga-state-of,
	author = {Hagberg, Garry L.},
	booktitle = {Literature and Its {{Language}}: {{Philosophical Aspects}}},
	date = {2022},
	editor = {Hagberg, Garry L.},
	keywords = {Acquired meaning,J. M. Coetzee,Life-encompassing words,Pragmatics,Understanding,Word-meaning},
	pages = {207--242},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {A {{State}} of {{Mind}} as the {{Meaning}} of a {{Word}}: {{J}}. {{M}}. {{Coetzee}}'s {{Disgrace}}},
	abstract = {Coetzee's central character David Lurie, in his novel Disgrace, can be read as a layered and instructively complex study in moral psychology in literary form. It is that---but also more. It can also be read as a study in the philosophy of language, as a study in why our words mean what they do, how they come to acquire that meaning, and what it is to understand---to deeply and richly understand---their meaning. To come to an understanding of the mind of Lurie is to come to an understanding of the lived experience, and what one might call the psychological pragmatics, that give the word \enquote{disgrace} its content. As we see in this chapter, it is thus a novel that shows how it is that we come to fathom the intricate intertwinings of a life, a mind, and what can be a life-encompassing word.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12330-6_11}}

