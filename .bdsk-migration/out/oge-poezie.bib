	volume = {62},
	zotero-field = {Hall and DePaul University - 2018 - Poetry as Dark Precursor Nietzschean Poetics in Deleuze's \enquote{Literature and Life}.pdf:/Users/siainbuletin/Zotero/storage/J59AISI8/Hall and DePaul University - 2018 - Poetry as Dark Precursor Nietzschean Poetics in Deleuze's \enquote{Literature and Life}.pdf:application/pdf},
	abstract = {The present article utilizes the Nietzschean \enquote{poetics} distilled from Nietzsche's Gay Science as an interpretive strategy for considering Deleuze's essay \enquote{Literature and Life}in Essays Critical and Clinical.The first section considers Deleuze's overarching project in that essay, and then repositions his thought from literature in general to \enquote{poetry} (in Nietzsche's sense) in particular, indicating both resonances between Deleuze's understanding of \enquote{literature} and Nietzsche's understanding of \enquote{poetry} as well as their dissonances. The second section focuses on the places in Deleuze's analyses where he excludes poetry,and suggests that this exclusion is related to Nietzsche's claim that lyric poetry is the birthplace of philosophy.Put differently,the being of lyric poetry threatens to disrupt Deleuze's distinction between the respective roles and powers of philosophy and art, and thereby to disclose poets as, at least potentially (or \enquote{virtually}), philosophers, and vice versa. And the final section offers one of Rainer Maria Rilke's Sonnets to Orpheus as an exemplar of poetry's philosophical potential, before concluding that a Nietzschean conception of poetry constitutes the \enquote{dark precursor} of \enquote{Literature in Life,} Essays Critical and Clinical, and Deleuze's work in general.},
	bdsk-url-1 = {http://www.pdcnet.org/oom/service?url_ver=Z39.88-2004&rft_val_fmt=&rft.imuse_id=philtoday_2018_0062_0001_0235_0251&svc_id=info:www.pdcnet.org/collection},
	bdsk-url-2 = {https://doi.org/10.5840/philtoday201839210}}

