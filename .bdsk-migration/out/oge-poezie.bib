	publisher = {Springer International Publishing},
	title = {Metaphor},
	year = {2022},
	abstract = {This chapter will investigate the relation between time and metaphor. Following the discussions in the previous chapters, our question is, more specifically, how affected time makes metaphoric transference possible. In the last chapter, we tried to answer the Schopenhauerian question from the rhythmic side. Now, we will further investigate it by pushing Schopenhauer's question to the semantic side: why do we seem to understand the meanings of words better when they are accompanied by rhythm? What role does time play here? Among the many rhetorical devices, we will concentrate on metaphor, a subject which has been much discussed throughout the history of Western philosophy. In terms of time as flux, we will examine the issue from an opposite perspective, that is, rather than how permanence of meaning can be created from flux, we will look into how, in the permanence of the meanings of words, certain semantic fluidity is possible.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12455-6_6}}

