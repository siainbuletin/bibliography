	date = {2022},
	editor = {Hagberg, Garry L.},
	keywords = {Adam Ehrlich Sachs,Ben Marcus,Defamiliarization,Forms of life,Grammar and usage,Lydia Davis,Ordinary language,Uncanny,Ludwig Wittgenstein},
	pages = {291--324},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {On {{Wittgenstein}}, {{Lydia Davis}}, and {{Other Uncanny Grammarians}}},
	abstract = {What would Wittgensteinian fiction look like? Not fiction overtly about or influenced by him, but rather that resonates with the style and content of his thought? Lydia Davis has avowed, but never explained, her admiration for Wittgenstein. Her fiction is short and fragmentary, and attuned to the way that grammar and usage reveal our forms of life. Alongside briefer discussion of the philosophical comedy of Adam Ehrlich Sachs, who overtly references Wittgenstein, and of the experimental fictions of Ben Marcus, which present strange forms of life and their breakdown, I characterize both Wittgenstein and Davis as uncanny grammarians: though we live in language, we are never fully at home in it. Both press on our ordinary language in an extraordinary way, defamiliarizing the familiar to more explicitly understand it.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12330-6_14}}

