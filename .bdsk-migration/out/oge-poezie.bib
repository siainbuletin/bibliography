@incollection{muellerbunbury-co,
	author = {Mueller, Luke},
	booktitle = {Literature and Its {{Language}}: {{Philosophical Aspects}}},
	date = {2022},
	editor = {Hagberg, Garry L.},
	keywords = {🌟,Certainty,Context,J. L. Austin,Oscar Wilde,Particularity,Performatives},
	pages = {53--70},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {Bunbury {{Could Not Live}}, {{That Is What I Mean}}: {{Austin}}'s {{Performative Speech}} and {{Truth}} in the {{Case}} of {{Oscar Wilde}}},
	abstract = {There are few commonplaces in studies of Oscar Wilde as widely accepted as the power of performatives, but this version of performatives is usually extruded through a narrow set of poststructuralist concerns for language as a form of constraint, where uncertainty affords liberation. This narrow picture excludes much of the value of the theory first envisioned by J.L. Austin. I argue for a more faithfully Austinian approach to Wilde, and I show how the poststructuralist picture of linguistic uncertainty ignores the role of contexts and conventions of use that allow structurally unstable language to produce sensible and pragmatically fixed meanings. For Wilde (and for Austin), certainty and truth remain viable and useful in many contexts, and the constraints of language must be understood through the constraints individuals and societies impose.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12330-6_3}}

