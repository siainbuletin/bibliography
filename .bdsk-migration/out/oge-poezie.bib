	date = {2021},
	editor = {Hornbuckle, Calley A. and Smith, Jadwiga S. and Smith, William S.},
	keywords = {Art,Eros,Idea,Language,Life,Ontopoetics,Science,Thought-being,Tymieniecka,value of abstraction},
