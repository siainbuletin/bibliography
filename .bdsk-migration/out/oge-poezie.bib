@incollection{gaedtkeflann-obri,
	author = {Gaedtke, Andrew},
	booktitle = {Literature and Its {{Language}}: {{Philosophical Aspects}}},
	date = {2022},
	editor = {Hagberg, Garry L.},
	keywords = {Flann O'Brien,Irony,Linguistic usage,Satire,Skepticism,Ludwig Wittgenstein},
	pages = {3--23},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {Flann {{O}}'{{Brien}}, {{Wittgenstein}}, and the {{Idling}} of {{Language}}},
	abstract = {This article examines unrecognized points of conceptual and stylistic convergence between the work of Flann O'Brien and Ludwig Wittgenstein. Though operating in quite different generic and discursive modes, both writers reject broad metaphysical systems, idealized models of language, skepticism, and the impulse to theorize. As correctives to these tendencies, O'Brien and Wittgenstein adopt similar techniques to train their readers' attention on the zones of overlap in linguistic usage where confusion tends to arise. Finally, this comparison with O'Brien casts new light on Wittgenstein's later work as it illuminates satirical and ironizing styles that have perhaps not been fully appreciated.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12330-6_1}}

