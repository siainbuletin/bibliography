	keywords = {Anacreon,bic Book Industry Communication::D Literature & literary studies::DS Literature: history & criticism::DSB Literary studies: general::DSBB Literary studies: classical,Carmina Anacreontea,early & medieval,Greek poetry,lyric,reception},
