	series = {Palgrave {{Studies}} in {{Creativity}} and {{Culture}}},
	title = {Poetry in and for {{Society}}: {{Poetic Messages}}, {{Creativity}}, and {{Social Change}}},
	year = {2017},
	abstract = {Poetry is far from being an escapist type of activity, removed from society and reduced to a personal form of expression. On the contrary, poetic expressions are not only social endeavors, they also create something with the potential to question society and engage people in political action. In making this claim, we trace back poetry to its etymological roots, the Greek term poiesis, designating the activity of \enquote{making} or \enquote{bringing into existence.} In this chapter, we illustrate the political power of poetic expressions or, more broadly, of creative making (poiesis), at the level of society. Concretely, we will take the case study of a recent social movement in Mexico, YoSoy132, which uses poetic messages, among other art forms, to protest against the political establishment.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-319-64858-3_3}}

