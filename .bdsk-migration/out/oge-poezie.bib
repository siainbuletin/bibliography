@incollection{nyusztayselves-los,
	author = {Nyusztay, Ivan},
	booktitle = {Literature and Its {{Language}}: {{Philosophical Aspects}}},
	date = {2022},
	editor = {Hagberg, Garry L.},
	keywords = {Identity,Krapp's Last Tape,Memory,Perspective,Samuel Beckett,Self,Self-constitution,The past},
	pages = {127--145},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {Selves {{Lost}} and {{Regained}}: {{Retrospective}} vs. {{Prospective Quests}} for {{Identity}} in {{Samuel Beckett}}'s {{Krapp}}'s {{Last Tape}}},
	abstract = {Samuel Beckett's Krapp's Last Tape is widely read as a play about self and memory. Secluded from the world, Krapp listens to the voice of his previous selves on a tape recorder, desperately ransacking the past to isolate episodes that are worthy of retention. In this article I look both at the utter failure of a retrospective quest for identity and at the rare moments in Beckett's play when continuity with the past self is reestablished. I believe that these moments have to do with a radical change of perspective, whereby a prospective insight is made the fundamental element of self-constitution. I map the dramatic oscillations between past and present on the one hand, and the outstanding significance of anticipation on the other, and address the corresponding imagery with the help of Gilles Deleuze's revelatory concepts of the crystal- and the pure image.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12330-6_7}}

@article{oconnellescaping-s,
	author = {O'Connell, Benedict},
	number = {142},
	title = {Escaping {{Scepticism}} with {{Hegel}} \& {{Heidegger}}},
	zotero-field = {O'Connell - Escaping Scepticism with Hegel & Heidegger.pdf:/Users/siainbuletin/Zotero/storage/WT2B88N4/O'Connell - Escaping Scepticism with Hegel & Heidegger.pdf:application/pdf},
	abstract = {In responding to the problem of a possible infinite regress in knowledge, both Hegel and Heidegger challenge those who pose the problem. In Hegel's Phenomenology, this challenge is directed towards the Pyrrhonian sceptic who has supposed a particular relationship between human consciousness and reality which Hegel thinks is false. In Being and Time, Heidegger explains that assessing any claim necessarily involves a degree of understanding of the conditions in which that claim has been made or applies, and understanding always involves preconceptions. Even those who pose the problem of the criterion have accepted certain standards or preconceptions. Both Hegel and Heidegger seek to combat these presuppositions. This is why an important notion within both their works is the value placed on criticism, and the judgement that it is possible to gain ground in understanding.}}

