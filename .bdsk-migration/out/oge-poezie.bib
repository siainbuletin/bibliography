@book{stockingthe-politi,
  author       = {Stocking, Charles H.},
  date	       = {2017-03-30},
  edition      = {1},
  publisher    = {Cambridge University Press},
  title	       = {The {{Politics}} of {{Sacrifice}} in {{Early Greek
                  Myth}} and {{Poetry}}},
  zotero-field = {Stocking - 2017 - The Politics of Sacrifice in Early
                  Greek Myth and
                  Poetry.pdf:/Users/siainbuletin/Zotero/storage/EFAX7VSD/Stocking
                  - 2017 - The Politics of Sacrifice in Early Greek
                  Myth and Poetry.pdf:application/pdf},
  abstract     = {This book offers a new interpretation of ancient
                  Greek sacrifice from a cultural poetic perspective.
                  Through close readings of the Theogony, the Homeric
                  Hymn to Demeter, the Homeric Hymn to Hermes, and the
                  Odyssey in conjunction with evidence from material
                  culture, it demonstrates how sacrifice narratives in
                  early Greek hexameter poetry are intimately
                  connected to a mythic-poetic discourse referred to
                  as the \&apos;politics of the belly\&apos;. This
                  mythic-poetic discourse presents sacrifice as a site
                  of symbolic conflict between the male stomach and
                  female womb for both mortals and immortals.
                  Ultimately, the book argues that the ritual of
                  sacrifice operates as a cultural mechanism for the
                  perpetuation of patriarchal ideology not just in
                  early Greek hexameter, but throughout Greek cultural
                  history.},
  bdsk-url-1   =
                  {https://www.cambridge.org/core/product/identifier/9781316687048/type/book},
  bdsk-url-2   = {https://doi.org/10.1017/9781316687048}
}

@article{stoddartthe-social,
  author       = {Stoddart, Simon and Whitley, James},
  date	       = {1988-12},
  journal      = {Antiquity},
  keywords     = {🌟🌟},
  number       = {237},
  pages	       = {761--772},
  publisher    = {Cambridge University Press},
  title	       = {The Social Context of Literacy in {{Archaic Greece}}
                  and {{Etruria}}},
  volume       = {62},
  abstract     = {In recent years much emphasis has been placed upon
                  the effects of literacy in the transformation of the
                  Mediterranean World between 800 and 400 BC.
                  Alphabetic scripts have been seen by many,
                  archaeologists and classicists alike, as one of the
                  key factors that made many of the achievements of
                  Mediterranean, particularly Greek, thought and
                  culture possible. Alphabetic scripts encouraged
                  widespread literacy, and widespread literacy was the
                  necessary condition for what remains distinctive in
                  Ancient Greek culture, namely the development of
                  History, Philosophy and speculative Natural Science.
                  Murray (1980: 96) is typical in his view that
                  `Archaic Greece was a literate society in the modern
                  sense.' The work of Goody \& Watt (1963) has done
                  much to advance the view that many of the
                  achievements of Mediterranean Society can be
                  ascribed to, if not entirely explained by, this
                  `technology of the intellect'. Their `autonomous
                  model' however, as Cartledge (1978: 37) has
                  observed, comes dangerously close to technological
                  determinism.},
  bdsk-url-1   =
                  {https://www.cambridge.org/core/journals/antiquity/article/abs/social-context-of-literacy-in-archaic-greece-and-etruria/6A3A421C54E5156D0685311146CD271E},
  bdsk-url-2   = {https://doi.org/10.1017/S0003598X00075219}
}

