@incollection{bassler2022the-logic-,
  author       = {Bassler, O. Bradley},
  booktitle    = {The {{Legitimacy}} of {{Poetic Reason}}},
  editor       = {Bassler, O. Bradley},
  keywords     = {Emily Dickinson,John Ashbery,Robert Frost,Roberto
                  Calasso,Vedic Poetry,Wallace Stevens},
  pages	       = {157--197},
  place	       = {Cham},
  publisher    = {Springer International Publishing},
  title	       = {The {{Logic}} of {{Lyric}} ({{Part One}})},
  year	       = {2022},
  abstract     = {This book takes lyric poetry as the exemplary
                  context in which to conduct the legitimation of
                  poetic reason it offers. In this and the following
                  chapter I survey lyric poetry in two radically
                  distinct contexts and identify an underlying logic
                  of lyric that exemplifies the structures of poetic
                  reason which must be legitimated. In the context of
                  early Vedic poetry, I look at a range of scholars
                  who collectively help to identify what I call the
                  esoteric function and the role that it plays in
                  Vedic lyric in particular. In the context of
                  American lyric poetry (Dickinson, Frost, Stevens and
                  Ashbery) I read individual poems with an eye to how
                  this esoteric function is enlisted. In Dickinson the
                  esoteric function leads to a practice of esoteric
                  poetry, whereas in Frost and Ashbery, the esoteric
                  function is co-opted by gnostic tendencies. The case
                  of Stevens is more equivocal and so helps to see the
                  complexity of the issues at stake.},
  bdsk-url-1   = {https://doi.org/10.1007/978-3-031-12314-6_7}
}

@incollection{bassler-2022-logic-lyric-2,
  author       = {Bassler, O. Bradley},
  booktitle    = {The {{Legitimacy}} of {{Poetic Reason}}},
  editor       = {Bassler, O. Bradley},
  keywords     = {Anagrams,Jakobson,Jean Starobinski,Poetic
                  Reason,Saussure,Vladimir Toporov},
  pages	       = {199--238},
  place	       = {Cham},
  publisher    = {Springer International Publishing},
  title	       = {The {{Logic}} of {{Lyric}} ({{Part Two}})},
  year	       = 2022,
  abstract     = {This chapter continues the investigation of the
                  logic of lyric in Vedic poetry, focusing on the
                  Vedic poetics proposed by Vladimir Toporov. Toporov
                  identifies the action of the esoteric function most
                  explicitly, and this explicit identification is
                  compared to Starobinski's discussion of Saussure's
                  interest in identifying anagrams in Vedic and Roman
                  poetry. The action of the esoteric function as
                  Toporov and Saussure identify it helps to promote
                  the stable transmission of the poem. This sets the
                  stage for the first legitimation of poetic reason,
                  which takes the form of a transcendental deduction
                  of poetic reason based on Roman Jakobson's
                  identification of the fundamental linguistic
                  functions. In Jakobson the role of the esoteric
                  function is a limiting case of what Jakobson calls
                  the poetic function. At the end of the chapter, I
                  return to the American tradition of poetry to
                  exemplify the value of what has been established by
                  the investigation into the logic of lyric.},
  bdsk-url-1   = {https://doi.org/10.1007/978-3-031-12314-6_8}
}

@incollection{bassler2022looking-ba,
	author = {Bassler, O. Bradley},
	booktitle = {The {{Legitimacy}} of {{Poetic Reason}}},
	editor = {Bassler, O. Bradley},
	keywords = {Jacques Lacan,Pascal,Paul de Man,Psychoanalytic subject},
	pages = {77--107},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {Looking {{Back}}: {{A Genealogy}} of the {{Subject-}}(Dis)-Continuum from {{Pascal}} to {{Lacan}}},
	year = {2022},
	abstract = {In this chapter I initiate the transposition of the Lacanian subject to the field of poiesis, understood as the locus of creative work. Since creative work is traditionally assigned to a subject---admittedly possibly inspired from outside---it is a significant but not implausible step to suggest instead that creative work occurs in the (now, philosophically non-traditional) subject insofar and only insofar as the subject is understood as the field of creative work itself. I refer to this field of creative work as the subject-(dis)-continuum, with the parenthetical term recognizing that, as in the case of modern physical theories, the extensive field of creative work is itself likely to contain discontinuous, singular ruptures. Like a quantum field, it is a \enquote{field} incorporating aspects of both continuity and discontinuity. The structure of the subject-(dis)-continuum that Lacan identifies is anticipated in Paul de Man's reading of Pascal, which I use to establish a genealogy of the subject-(dis)-continuum. This promotes an identification of the subject-(dis)-continuum as the subject of the drive and establishes its relation to the dynamics of desire. In this way a connection is prepared between Lacan's psychoanalytic treatment of desire and the desire at work in poetic creation.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12314-6_4}}

@incollection{bassler2022modernity-,
	author = {Bassler, O. Bradley},
	booktitle = {The {{Legitimacy}} of {{Poetic Reason}}},
	editor = {Bassler, O. Bradley},
	keywords = {Ernst Robert Curtius,Hans Blumenberg,Jacques Derrida,Jacques Lacan,Modernity,Paul de Man},
	pages = {283--326},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {Modernity and the {{Transcendental Deduction}} of {{Poetic Reason}}},
	year = {2022},
	abstract = {In this chapter I lay the ground for and then provide the second argument for the legitimacy of poetic reason. Blumenberg's argument for the legitimacy of the modern age is understood as the positive \enquote{deduction} of modernity's legitimacy associated with his critique of any reading of modernity according to a secularization hypothesis, in which the core terms of modernity would be understood as substance-preserving \enquote{translations} of concepts antecedently available. This argument proceeds in terms of the consolidation effected by the \enquote{emergency positing} of a minimal rationality requisite to assure the systematic promotion of human self-assertion. I argue that this rational commitment not only can but in fact must be extended to the notion of poetic reason. Blumenberg's minimal rationality does not take adequately into account the nature of human self-assertion as a making (poiesis). This recognition is requisite for what I call dynamical stabilization. Without it, the modern pacing of human self-assertion can neither be articulated nor confronted. On this basis, I supply an alternative argument which secures not only the conditions Blumenberg specifies for a legitimation of modernity but, in the process, the conditions for a legitimation of poetic reason as well.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12314-6_10}}

@incollection{bassler2022priming-th,
	author = {Bassler, O. Bradley},
	booktitle = {The {{Legitimacy}} of {{Poetic Reason}}},
	editor = {Bassler, O. Bradley},
	keywords = {German Idealism,Hans Blumenberg,Hegel,Jacques Lacan,Peirce,Psychoanalytic subject},
	pages = {241--282},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {Priming the {{Deduction}}: {{The Medium}} of {{Reflection}} and {{The Poetic Subject}}},
	year = {2022},
	abstract = {In this chapter I link together the poetic subject and the medium of reflection in preparation for the second argument for the legitimation of poetic reason given in the subsequent chapter. I begin by looking at the form taken by the medium of reflection in Hegel's doctrine of essence in the Science of Logic. Peirce offers an alternative to the Hegelian medium of reflection in such a way that the external can be identified within the phenomenal domain itself. This external is the locus of poetic reason. However, this form of externalism comes at the cost of a radical commitment to continuity, which we see here in the continuity of the external with the phenomenal domain. Here Lacan helps to build a bridge, for he begins with a critique of Hegelian negation and moves to a conception of the subject-(dis)-continuum. This Lacanian subject shares features both with the Hegelian medium of reflection and with Peirce's radical phenomenalism, thus supplying the needed locus for a poetic reason which can be seen as a purification of trends within German Idealism no longer subject to Blumenberg's secularization critique nor devolving into an anti-modern form of Gnosticism.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12314-6_9}}

@incollection{bassler-2022-between-psych-struc,
  author       = {Bassler, O. Bradley},
  booktitle    = {The {{Legitimacy}} of {{Poetic Reason}}},
  editor       = {Bassler, O. Bradley},
  keywords     = {🌟,Sigmund Freud,James Boon,Norman O.
                  Brown,Structuralism,Symbolist Poetry},
  pages	       = {133--154},
  place	       = {Cham},
  publisher    = {Springer International Publishing},
  title	       = {Between {{Psychoanalysis}} and {{Structuralism}}},
  year	       = 2022,
  abstract     = {In this chapter I address two figures who help move
                  us toward the legitimation of poetic reason in
                  distinct ways. Norman O. Brown's post- or
                  anti-modernist Freudianism is a vigorous promotion
                  of Gnostic tendencies that stands in the strongest
                  opposition to Blumenberg's legitimation of the
                  modern age. Since, on the one hand, I use
                  Blumenberg's legitimation argument as a starting
                  point for the legitimation of poetic reason, and, on
                  the other hand, I enlist Lacan's cultivation of the
                  Freudian subject as a candidate for the subject to
                  which poetic reason is ascribed, Brown's reading of
                  Freud poses the most extreme challenge to be met. In
                  the second half of this chapter, I begin to develop
                  the tools to meet this challenge. Lacan's reception
                  of the Freudian subject is structuralist in
                  orientation, and in reading James Boon's work on
                  structuralism and symbolist poetry I begin to
                  articulate a structuralist methodology which
                  recognizes poetry as part of its own heritage.},
  bdsk-url-1   = {https://doi.org/10.1007/978-3-031-12314-6_6}
}

@incollection{bassler2022reason-poi,
	author = {Bassler, O. Bradley},
	booktitle = {The {{Legitimacy}} of {{Poetic Reason}}},
	editor = {Bassler, O. Bradley},
	keywords = {Dieter Henrich,Friedrich H{\"o}lderlin,German Idealism,Poetic Reason},
	pages = {3--25},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {Reason, {{Poiesis}} and {{Paraphysics}}},
	year = {2022},
	abstract = {Most philosophical accounts of reason are geared toward providing rational justifications ex post facto rather than accounting for the role reason plays in actu in the process of creative work. Moreover, when in actu accounts of reason are given, they are usually either too narrow to describe, in anything other than a reconstructive way, the sort of high-level creative work that is involved in the composition of poetry or the creation of a scientific theory. In this first chapter, I appeal to Dieter Henrich's account of constructive rationality in his discussion of H{\"o}lderlin's poetic philosophy as a first point of comparison for the poetic reason which I seek to legitimate. The strategy which will be taken to legitimate poetic reason is outlined in broad contour, and key features of poetic reason are identified which must be taken into account in any attempt to legitimate it. Key to the legitimation is the observation that philosophical innovations emerging from German Idealism are key to identifying poetic reason, but legitimating it requires that the shortcomings of the development of these ideas in German Idealism be redressed.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12314-6_1}}

