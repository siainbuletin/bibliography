  title	       = {Knowledge, {{Truth}} and {{Plausibility}}},
  volume       = {24},
  abstract     = {From antiquity several philosophers have claimed
                  that the goal of natural science is truth. In
                  particular, this is a basic tenet of contemporary
                  scientific realism. However, all concepts of truth
                  that have been put forward are inadequate to modern
                  science because they do not provide a criterion of
                  truth. This means that we will generally be unable
                  to recognize a scientific truth when we reach it. As
                  an alternative, this paper argues that the goal of
                  natural science is plausibility and considers some
                  characters of plausibility.},
