@article{aslamdemocratic,
	author = {Aslam, Ali and McIvor, David and Schlosser, Joel Alden},
	date = {2019-12-01},
	journal = {Democratic Theory},
	number = {2},
	pages = {27--40},
	title = {Democratic {{Theory When Democracy Is Fugitive}}},
	volume = {6},
	zotero-field = {Aslam et al. - 2019 - Democratic Theory When Democracy Is Fugitive.pdf:/Users/siainbuletin/Zotero/storage/VB7YCL4X/Aslam et al. - 2019 - Democratic Theory When Democracy Is Fugitive.pdf:application/pdf},
	abstract = {Urgent alarms now warn of the erosion of democratic norms and the decline of democratic institutions. These antidemocratic trends have prompted some democratic theorists to reject the seeming inevitability of democratic forms of government and instead to consider democracy as a fugitive phenomenon. Fugitive democracy, as we argue below, is a theory composed of two parts. First, it includes a robust, normative ideal of democracy and, second, a clear-eyed vision of the historical defeats and generic difficulties attendant to that ideal. This article considers how democratic theorists might respond to the challenges posed by fugitive democracy and the implications of such an understanding for future research in democratic theory.},
	bdsk-url-1 = {http://berghahnjournals.com/view/journals/democratic-theory/6/2/dt060204.xml},
	bdsk-url-2 = {https://doi.org/10.3167/dt.2019.060204}}

@article{attumkalrealigning,
	author = {Attumkal, Mathew},
	date = {2023-12-14},
	issue = {03},
	journal = {Journal of Dharma},
	keywords = {democracy,ethical-political society,PAUSED},
	number = {03},
	title = {Realigning {{Polis}} with {{Ethos}}, {{Pathos}} and {{Logos}}: {{Editorial}}},
	volume = {48},
	zotero-field = {Full Text PDF:/Users/siainbuletin/Zotero/storage/FJGFPYCL/Attumkal - 2023 - Realigning Polis with Ethos, Pathos and Logos Editorial.pdf:application/pdf},
	abstract = {I firmly believe that realigning ethical imperatives in the political landscape is a complex procedure; nonetheless, it is essential to underline the importance of transparency, accountability and ethical conducts across different facets of political structures. It supports the idea that public officials should disclose their financial dealings, promote integrity in interactions, and ensure accountability for false statements, while also being open to scrutiny regarding the political donations they receive. Furthermore, rulers are tasked with overseeing the implementation of anti-corruption measures, prioritizing human rights, addressing environmental responsibility, and applying ethical principles in both domestic and international relations. Proposals further underscore the importance of promoting education and ethical leadership among the upcoming generation, highlighting the need for civic engagement, advocating for campaign finance reform, and emphasizing the collaborative efforts of citizens, media, policymakers and various public and private institutions. Undoubtedly, it is within such a polis that a seamless integration of ethos, pathos, and logos is realized.},
	bdsk-url-1 = {https://dvkjournals.in/index.php/jd/article/view/4229}}

