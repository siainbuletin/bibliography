@article{neubauerhow-phenom,
	author = {Neubauer, Brian E. and Witkop, Catherine T. and Varpio, Lara},
	date = {2019-04-05},
	journal = {Perspectives on Medical Education},
	number = {2},
	pages = {90--97},
	shortjournal = {Perspect Med Educ},
	title = {How Phenomenology Can Help Us Learn from the Experiences of Others},
	volume = {8},
	zotero-field = {Neubauer et al. - 2019 - How phenomenology can help us learn from the experiences of others.pdf:/Users/siainbuletin/Zotero/storage/W3FNPBWI/Neubauer et al. - 2019 - How phenomenology can help us learn from the experiences of others.pdf:application/pdf},
	abstract = {Introduction As a~research methodology, phenomenology is uniquely positioned to help health professions education (HPE) scholars learn from the experiences of others. Phenomenology is a~form of qualitative research that focuses on the study of an individual's lived experiences within the world. Although it is a~powerful approach for inquiry, the nature of this methodology is often intimidating to HPE researchers. This article aims to explain phenomenology by reviewing the key philosophical and methodological differences between two of the major approaches to phenomenology: transcendental and hermeneutic. Understanding the ontological and epistemological assumptions underpinning these approaches is essential for successfully conducting phenomenological research.  Purpose This review provides an introduction to phenomenology and demonstrates how it can be applied to HPE research. We illustrate the two main sub-types of phenomenology and detail their ontological, epistemological, and methodological differences.  Conclusions Phenomenology is a~powerful research strategy that is well suited for exploring challenging problems in HPE. By building a~better understanding of the nature of phenomenology and working to ensure proper alignment between the specific research question and the researcher's underlying philosophy, we hope to encourage HPE scholars to consider its utility when addressing their research questions.},
	bdsk-url-1 = {https://account.pmejournal.org/index.php/up-j-pme/article/view/277},
	bdsk-url-2 = {https://doi.org/10.1007/S40037-019-0509-2}}

@book{newmanpastoral-c,
	author = {Newman, Jane O.},
	date = {1990},
	place = {Baltimore and London},
	publisher = {Johns Hopkins University Press},
	title = {Pastoral {{Conventions}}: {{Poetry}}, {{Language}}, and {{Thought}} in {{Seventeenth-Century Nuremberg}}},
	zotero-field = {Pastoral conventions_ poetry, language, and thought in -- Newman, Jane O -- 1990 -- Baltimore_ Johns Hopkins University Press -- 9780801839962 -- cb16e4f55edafb4ad0c731d0699d9bed -- Anna's Archive.pdf:/Users/siainbuletin/Zotero/storage/ULVZS7DL/Pastoral conventions_ poetry, language, and thought in -- Newman, Jane O -- 1990 -- Baltimore_ Johns Hopkins University Press -- 9780801839962 -- cb16e4f55edafb4ad0c731d0699d9bed -- Anna's Archive.pdf:application/pdf},
	abstract = {In 1644 a group of bourgeois poets gathered to celebrate the wedding of members of two leading families in the imperial city of Nuremberg. The text describing the event, the Pegnesisches Schaefergedicht, also contains a lengthy account of the ritualistic founding of the Pegnesischer Blumenorden, a poet's society named for the Pegnitz River in Nuremberg. Members took academy names, chose symbolic emblems, and agreed to follow academy conventions in composition and publication, thereby establishing a pastoral poetry society that exists to this day. In Pastoral Conventions, Jane O. Newman traces the development of the Nuremberg group as a historical, interpretive community of theorists and poets, and offers the first detailed analysis of their writings to appear in any language. Through this specific, historical example, Newman explores issues at the center of scholarly and intellectual debate about the Renaissance and early modern period, including the prag- matics of textual rhetoric, the ideology of the text's \enquote{blindness} to its own origins, and the need for maintaining critical awareness of its institutionalizing power. As she explores the concept of the text as institution, Newman argues that in seventeenth- century Nuremberg, where textuality remained a central issue in the increasingly print-centered world, poets found meaning in the inaugurary and monumental power of their work to be--- and to do---the work of history. In readings of the order's \enquote{founding texts,} including massive treatises on language theory, elaborate technical poetics, and the lengthy prose and verse pastorals (Schdffereyen), Newman investigates questions of textual representation and explores the strategies by which the specifically German grove became the source of literal and literary authority.}}

