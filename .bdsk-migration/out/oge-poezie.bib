@article{hoffmannlogos-as-c,
	author = {Hoffmann, David},
	date = {2003-06-01},
	journal = {Rhetoric Society Quarterly},
	number = {3},
	pages = {27--53},
	publisher = {Routledge},
	title = {Logos as Composition},
	volume = {33},
	zotero-field = {Full Text PDF:/Users/siainbuletin/Zotero/storage/FAJR793E/Hoffmann - 2003 - Logos as composition.pdf:application/pdf},
	abstract = {This essay argues that the word logos meant \enquote{a gathering or composition} in Homeric Greek and that it retained this sense through the fifth century BCE. It first builds a philological case for the composition/ gathering meaning of logos. Next, it addresses the historiographic question of how the interpretation of logos as logic/language has come to prevail in our histories of Greek thought. Finally, it demonstrates the relevance that the composition/gathering reading of logos can have for the history of rhetoric by showing how it can help in rethinking the \enquote{rivalry} between muthos and logos.},
	bdsk-url-1 = {https://doi.org/10.1080/02773940309391258}}

