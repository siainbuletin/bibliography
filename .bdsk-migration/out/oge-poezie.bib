@incollection{farahmandfarpost-apoca,
	author = {Farahmandfar, Masoud},
	booktitle = {Literature and Its {{Language}}: {{Philosophical Aspects}}},
	date = {2022},
	editor = {Hagberg, Garry L.},
	keywords = {Chaos,Conscious of words,Contradiction,Language failure,Samuel Beckett,Symbolic void},
	pages = {111--126},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {Post-{{Apocalyptic Leftover}}: {{The Void}} of {{Language}} in {{Beckett}}'s {{Murphy}} ‌and {{Endgame}}},
	abstract = {We only become conscious of words when they fail us; it is in the failure of language that we realize our predicament as prisoners of this symbolic void. In reading Beckett's works, the first step is to defer---or, better said, to suspend---the law of non-contradiction. And this suspension is epoch{\'e}. Therefore, if Beckett's mouthpiece talks of a \enquote{pathless path,} we will not take it on the surface level. In this paper, I shall try to present a fresh reading of Beckett's Murphy and Endgame‌, focusing mainly upon the significance of language. We will hopefully come to see why in Beckett's house of fiction words arrive from nowhere, to no purpose, without direction, and without telos. We will come to see why Beckett---in sheer contrast to the Victorian and the early Twentieth-century writers---is not fussing so futilely over the le mot juste. We will see why Beckett's language, his parol de fragment, coming from the outside, the exterior, never let us inside; that is why the words, the impotent words, in Beckett's oeuvre always function to conceal, not revealing anything. This is altogether called Chaos, the primeval void.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-12330-6_6}}

@article{fathi2021aletheia-g,
	author = {Fathi, Hassan and Fani Sani, Mohammad Mehdi},
	journal = {Metaphysics},
	keywords = {aletheia},
	month = {03},
	number = {31},
	pages = {51--72},
	publisher = {University of Isfahan},
	read = {1},
	subtitle = {Study of Heidegger's {{Analysis}} of {{Truth}} in {{Ancient Greek}}},
	title = {Aletheia, Goddess of Parmenids's Poem},
	volume = {13},
	year = {2021},
	zotero-field = {W4GYXFI5},
	abstract = {Heidegger finds a ground for his primary concern, the question of Being, in Parmenides' poem that called \enquote{didactic poem.} by interpreting Parmenides, he tries to unfold the Truth of Being. Parmenides' poem is a revelation from a Goddess that Heidegger claims is the Goddess of Truth or Aletheia. He sees Aletheia as Correspondence or verity, a Deviation from the original essence. For explaining Aletheia, he employs expressions like disclosure, enclosing, and opening. Aletheia is the Truth of Being. Aletheia, an original name of Being, is the ground that things appear on it. In the appearance of things, the ground itself withdraws. In this study, with a descriptive-analytical method, I introduce Heidegger's reading of Alethia as a Goddess of Parmenides's poem. I try to show how one can see this issue as a positive description of the meaning of Truth in Heidegger. in the last section, for examining Heidegger's interpretation, I try to show how other researchers see the goddess of Parmenides. To grasp Heidegger's ideas as a whole, his reading of Parmenides is crucial. By focusing on Parmenides, Heidegger tries to discover a starting point for an insight that can ask about the Truth of Being.},
	bdsk-url-1 = {https://mph.ui.ac.ir/article_25712_en.html},
	bdsk-url-2 = {https://doi.org/10.22108/mph.2021.126014.1252}}

