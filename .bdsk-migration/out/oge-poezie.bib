@incollection{jones2022heidegger-,
	author = {Jones, Emma Reed},
	booktitle = {Challenging a {{Fictitious Neutrality}}: {{Heidegger}} in {{Question}}},
	editor = {Irigaray, Luce},
	keywords = {aletheia},
	pages = {119--160},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {Heidegger {{Without Limits}}},
	year = {2022},
	abstract = {The notion of concealment or lethe stands at the heart of Heidegger's later philosophy. The figure of a dark ground that holds sway at the center of a clearing can be traced through a number of his works, from the \enquote{Nothing} of What is Metaphysics? to the interplay of concealment and unconcealment (lethe and aletheia) in 1930's \enquote{On the Essence of Truth.} Indeed, we might say that lethe is originary, as what allows for aletheia or unconcelament---the alpha-privative designating lethe as primary in the movement of truth (a-letheia). Nevertheless, Heidegger actually seems to prioritize aletheia over lethe and, in so doing, to miss out on a key aspect of Dasein---one that, I argue, staying with lethe could help us illuminate: relational difference via sexuation. Through my reading of \enquote{What is Metaphysics?} and \enquote{On the Essence of Truth} in parallel with several texts by Freud and Lacan, I suggest that these essays of Heidegger's show us a thinker who allows the question of concealment to bring him close to intimate human truths about relationality, sexuality, sexuate difference, and more---but one who ultimately does not allow this movement to occur in its fullness, instead remaining in an ambiguous, paradoxically neutral or neutered place. In this way, I suggest, Heidegger's thinking is set adrift and even lost in a world that lacks a critical limit---that of another subject.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-030-93729-4_4}}

