@incollection{douka-kabitoglouthe-past-o,
	author = {Douka-Kabitoglou, Ekaterini},
	booktitle = {The {{Future}} of {{Flesh}}: {{A Cultural Survey}} of the {{Body}}},
	date = {2009},
	editor = {Detsi-Diamanti, Zoe and Kitsi-Mitakou, Katerina and Yiannopoulou, Effie},
	keywords = {Epic Poetry,Greek Culture,Human Flesh,Lyric Poetry,Private Consciousness},
	pages = {19--41},
	place = {New York},
	publisher = {Palgrave Macmillan US},
	title = {The {{Past}} of {{Flesh}}: {{Mortal}} and {{Immortal Bodies}} in {{Ancient Greek Poetry}}},
	abstract = {In the proem of the Iliad, Homer asks the goddess-Muse to celebrate a certain event, the rage of Achilles, giving us also a summary of the story to follow. It is a kind of lyrical introduction at the opening of the epic poem that \enquote{will explore the relations between man, beast, and god; it will be a story of suffering and death, and will go beyond this to tell of the ultimate fate of the dead.}2 So, it is not accidental that the violation and disgrace of the human body, which becomes a prey to animals, sullies and deconstructs the heroic ideal of the \enquote{beautiful death} that is praised in the Iliad. The Homeric male body, as a body in distress, is the locus of the cut, the blow, the wound. Bodies are molested, traversed by spears, dragged on the ground, disfigured, mutilated, and murdered. The body's dismemberment, with its limbs scattered here and there, culminates in the dreadful act of the human flesh being victimized by a joint plot of the superhuman and subhuman forces, mentioned in the proem of the Iliad and running through the whole epic poem until the last verse, as a nightmarish horror. Indeed, the very iconography of the poem seems to invoke the specter of violence and disintegration, focusing on the horrible body torn to bits, the mutilated body of man as a disfigured corpse that haunts the entire epic tradition.},
	bdsk-url-1 = {https://doi.org/10.1057/9780230620858_2}}

