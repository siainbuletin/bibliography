@book{meyer1989style-and-,
	author = {Meyer, Leonard B.},
	booktitle = {Style and Music},
	date-added = {2025-07-27 14:08:42 +0300},
	date-modified = {2025-07-27 18:54:02 +0300},
	place = {Philadelphia},
	publisher = {University of Pennsylvania Press},
	series = {Studies in the Criticism and Theory of Music},
	subtitle = {Theory, History, and Ideology},
	title = {Style and Music},
	year = {1989},
	abstract = {In Style and Music, Leonard B. Meyer proposes
a general theory of style that relates artistic
creation, criticism, and history to his central
premise---that style is a result of human choices
made within some set of constraints, whether
psychological, cultural, or musical. The inter¬
relationships between choices and constraints
are a focal theme throughout the book.
Meyer takes a bold new approach to the
question of how and why styles change. He
argues that the construction of a history of
music is not, as is often supposed, a matter of
accounting for innovations. Rather, the crucial
question is why, out of the abundance of both
old and new possibilities, composers choose to
replicate some patterns and to neglect others.
Meyer maintains that for a history the most
important constraints influencing composers'
choices are ideological.
To demonstrate his view, Meyer devotes the
latter part of his book to a history of nineteenth-
century music. Beginning with an analysis of
the beliefs and attitudes of Romanticism, he
specifically shows how ideology influenced the
choices of composers from Beethoven through
Mahler. Numerous musical examples from late
eighteenth- and nineteenth-century music illus¬
trate the ways in which such choices were
manifest. In an epilogue, Meyer argues that
Romanticism persisted well into the twentieth
century and discusses how this has affected
styles seldom regarded as Romantic.
Style and Music will be a valuable resource
for all scholars and students of music theory
and history. It will also interest scholars in
related fields---art, literature, history, and
cultural anthropology.},
	file        = {meyer1989style-and-0.pdf}}

