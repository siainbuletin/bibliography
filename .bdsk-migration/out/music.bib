	journal = {Bulletin of the Transilvania University of Bra{\c s}ov, Series VIII: Performing Arts},
	keywords = {analysis,Chojnacka,contemporary music,harpsichord,Khoai,semantics,UNREAD,Xenakis},
	langid = {english},
	number = {1},
	pages = {83--100},
	publisher = {Editura Universitatii Transilvania din Brasov},
	shorttitle = {Formalised or {{Music}}?},
	title = {Formalised or {{Music}}? {{Some Thoughts}} on {{Xenakis}}\&\#39;s {{Khoa}}\&\#239;},
	urldate = {2024-02-19},
	volume = {15},
	abstract = {The analytical approach to Xenakis\&\#39;s compositions is largely focused on the underlying mathematical operations of the music. More recently; however, some analyses have relativised the relevance of the mathematical basis. Xenakis\&\#39;s own statements can support this relativisation. Taking into account the meaning of the title and recognising Khoa\&\#239;\&\#180;s distinctly gestural character, an interpretive approach to Khoai is ventured. The form and performance of the work can be interpreted as storytelling, with the gestures and movements involved in the preparation of a sacrifice to the ancient gods.},
