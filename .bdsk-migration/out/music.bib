@article{agonformal-asp,
	author = {Agon, Carlos and Andreatta, Moreno and Assayag, G{\'e}rard and Schaub, St{\'e}phan},
	date = {2004-06-01},
	date-added = {2024-10-20 16:42:21 +0300},
	date-modified = {2024-10-20 16:42:37 +0300},
	issn = {0929-8215},
	journal = {Journal of New Music Research},
	keywords = {UNREAD},
	number = {2},
	pages = {145--159},
	publisher = {Routledge},
	shorttitle = {Formal {{Aspects}} of {{Iannis Xenakis}}' "{{Symbolic Music}}"},
	title = {Formal {{Aspects}} of {{Iannis Xenakis}}' "{{Symbolic Music}}": {{A Computer-Aided Exploration}} of {{Compositional Processes}}},
	urldate = {2024-02-19},
	volume = {33},
	abstract = {We present computer models of two works for solo instrument by Iannis Xenakis: Herma for piano (1962) and Nomos Alpha for cello (1965). Both works were described by the composer (in his book Formalized Music) as examples of "symbolic music." Xenakis' detailed description of formal aspects in his compositional process makes it possible to implement computer models that recreate essential elements of the final scores. For our implementations, we use OpenMusic, a visual programming language based on CommonLisp/CLOS developed at Ircam. Based on the experiences gathered from developing and exploring these computer models, we discuss the theoretical concepts used by Xenakis in his creative process. Further, we examine how the algebraic organization of Nomos Alpha can be considered as an abstraction of the set-theoretical one used in Herma. We finally suggest to extend Xenakis' outside-of-time/in-time dichotomy by means of a third conceptual category: the "logical time."},
	bdsk-url-1 = {https://doi.org/10.1080/0929821042000310621}}

