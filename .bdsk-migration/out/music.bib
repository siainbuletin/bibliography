@incollection{vallerand2015passion-an,
	author = {Vallerand, Robert J.},
	booktitle = {The {{Psychology}} of {{Passion}}: {{A Dualistic Model}}},
	editor = {Vallerand, Robert J.},
	isbn = {978-0-19-977760-0},
	keywords = {passion},
	month = {05},
	publisher = {Oxford University Press},
	title = {Passion and {{Performance}} and {{Creativity}}},
	year = {2015},
	abstract = {This chapter makes the point that passion plays a major role in performance. Both harmonious and obsessive passions can lead to high performance, albeit through different roads. Long-term performance is achieved through engaging in deliberate practice over several years. It is passion that allows one to pursue engagement in such type of practice over months and years. Achievement goals also play an important role, especially mastery goals. Short-term performance is facilitated by the quality and quantity of one's cognitions (or high levels of absorption and attention), and both seem to benefit from harmonious passion. Finally, passion also matters with respect to creativity. Creativity seems to benefit more from harmonious, than obsessive, passion, mainly through the positive effects that harmonious passion induces in positive emotions, which serve to generate creative thoughts and energy to translate these thoughts into a product.This chapter makes the point that passion plays a major role in performance. Both harmonious and obsessive passions can lead to high performance, albeit through different roads. Long-term performance is achieved through engaging in deliberate practice over several years. It is passion that allows one to pursue engagement in such type of practice over months and years. Achievement goals also play an important role, especially mastery goals. Short-term performance is facilitated by the quality and quantity of one's cognitions (or high levels of absorption and attention), and both seem to benefit from harmonious passion. Finally, passion also matters with respect to creativity. Creativity seems to benefit more from harmonious, than obsessive, passion, mainly through the positive effects that harmonious passion induces in positive emotions, which serve to generate creative thoughts and energy to translate these thoughts into a product.},
	bdsk-url-1 = {https://doi.org/10.1093/acprof:oso/9780199777600.003.0010}}

