	title = {\emph{Characteristica Universalis}},
	url = {https://en.wikipedia.org/w/index.php?title=Characteristica_universalis&oldid=1194807623},
	year = {2024-01-10T21:02:32Z},
	abstract = {The Latin term characteristica universalis, commonly interpreted as universal characteristic, or universal character in English, is a universal and formal language imagined by Gottfried Leibniz able to express mathematical, scientific, and metaphysical concepts. Leibniz thus hoped to create a language usable within the framework of a universal logical calculation or calculus ratiocinator. The characteristica universalis is a recurring concept in the writings of Leibniz. When writing in French, he sometimes employed the phrase sp{\'e}cieuse g{\'e}n{\'e}rale to the same effect. The concept is sometimes paired with his notion of a calculus ratiocinator and with his plans for an encyclopaedia as a compendium of all human knowledge.}}

@incollection{chihara2007modal-real,
	author = {Chihara, Charles S.},
	booktitle = {Philosophy of {{Logic}}},
	date-modified = {2025-03-02 09:52:30 +0100},
	doi = {10.1016/B978-044451541-4/50026-9},
	editor = {Jacquette, Dale},
