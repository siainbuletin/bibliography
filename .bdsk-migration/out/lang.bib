	title = {Contemporary obstacles with the old Zeno's paradoxes},
	year = {2024},
	abstract = {This paper investigates the problems posed by Zeno's well-known paradoxes,
or aporias regarding the notions of infinity, continuity and motion, which are still very
much relevant today. First, it presents two of Zeno's paradoxes, Achilles and Arrow, and
examines various proposed solutions, from Aristotle's arguments about these questions to
the Standard Solution. It then provides an analysis of the Continuum Hypothesis, identified
as a central challenge for the Standard Solution, and offers an exploration of the responses
to the Standard Solution to highlight key objections to its underlying concepts. Finally, it
offers insights into the methods that can be employed to continue to search for a solution
to these paradoxes in the future.},
	file        = {ristevski2024contempora0.pdf}}

