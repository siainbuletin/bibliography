@incollection{beaney2008wittgenste,
  author       = {Beaney, Michael},
  booktitle    = {The {{Oxford Handbook}} of {{Philosophy}} of
                  {{Language}}},
  date-modified= {2025-03-02 09:52:30 +0100},
  doi	       = {10.1093/oxfordhb/9780199552238.003.0002},
  editor       = {Lepore, Ernie and Smith, Barry C.},
  file	       =
                  {Snapshot:/Users/siainbuletin/Zotero/storage/HFHU6SEB/335272209.html:text/html},
  isbn	       = {978-0-19-955223-8},
  pages	       = {0},
  publisher    = {Oxford University Press},
  title	       = {Wittgenstein on {{Language}}: {{From Simples}} to
                  {{Samples}}},
  url	       =
                  {https://doi.org/10.1093/oxfordhb/9780199552238.003.0002},
  year	       = {2008-09-25},
  abstract     = {The so-called `linguistic turn' that took place in
                  philosophy in the first half of the twentieth
                  century is most strongly associated with the work of
                  Ludwig Wittgenstein (1889--1951). If there is a
                  single text that might be identified as the source
                  of the linguistic turn, then it is Wittgenstein's
                  first book, the Tractatus Logico-Philosophicus,
                  published in German in 1921 and in an English
                  translation in 1922. Throughout his work,
                  Wittgenstein was concerned with the foundations of
                  language; the crucial shift lay from the appeal to
                  simples to the appeal to samples, and a
                  corresponding shift from assumptions about what lies
                  hidden to an appreciation of what is visible to all
                  in our linguistic practices. This article first
                  outlines the main elements of Wittgenstein's early
                  conception of language, before considering his
                  critique of that conception and his later views.}
}

@article{bellucci2023frege:-a-f,
	author = {Bellucci, Francesco and Chiffi, Daniele and Zanetti, Luca},
	date-modified = {2025-03-02 09:52:30 +0100},
	doi = {10.1111/theo.12488},
	file = {Full Text PDF:/Users/siainbuletin/Zotero/storage/DWQWAI94/Bellucci et al. - 2023 - Frege A fusion of horizontals.pdf:application/pdf;Snapshot:/Users/siainbuletin/Zotero/storage/Q82QLJPL/theo.html:text/html},
	issn = {1755-2567},
	journal = {Theoria},
	keywords = {assertion,Frege,fusion of horizontals,horizontal,inference,logical notation,},
	number = {5},
	pages = {690--709},
	title = {Frege: {{A}} Fusion of Horizontals},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/theo.12488},
	volume = {89},
	year = {2023},
	abstract = {In Die Grundgesetze der Arithmetik (I, {\S}48), Frege introduces his rule of the fusion of horizontals, according to which if an occurrence of the horizontal stroke is followed by another occurrence of the same stroke, either in isolation or ``contained'' in a propositional connective, the two occurrences can be fused with each other. However, the role of this rule, and of the horizontal sign more generally, is controversial; Michael Dummett notoriously claimed, for instance, that the horizontal is ``wholly superfluous'' in Frege's logical system. In this paper, we challenge Dummett's view by providing a comprehensive analysis of the significance of the horizontal stroke. After some preliminary remarks, we argue that even if Frege's connectives in some sense ``contain'' the horizontal, yet they are total functions. Then, we take up the question of the sense expressed by the horizontal, and we claim that, unlike other sentential operators, the horizontal is not sense-compositional. Finally, we consider the semantic and pragmatic aspects of Frege's horizontal in connection to his judgment stroke and the double judgment stroke. Contra Dummett, we argue that the horizontal is a special and indispensable element of Frege's logic.}}

@article{bentzen2023freges-the,
	author = {Bentzen, Bruno},
	date-modified = {2025-03-02 09:52:30 +0100},
	doi = {10.1590/0100-6045.2023.V46N4.BB},
	file = {Bentzen - 2023 - Frege's Theory of Types.pdf:/Users/siainbuletin/Zotero/storage/HIMBU7QX/Bentzen - 2023 - Frege's Theory of Types.pdf:application/pdf;Full Text PDF:/Users/siainbuletin/Zotero/storage/QWZ9SWAA/Bentzen - 2023 - Frege's Theory of Types.pdf:application/pdf;Bentzen - 2023 - Frege's Theory of Types.pdf:/Users/siainbuletin/Zotero/storage/ZI3QJZGH/Bentzen - 2023 - Frege's Theory of Types.pdf:application/pdf},
	issn = {0100-6045, 2317-630X},
	journal = {Manuscrito},
	keywords = {Frege,Frege's theory of function levels,Grundgesetze,Martin-L{\"o}f type theory,Type theory,},
	number = {4},
	pages = {e-2022-0063.R3},
	publisher = {UNICAMP - Universidade Estadual de Campinas, Centro de L{\'o}gica, Epistemologia e Hist{\'o}ria da Ci{\^e}ncia},
	shortjournal = {Manuscrito},
	title = {Frege's {{Theory}} of {{Types}}},
	url = {https://www.scielo.br/j/man/a/ptskGNwvqf5kh6KCRYshwWr/?lang=en},
	volume = {46},
	year = {2023-12-22},
	abstract = {Abstract It is often claimed that the theory of function levels proposed by Frege in Grundgesetze der Arithmetik anticipates the hierarchy of types that underlies Church's simple theory of types. This claim roughly states that Frege presupposes a type of functions in the sense of simple type theory in the expository language of Grundgesetze. However, this view makes it hard to accommodate function names of two arguments and view functions as incomplete entities. I propose and defend an alternative interpretation of first-level function names in Grundgesetze into simple type-theoretic open terms rather than into closed terms of a function type. This interpretation offers a still unhistorical but more faithful type-theoretic approximation of Frege's theory of levels and can be naturally extended to accommodate second-level functions. It is made possible by two key observations that Frege's Roman markers behave essentially like open terms and that Frege lacks a clear criterion for distinguishing between Roman markers and function names.}}

