@incollection{salmon2020naming-and,
	author = {Salmon, Nathan U.},
	chapter = {11},
	crossref = {bianchi2020language-a},
	date-added = {2025-04-17 16:59:00 +0300},
	date-modified = {2025-04-17 17:00:07 +0300},
	pages = {237-248},
	title = {Naming and Non-necessity},
	abstract = {Kripke's examples of allegedly contingent a priori sentences include `Stick S is exactly one meter long', where the reference of `meter' is fixed by the description `the length of stick S'. In response to skepticism concerning apriority Kripke replaced the meter sentence with a more sophisticated variant, arguing that the modified example is more immune to such skepticism. The case for apriority is examined. A distinction is drawn between apriority and a broader notion, ``qua-priority,'' of a truth whose epistemic justification is dependent on no experience other than that required to justify belief of the deliverances of pure semantics. It is argued that Kripke's examples are neither a priori nor qua-priori.}}

