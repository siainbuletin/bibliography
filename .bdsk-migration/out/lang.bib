@article{drissel2018hardcore-h,
	author = {Drissel, Jennifer},
	date-added = {2025-04-17 18:50:51 +0300},
	date-modified = {2025-04-17 18:50:51 +0300},
	doi = {10.5281/ZENODO.1552695},
	journal = {Messages, Sages and Ages},
	keywords = {torture porn, cinephilia, censorship, pornography, snuff film},
	number = {2},
	pages = {26-36},
	publisher = {Zenodo},
	title = {Hardcore Horror: The Pleasures and Displeasures of Breaking Cinematic Taboos},
	url = {https://zenodo.org/record/1552695},
	volume = {5},
	year = {2018},
	abstract = {
Although films of both the \enquote{Torture Porn} and \enquote{New Extremism} subgenres have been characterized as physically hard to watch, films of the \enquote{Hardcore Horror} subgenre push this characteristic to the extreme by purposely tackling taboo issues such as incest, bestiality, child abuse, and fecal consumption, and portray flawed protagonists that the audience cannot empathize with. Because Hardcore Horror films are typically confined to the Internet, and are largely spread by word of mouth, the appearance of such films in the mainstream film industry typically leads to cries of moral outrage and disgust on the part of censors and theater viewers. This essay examines Srdjan Spasojevic's A Serbian Film (2010) and Tom Six's The Human Centipede II (2011), and argues that these films evoke contradictory emotions among different audiences. To those unaccustomed to the Hardcore Horror subgenre, these films induce vivid sentiments of cinephobia, both in their edited and unedited forms. The subjects presented in these films are too taboo and controversial, even if the audience does not physically see these horrific actions being carried out. Conversely, the Hardcore Horror subgenre also has an extremely dedicated fan base of cinephiles, who yearn for the destruction of cinematic taboos, and seek out Hardcore Horror films in their purest and grittiest forms. In using A Serbian Film and The Human Centipede II as case studies in audience reception and censorship, this essay ultimately asserts that films within the Hardcore Horror subgenre are, and always will be too controversial for mainstream audiences},
	file        = {drissel2018hardcore-h0.pdf}}

