	doi = {10.1007/978-3-030-77550-6_4},
	editor = {Moser, Aloisia},
	isbn = {978-3-030-77550-6},
	keywords = {A. B. Dickerson,Ludwig Wittgenstein,Metaphysical deduction,Representation,Seeing something in a picture,Synthesis,Unity of the proposition,},
	pages = {51--60},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {Synthesis and {{Bringing}} the {{Manifold}} of {{Intuition}} into an {{Image}}},
	url = {https://doi.org/10.1007/978-3-030-77550-6_4},
	year = {2021},
	abstract = {In this chapter, I present a reading of Kant's Transcendental Deduction that lays the groundwork for a discussion of Wittgenstein and the problem of the unity of the proposition. A. B. Dickerson's Kant on Representation and Objectivity parallels the deduction as a problem of making intelligible the unity of complex representations with the problem of the unity of the proposition. For Dickerson representation is an act of synthesis, which presents to us determinations of the mind constituted in the representational medium. In short, it makes us see something in that representational medium. Dickerson is interested in the kind of image-making that takes place in the metaphysical deduction, of which he gives an excellent interpretation with the example of seeing a smiley face in a line drawing. Dickerson sees that apperception is both receptive and spontaneous and that in representation the subject must perform synthesis, but he avoids a discussion of the transcendental level, that is, schematism.}}

