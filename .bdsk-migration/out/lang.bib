	doi = {10.1016/B978-044451541-4/50011-7},
	editor = {Jacquette, Dale},
	file = {ScienceDirect Snapshot:/Users/siainbuletin/Zotero/storage/M53HT99J/B9780444515414500117.html:text/html},
	pages = {205--226},
	place = {Amsterdam},
	publisher = {North-Holland},
	series = {Handbook of the {{Philosophy}} of {{Science}}},
	title = {- {{Justificatory Irrelevance}} of {{Formal Semantics}}},
	url = {https://www.sciencedirect.com/science/article/pii/B9780444515414500117},
	year = {2007-01-01},
	abstract = {This chapter discusses justificatory irrelevance of formal semantics. The formal semantics can be used, within limits, to make conclusive metalinguistic determination about what is proved or, on occasion what is not provable, in a system such as E of entailment, I of intuitionism, C of classical logic, etc. Work with a few procedures in formal semantics reminds that these procedures are irrelevant to justifying as the correct logic the formal systems associated with them. Genuine formal sentential logic consists of those practices, which are employed to determine with certainty what may and may not be done in particular systems and whether or not procedures of particular systems have been correctly followed. The work with formal semantics is really more work with a formal system and not closely connected with justifying any formal system. The formal semantics, which have been proved to characterize a system, do provide tableaux techniques for determining provability in the system which are simpler and clearer than construction of formal proofs in the system. This chapter discusses the problem of justifying a formal logic. Use and interpretation of e-model structures, and world-line matrices for two and three ``points'' are also discussed.}}

