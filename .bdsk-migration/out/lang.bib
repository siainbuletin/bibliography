  booktitle    = {Philosophy of {{Logic}}},
  date-modified= {2025-03-02 09:52:30 +0100},
  doi	       = {10.1016/B978-044451541-4/50018-X},
  editor       = {Jacquette, Dale},
  file	       = {ScienceDirect
                  Snapshot:/Users/siainbuletin/Zotero/storage/XN9HTYII/B978044451541450018X.html:text/html},
  pages	       = {587--614},
  place	       = {Amsterdam},
  publisher    = {North-Holland},
  series       = {Handbook of the {{Philosophy}} of {{Science}}},
  title	       = {- {{L{\"o}wenheim-Skolem Theorems}}},
  url	       =
                  {https://www.sciencedirect.com/science/article/pii/B978044451541450018X},
  year	       = {2007-01-01},
  abstract     = {This chapter provides an overview of the
                  L{\"o}wenheim--Skolem theorems. This chapter gives a
                  picture of what has been obtained with respect to
                  L{\"o}wenheim--Skolem phenomena. This chapter
                  introduces some basic terminology, followed by
                  description of the original result of L{\"o}wenheim
                  and Skolem together with immediate extensions to
                  some other logics. This chapter treats stronger
                  transfer theorems for first-order logic and
                  infinitary languages. They are variants of the
                  so-called L{\"o}wenheim--Skolem--Tarski theorem. The
                  spectrum problem for first-order logic is then
                  elaborated. The chapter investigates special
                  transfers from ``big'' to ``small,'' and deals with
                  reflection principles in set theory. The finite
                  model property, providing a transfer from
                  ``infinite'' to ``finite'' is discussed. The chapter
                  asks for the validity of transfer theorems for
                  logics, which contain operators for fixing
                  cardinalities. The question leads to a more general
                  type of first-order transfer theorems, which involve
                  several cardinalities. After various logics have
                  been considered with respect to the validity of
                  transfer theorems, the subject of L{\"o}wenheim
                  numbers and Hanf numbers as a means to measure the
                  extent to which transfer theorems are valid is
                  treated. The presentation of the results is
                  accompanied by specific information about the
                  literature.}
}

