@article{guo2017older-adul,
	author = {Guo, Philip J.},
	date-added = {2024-12-13 19:10:36 +0200},
	date-modified = {2024-12-13 19:13:15 +0200},
	doi = {10.1145/3025453.3025945},
	keywords = {learning programming; computational literacy},
	title = {Older Adults Learning Computer Programming: Motivations, Frustrations, and Design Opportunities},
	year = {2017},
	abstract = {ABSTRACT
Computer programming is a highly in-demand skill, but
most learn-to-code initiatives and research target some of the
youngest members of society: children and college students.
We present the first known study of older adults learning com-
puter programming. Using an online survey with 504 respon-
dents aged 60 to 85 who are from 52 different countries, we
discovered that older adults were motivated to learn to keep
their brains challenged as they aged, to make up for missed
opportunities during youth, to connect with younger family
members, and to improve job prospects. They reported frus-
trations including a perceived decline in cognitive abilities,
lack of opportunities to interact with tutors and peers, and
trouble dealing with constantly-changing software technolo-
gies. Based on these findings, we propose a learner-centered
design of techniques and tools for motivating older adults to
learn programming and discuss broader societal implications
of a future where more older adults have access to computer
programming -- not merely computer literacy -- as a skill set.},
	file        = {inbox/mac-bibdesk/guo2017older-adul0.pdf}}

