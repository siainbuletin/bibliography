@article{nehamas-2017-nietz-truth,
  author       = {Nehamas, Alexander},
  year	       = 2017,
  file	       = {/Users/siainbuletin/Zotero/storage/7VYJCQGV/Nehamas
                  - 2017 - Nietzsche on Truth and the Value of
                  Falsehood.pdf},
  month	       = 11,
  issn	       = {0968-8005, 1538-4594},
  journal      = {The Journal of Nietzsche Studies},
  number       = 3,
  pages	       = {319--346},
  title	       = {Nietzsche on Truth and the Value of Falsehood},
  urldate      = {2024-01-19},
  volume       = 48,
  abstract     = {Nietzsche often gives the impression that all human
                  beliefs are false. Some scholars, like Maudemarie
                  Clark, believe that such a ``falsification thesis''
                  is unacceptable and try to limit Nietzsche's
                  commitment to it, claiming that he abandons it in
                  his very last works. Others, like Lanier Anderson
                  and Nadeem Hussain, take it in ways that make it
                  true and locate it in all. I argue that the view
                  that is common to both approaches---that Nietzsche
                  held that thesis in the first place---is
                  unjustified. To that end, I interpret the texts
                  where these scholars claim to find the thesis in a
                  way that shows that they do not commit Nietzsche to
                  it, and I offer some reasons for thinking that this
                  is a more fruitful way of interpreting his views on
                  the importance of truth---and falsehood---and their
                  function in the economy of human life.},
  url	       =
                  {https://scholarlypublishingcollective.org/nietzsche-studies/article/48/3/319/210311/Nietzsche-on-Truth-and-the-Value-of-Falsehood},
  doi	       = {https://doi.org/10.5325/jnietstud.48.3.0319}
}

