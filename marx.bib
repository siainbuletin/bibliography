	date-added = {2025-08-24 17:55:42 +0300},
	date-modified = {2025-08-24 17:55:42 +0300},
	eprint = {https://academic.oup.com/book/0/chapter/374914114/chapter-ag-pdf/46327966/book\_44429\_section\_374914114.ag.pdf},
	isbn = {9780190873929},
	month = {08},
	publisher = {Oxford University Press},
	title = {Empiricism and Film Theory: On the Moviola's Political Ontology},
	year = {2022},
	abstract = {{In this chapter, I articulate an empiricist philosophy of film. My approach is schematic and follows the genre of the annotated summary. I dwell on some writings of Gilbert Simondon, some editing techniques of Jean-Luc Goddard, and the pluralist ontology of Gilles Deleuze, and I show how each contributes to an empiricist theory of film. These contributions are at once philosophical, aesthetic, and political. They are philosophical in their elaboration of a process philosophy of becoming, aesthetic in their attempt to consider the filmic image as something other than an Aristotelian substance, and political in their refusal to accept any specific form of belonging as natural. I conclude that an empiricist theory of film offers a rethinking of the ontological conditions of mediation beyond the causal effectivity of influence.}},
	bdsk-url-1 = {https://doi.org/10.1093/oxfordhb/9780190873929.013.9}}

