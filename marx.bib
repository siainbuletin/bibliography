	eprint = {https://academic.oup.com/book/0/chapter/265632813/chapter-ag-pdf/44542643/book\_31744\_section\_265632813.ag.pdf},
	isbn = {9780198834441},
	keywords = {violence},
	month = {01},
	publisher = {Oxford University Press},
	title = {{Representations of suicide in cinema}},
	url = {https://doi.org/10.1093/med/9780198834441.003.0077},
	year = {2021},
	abstract = {{Here, representations of suicide in fiction film from the United States, Europe, and South East Asia are presented. Films are helpful in addressing discourses on suicide worldwide. Typically, the sufferings of the characters considering suicide or taking their lives occupy a minor part of the plot in scenarios highlighting action, cultural, and social reflection or existential interrogations. In Hollywood dramas, redemption, punishment, lost love, and solitude are major reasons for suicides; often the consequence of genuine injustice. In the European films discussed, suicides on screen often open to comments and reflections on many tragic circumstances explaining the protagonists' actions. Not recognizing oneself in and by society seems an important reason for suicide. Wanting to understand the motives behind the voluntary death of a peer is recurrent. Much South East Asian cinema reflects the malaise of a society, its interiorized violence, death' fascination, and the distress of a youth lacking excitement.}}}

@incollection{wasserman2021the-role-o,
	author = {Wasserman, Danuta and Wasserman, Camilla and Westerlund, Michael and Niederkrotenthaler, Thomas},
	booktitle = {{Oxford Textbook of Suicidology and Suicide Prevention}},
	date-added = {2025-08-24 17:55:42 +0300},
	date-modified = {2025-08-24 17:55:42 +0300},
	doi = {10.1093/med/9780198834441.003.0075},
	eprint = {https://academic.oup.com/book/0/chapter/265632553/chapter-ag-pdf/44542650/book\_31744\_section\_265632553.ag.pdf},
	isbn = {9780198834441},
	month = {01},
	publisher = {Oxford University Press},
	title = {{The role of mass media in suicide prevention}},
	url = {https://doi.org/10.1093/med/9780198834441.003.0075},
	year = {2021},
	abstract = {{Most researchers in the field of suicide and mass media nowadays agree that the studies carried out to date have substantiated the existence, under certain circumstances, of genuine suicidal `contagion' from suicide reports in the media. The fact that many studies have demonstrated an association between media reporting of suicide and actual suicidal behaviour has also prompted the issue of various types of recommendations on how the media should report on the subject of suicide to avoid imitative behaviour. In addition to harmful media effects, protective potentials of media reporting have emerged as a major research field in suicide prevention in the last decade, with high relevance to public mental health. The purpose of this text is to discuss and identify the problems associated with research on suicide and the media, with a number of seminal articles published over the years serving as examples.}}}

