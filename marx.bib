@incollection{panagia2022empiricism,
  author       = {Panagia, Davide},
  title        = {Empiricism and Film Theory: On the Moviola's
                  Political Ontology},
  booktitle    = {The Oxford Handbook of Film Theory},
  publisher    = {Oxford University Press},
  year         = {2022},
  month        = {08},
  isbn         = {9780190873929},
  abstract     = {{In this chapter, I articulate an empiricist
                  philosophy of film. My approach is schematic and
                  follows the genre of the annotated summary. I dwell
                  on some writings of Gilbert Simondon, some editing
                  techniques of Jean-Luc Goddard, and the pluralist
                  ontology of Gilles Deleuze, and I show how each
                  contributes to an empiricist theory of film. These
                  contributions are at once philosophical, aesthetic,
                  and political. They are philosophical in their
                  elaboration of a process philosophy of becoming,
                  aesthetic in their attempt to consider the filmic
                  image as something other than an Aristotelian
                  substance, and political in their refusal to accept
                  any specific form of belonging as natural. I
                  conclude that an empiricist theory of film offers a
                  rethinking of the ontological conditions of
                  mediation beyond the causal effectivity of
                  influence.}},
  date-added   = {2025-08-24 17:55:42 +0300},
  date-modified= {2025-08-24 17:55:42 +0300},
