@incollection{nygaard2022marx-engel,
	author = {Nygaard, Bertel},
	booktitle = {History and the {{Formation}} of {{Marxism}}},
	date-modified = {2025-03-18 21:51:46 +0200},
	editor = {Nygaard, Bertel},
	isbn = {978-3-031-09655-6},
	pages = {25--70},
	place = {Cham},
	publisher = {Springer International Publishing},
	series = {Marx, {{Engels}}, and {{Marxisms}}},
	title = {Marx, {{Engels}} and {{Revolutionary History}}},
	year = {2022},
	abstract = {Against simplistic conceptions of Marx's and Engels' conceptions of history, this chapter argues for the importance of their concrete interpretations of history, taking the French Revolution as the key example. A closer study of some of their key writings on this event and its historical implications uncovers complex senses of spatiotemporal dynamics and the interplay between structure and agency in Marx's and Engels' reflections on states, classes, social forms and revolutions.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-09655-6_3}}

@incollection{nygaard2022marxism-in,
	author = {Nygaard, Bertel},
	booktitle = {History and the {{Formation}} of {{Marxism}}},
	date-modified = {2025-03-18 21:51:46 +0200},
	editor = {Nygaard, Bertel},
	isbn = {978-3-031-09655-6},
	pages = {71--128},
	place = {Cham},
	publisher = {Springer International Publishing},
	series = {Marx, {{Engels}}, and {{Marxisms}}},
	title = {Marxism in {{Paris}}, 1889},
	year = {2022},
	abstract = {The first generation of Marxists in the 1880s and 1890s configured Marxism as a comprehensive social theory and worldview. At the same time, they persistently worked towards more nuanced versions of Marxism, seeking to overcome the theoretical aporias that were, to some extent, by-products of the initial theoretical simplifications. The latter endeavours resulted in a particular sort of practical knowledge and a richer sense of collective situatedness within historical processes of development characterized not only by perceived certainties of fate, but also by a variety of possibilities dependent on specific forms of agency. This chapter studies such complexities of historical thought among Marxists in several European countries, starting from the first explicitly Marxist conference of Socialist parties convening in Paris on the centenary of the French Revolution, evoking a wide range of collective memories and differing interpretation of that seminal past event.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-09655-6_4}}

@incollection{nygaard2022reconfigur,
	author = {Nygaard, Bertel},
	booktitle = {History and the {{Formation}} of {{Marxism}}},
	date-modified = {2025-03-18 21:51:46 +0200},
	editor = {Nygaard, Bertel},
	isbn = {978-3-031-09655-6},
	pages = {201--206},
	place = {Cham},
	publisher = {Springer International Publishing},
	series = {Marx, {{Engels}}, and {{Marxisms}}},
	title = {Reconfigurations},
	year = {2022},
	abstract = {During the decades before the First World War, a rich field of highly suggestive interpretive positions and disagreements had emerged within Marxism, implied in strategic debates and historical analyses often developed in close dialogues with specific political conjunctures. The ensuing decades saw such positions translated into theoretical discourse. The French Revolution remained a crucial part of the debates on and within Marxism in the following decades too, very often as new variations on familiar themes, even when new situations called for role changes. This concluding chapter briefly traces some significant features of such developments in Marxist approaches to history.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-09655-6_7}}

@incollection{nygaard2022revisionis,
	author = {Nygaard, Bertel},
	booktitle = {History and the {{Formation}} of {{Marxism}}},
	date-modified = {2025-03-18 21:51:46 +0200},
	editor = {Nygaard, Bertel},
	isbn = {978-3-031-09655-6},
	pages = {129--171},
	publisher = {Springer International Publishing},
	series = {Marx, {{Engels}}, and {{Marxisms}}},
	title = {Revisionist {{Synchronizations}}},
	year = {2022},
	abstract = {Eduard Bernstein's revisionist critique of Marxism, developed in the late 1890s and early 1900s, prominently featured questions of theory and strategy. However, questions of historical interpretation were crucial too, and the French Revolution loomed large in these discussions, also comprising Jean Jaur{\`e}s' detailed historiography of that event as well as notable repercussions in other European labour movements. At the core of revisionist uses of history were conceptions of temporality and class agency differing from those of established Marxism. In general---and despite their lack of theoretical agreement---revisionists tended to de-emphasize elements of non-contemporaneity, re-fitting the various elements of the French Revolution into synchronizing periodizations based on conceptions of a purely bourgeois revolution.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-09655-6_5}}

@incollection{nygaard2022revolution,
	author = {Nygaard, Bertel},
	booktitle = {History and the {{Formation}} of {{Marxism}}},
	date-modified = {2025-03-18 21:51:46 +0200},
	editor = {Nygaard, Bertel},
	isbn = {978-3-031-09655-6},
	place = {Cham},
	publisher = {Springer International Publishing},
	series = {Marx, {{Engels}}, and {{Marxisms}}},
	title = {Revolution and the {{Surplus}} of {{History}}},
	year = {2022},
	abstract = {Through a close reading of the Danish historian Gustav Bang's brief Marxist account of the French Revolution, this chapter unveils a multiplicity of class agencies, projects and temporalities at the core of Second International Marxist interpretations of history. Utopianizing history and historicizing utopian impulses, conceptualizing and stressing the contradictions of concrete history, the first generations of Marxists in effect emphasized the irreducibility of history to its conceptual abstractions, even if this was not consistently reflected in their general statements on social theory.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-09655-6_2}}

@incollection{petra2022conclusion,
	author = {Petra, Adriana},
	booktitle = {Intellectuals and {{Communist Culture}}: {{Itineraries}}, {{Problems}}, and {{Debates}} in {{Post-war Argentina}}},
	date-modified = {2025-03-18 21:51:46 +0200},
	editor = {Petra, Adriana},
	isbn = {978-3-030-98562-2},
	pages = {409--419},
	place = {Cham},
	series = {Marx, {{Engels}}, and {{Marxisms}}},
	title = {Conclusions},
	year = {2022},
	abstract = {Throughout the course of this book, we analyze some fundamental moments in the trajectory of ``intellectual communism'' in Argentina during a particularly turbulent period, in both national political and cultural life as well as in the international communist movement. Although the history of Argentine intellectual life would not be complete without an analysis of the space occupied by the intellectuals who lent their support to communism, this subject had so far been afforded a limited place in the historiographical production. The link between intellectuals and party organizations and groups is a theme that spans the entire twentieth century and crosses several political tendencies, provoking more than a few controversies even today, both within and outside Marxism and the left. One of the objectives of this book is leading new questions about the ever complex and tense forms of intellectual engagement with the world of politics and its logics.},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-030-98562-2_8}}

