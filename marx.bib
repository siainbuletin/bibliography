@incollection{rhodes2022those-who-,
  author       = {Rhodes, John David},
  title        = {Those Who Have: The Impersonality of Film Theory},
  booktitle    = {The Oxford Handbook of Film Theory},
  publisher    = {Oxford University Press},
  year         = {2022},
  month        = {08},
  isbn         = {9780190873929},
  abstract     = {{Across the history of film theory, many theorists
                  of cinema have agreed that it is better to think of
                  cinema as a category---of production and
                  reception---that displaces the person, or displaces,
                  at least, any personal, individualizing sense of the
                  person. Looked at from one angle, the history of
                  film theory looks like an ongoing dialogue about the
                  ability of cinema, as a medium (when used correctly)
                  to decenter and defamiliarize the experience of
                  sovereign personhood. Claims about cinema's ability
                  to produce an experience of depersonalization are
                  bound up with theorists' fascination with cinematic
                  indexical automatism. From debates in Soviet film
                  theory to Maya Deren to the realist film theories
                  associated with Bazin and Kracauer, film theory
                  seems to be enthralled by a modernist
                  sensibility---one that is contemporaneous with
                  cinema's emergence---best encapsulated by T. S.
                  Eliot's famous declaration in his \enquote{Tradition
                  and the Individual Talent} that \enquote{Poetry is
                  not a turning loose of emotion, but an escape from
                  emotion; it is not the expression of personality,
                  but an escape from personality.} Claims for
                  impersonality often intersect with or ground claims
                  for cinema's radical ethical and political
                  potential, especially its promise to usher in new
                  aesthetic, cognitive, and epistemological
                  experiences that are ontologically possible only
                  through the medium of the photographic moving
                  image.}},
  date-added   = {2025-08-24 17:55:42 +0300},
  date-modified= {2025-08-24 17:55:42 +0300},
  eprint       =
                  {https://academic.oup.com/book/0/chapter/374916235/chapter-ag-pdf/46329509/book\_44429\_section\_374916235.ag.pdf},
  bdsk-url-1   =
                  {https://doi.org/10.1093/oxfordhb/9780190873929.013.6},
}

