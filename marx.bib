@article{juan-navarro2007the-power-,
	author = {Juan-Navarro, Santiago},
	date-added = {2025-08-24 17:55:42 +0300},
	date-modified = {2025-08-24 17:55:42 +0300},
	journal = {STVDIVM. Revista de Humanidades},
	keywords = {Plato, Ion, The Republic, mimesis, poetry},
	pages = {97-108},
	subtitle = {PLATO'S CONCEPT OF IMITATION AND HIS JUDGMENT ON THE VALUE OF POETRY AND THE ARTS},
	title = {The Power of Mimesis and the Mimesis of Power},
	volume = {13},
	year = {2007},
	abstract = {For Plato mimesis is the appearance of the external image of things. In his view, reality was not to be found in the world of the objects but in the realm of the Ideas. Therefore, Plato sees in the arts an occupation that is inferior to science and philosophy, but that is also a potential source of corruption. His concept of imitation, although it evolved throughout time, led him to take an increasingly dogmatic and intolerant position regarding artistic creation. His notion that poetry is morally dangerous establishes the foundations for a didactic critique, which tends to flourish in societies undergoing political crises. Plato wrote his works during an age of instability and decline; an age when the role of Athens as the leading power in the Mediterranean was beginning to be questioned. Through an analysis of Ion and Books II, III, and X of The Republic, this essay explores the epistemological and moral ---rather than aesthetic--- nature of Plato's judgment on the value of Poetry and the Arts.},
	bdsk-file-1 = {}}

