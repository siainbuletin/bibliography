	keywords = {Communism,Eduard Bernstein,Frederik Borgbjerg,French Marxism,French Revolution,German Marxism,Gustav Bang,Historiography,Jean Jaur{\`e}s,Karl Kautsky,Karl Marx,Labor Movement,Leon Trotsky,Marxist historiography,Paul Lafargue,Rosa Luxemburg,Russian Marxism,Scandinavia,V.I. Lenin},
