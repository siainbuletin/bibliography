@article{ferencz-flatz2021estetica-v,
	author = {Ferencz-Flatz, Christian},
	booktitle = {Estetica vieții cotidiene {\^\i}n filozofia RSR},
	date-added = {2025-08-24 17:55:42 +0300},
	date-modified = {2025-08-24 17:55:42 +0300},
	doi = {10.51391/trva.2021.11-12.01},
	journal = {Transilvania},
	keywords = {reflection, socialist realism, commodity aesthetics, industrial aesthetics},
	number = {11-12},
	pages = {1-11},
	title = {Estetica vieții cotidiene {\^\i}n filozofia RSR},
	year = {2021},
	abstract = {The present paper analyses the emergence of a novel field of interest in the philosophical aesthetics of the 1960s in
Romania: the aesthetics of everyday life. As such, it first starts by drawing out an overview of the aesthetic discussions in 1950s
Romania by closely reading several articles from the main philosophical journal of the period: Cercet{\u a}ri filozofice. In this regard,
I focus on two main aspects, namely the theory of reflection, which was the guiding principle of Marxist-Leninist aesthetics, and
the theory of the social function of art. Further on I will sketch out how these two aspects defined the main traits of the local
aesthetics of everyday life, a topic which took the center fold of aesthetic interest for almost a decade, and which has ever since
the early 2000s found renewed interest.},
	bdsk-file-1 = {}}

@inbook{ferencz-flatz2023adornos-ge,
  author       = {Ferencz-Flatz, Christian},
  title        = {Adorno's Genetic Phenomenology},
  booktitle    = {Critical Theory and Phenomenology : Polemics,
                  Appropriations, Perspectives},
  pages        = {41-52},
  publisher    = {Springer International Publishing},
  address      = {Cham},
  year         = {2023},
  isbn         = {978-3-031-27615-6},
  abstract     = {There is a certain consensus among contemporary
                  phenomenologists tackling Adorno's criticism of
                  Husserl in saying that, while some of Adorno's
                  objections may hold true for Husserl's early
                  writings, they certainly don't apply when
                  considering his later thinking and especially his
                  turn to genetic phenomenology. This view generally
                  rests upon the assumption that Adorno was by no
                  means familiar with those later aspects of Husserl's
                  philosophy. Against the backdrop of these
                  interpretations, the present chapter intends to show
                  that Adorno was in fact surprisingly well aware of
                  Husserl's genetic turn, in devoting several key
                  reflections to this issue. Moreover, the chapter
                  concludes, these reflections may prove relevant for
                  better assessing the potential of genetic
                  phenomenology itself.},
  date-added   = {2025-08-24 17:55:42 +0300},
  date-modified= {2025-08-24 17:55:42 +0300},
  bdsk-url-1   = {https://doi.org/10.1007/978-3-031-27615-6_3},
}

@book{ferencz-flatza-phenomen,
