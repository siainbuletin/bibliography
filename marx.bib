@article{insaustire-thinkin,
	author = {Insausti, Xabier},
	date-added = {2025-08-24 17:55:42 +0300},
	date-modified = {2025-08-24 17:55:42 +0300},
	issn = {1751-8229},
	journal = {International Journal of Zizek Studies},
	keywords = {Hegel, post-religion, post-pornography, {\v Z}i{\v z}ek, Susan Sontag},
	number = {4},
	pages = {4-21},
	title = {Re-thinking Pornography: Sontag's retrieval of a post-religious Hegel},
	volume = {12},
	abstract = {When Susan Sontag addresses the problem of pornography and relates it to Hegel, she is not merely describing a path in European philosophy aimed to construct a new language, but she is also committing this aim to the importance of re-reading culture. The fashion in which pornography describes reality is meaningful when we are trying to approach Hegel in his aim to construct a post-religious language that finally will make ready-to-hand life as life. Politics, and society, being two essential elements to understand reality, become singularly interesting when analyzed through the gaze of Sontag in combination of Hegel's philosophy. The conservative morals that reign over what we understand as pornography, and the cultural moment of Europe since the most progressive moments of the 19th century, describe a fatalist landscape for the future of society and politics. Yet, the learnings from Hegel remain meaningful. In this paper I examine how a post-religious philosophy, aimed long ago by Hegel's contribution to philosophy, can serve to the understanding of a post-pornographic society: a society that is able to learn from the contributions of Frankfurt's school with regards to an efficient cultural tissue, and defeat the old religious morals that are inserted in the backbone of politics and philosophy still today.
},
	bdsk-file-1 = {}}

@incollection{isenberg2022theory-for,
	author = {Isenberg, Noah},
	booktitle = {The Oxford Handbook of Film Theory},
	date-added = {2025-08-24 17:55:42 +0300},
	date-modified = {2025-08-24 17:55:42 +0300},
	eprint = {https://academic.oup.com/book/0/chapter/374913579/chapter-ag-pdf/46327904/book\_44429\_section\_374913579.ag.pdf},
	isbn = {9780190873929},
	month = {08},
	publisher = {Oxford University Press},
	title = {Theory for the Masses; or, Toward a Vernacular Criticism},
	year = {2022},
	abstract = {{This chapter takes as its point of departure Miriam Hansen's evocative notion of the \enquote{vernacular} as a means of understanding a kind of film writing, from the 1920s up to the present, which is on a deeper, more structural level theoretical---that is, marked by a rigorous, sustained engagement with cinema---but also, in terms of the language in which the ideas are presented, is aimed at a mass audience. We begin with the pioneering film critics from Weimar Germany, Lotte Eisner and Siegfried Kracauer, and trace this line of inquiry through the American scene at mid-century, focusing on critics like Barbara Deming, Robert Warshow, Parker Tyler, and others. The chapter seeks at the same time to bridge the otherwise seemingly insurmountable divide between theory and criticism, between academic discourse and journalism, even between print and electronic media, by tracking the debate through the more recent writings of Susan Sontag and Dave Kehr up to Manohla Dargis, A. O. Scott, and Girish Shambu. In other respects, the chapter serves as a wide-ranging reappraisal of the \enquote{vernacular} and its enduring appeal not only as a useful heuristic tool for grasping the films of classical Hollywood but, more broadly, for dissecting the writing on film and media from the 1920s until now.}},
	bdsk-url-1 = {https://doi.org/10.1093/oxfordhb/9780190873929.013.7}}

