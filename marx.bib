@article{novis-2023-marx-spinoz,
  author       = {Novis, Kenneth},
  journal      = {Production, Alienation, History},
  reviewed-author= {Fischbach, Franck},
  title	       = {Marx with Spinoza},
  year	       = 2023,
  month	       = 09,
  abstract     = {Attempts to combine Marx and Spinoza have been
                  ubiquitous in so-called French Theory since the
                  1960s, beginning with the works of Gilles Deleuze,
                  Alexandre Matheron and the various scholars
                  associated with Louis Althusser's Groupe Spinoza.
                  Among these attempted combinations, some features
                  have remained broadly consistent. Chief among them
                  is a preference for Marx's later, `mature' works, on
                  the basis that they represent his abandonment of a
                  humanist viewpoint which is assumed to be
                  antithetical to Spinozism. Many of the seminal texts
                  of this tradition remain untranslated today -- most
                  glaringly of all, Alexandre Matheron's 1969 Individu
                  et communaut{\'e} chez Spinoza.{\ldots}},
  url	       =
                  {https://marxandphilosophy.org.uk/reviews/21199_marx-with-spinoza-production-alienation-history-by-franck-fischbach-reviewed-by-kenneth-novis/}
