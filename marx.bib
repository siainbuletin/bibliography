@article{degiglio-bellemare2017mondo-real,
	author = {DeGiglio-Bellemare, Mario},
	date-added = {2025-08-24 17:55:42 +0300},
	date-modified = {2025-08-24 17:55:42 +0300},
	journal = {Intensities: The Journal of Cult Media},
	keywords = {mondo realism, sensuality, affectivity, pornography},
	month = {05},
	pages = {50-64},
	title = {Mondo Realism, the Sensual Body, and Genre Hybridity in Joe D'Amato's 'Emanuelle' Films},
	year = {2017},
	abstract = {This paper examines the place of Joe D'Amato's series of Emanuelle ilms within the context of Italian cine- ma, exploitation cinema, and genre studies---especially the pornography and horror genres. I will focus on what I have labelled D'Amato's Mondo Realist ilms that were made in a very short period between 1975-1978. I argue that D'Amato's ilms ofer an expansive sense of genre hybridity, especially as his ilms from this brief period are rooted in the Sadean tradition, the cinema of attractions, the Mondo ilm, neorealism, and the horror genre. I also examine D'Amato's ilms in the terms set out by Linda Williams (2004a); namely, as an auteur of `body genres' whose ilms must be considered in terms that move us beyond dominant scopocentric tendencies in ilm theory. D'Amato's ilms ofer a way to open up these categories through the sensual and corporeal experience of his hybrid ilms.},
	bdsk-file-1 = {}}

