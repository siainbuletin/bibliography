@article{afrin2021the-unreal,
	author = {Afrin, Sadiya},
	date-added = {2025-08-24 17:55:42 +0300},
	date-modified = {2025-08-24 17:55:42 +0300},
	journal = {Ensemble},
	keywords = {Change, a-theory of time, B-theory of time, Presentism, Eternalism, the Real},
	month = {04},
	number = {2},
	pages = {57-64},
	title = {The Unreality of Time: A Critical Analysis},
	volume = {2},
	year = {2021},
	abstract = {The problem of the metaphysics of time is whether the time is real or unreal. This paper will introduce some of the major
positions and arguments concerning the unreality of time. We all know the external world is constantly changing.
`Change is the only constant in life'. We get trapped in the illusion of time and space. But in reality, the past isn't here
anymore, the future yet to be seen, only the present moment seems to be real. But present time also flies or passes away
very rapidly. Whenever we try to grasp it, it slips away. Before discussing the unreality of time, it is necessary to mention
that we will deal with the `experience of time' in this chapter. The mathematical or physicist concept of absolute time
would not be discussed here. Firstly, `Motion is impossible' would be discussed from Zeno's paradox, followed by an
effort to connect it with McTaggert's argument on `Unreality of Time'. Then presentism and eternalism would be
discussed in reference to the unreality of time.},
	bdsk-file-1 = {}}

@article{agner2016salvaging-,
	author = {Agner, Jacob},
	date-added = {2025-08-24 17:55:42 +0300},
	date-modified = {2025-08-24 17:55:42 +0300},
	journal = {The Cormac McCarthy Journal},
	keywords = {snuff film, Cormac McCarthy, late capitalism, trash, drug trade},
	number = {2},
	pages = {204-226},
	title = {Salvaging The Counselor Watching Cormac McCarthy and Ridley Scott's Really Trashy Movie},
	volume = {14},
	year = {2016},
	abstract = {I argue that Cormac McCarthy's he Counselor, set amid the U.S.--Mexican drug wars, critiques late capitalism through self-relexive genre ilmmaking. Centered on the metaphor of trash, this essay connects the ilm's low-art spectacle with the drug trade's entrenchment in globalization and multinational capitalism. he Counselor, in efect, resists cinema's central role in the culture industry by tying its\enquote{trashy} plot to the historically pressing narcotics crisis and the twenty-irst century's accumulating trash heaps.
},
	bdsk-file-1 = {}}

