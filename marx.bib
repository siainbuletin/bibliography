@inbook{emerson2019the-wounde,
  author       = {Emerson, R. Guy},
  title        = {The Wounded Body: A Necropolitics of Living Death},
  booktitle    = {Necropolitics: Living Death in Mexico},
  pages        = {43--69},
  publisher    = {Springer International Publishing},
  address      = {Cham},
  year         = {2019},
  doi          = {10.1007/978-3-030-12302-4_3},
  isbn         = {978-3-030-12302-4},
  url          = {https://doi.org/10.1007/978-3-030-12302-4_3},
  abstract     = {Life is inseparable from death. To live amid violent
                  death is to have it penetrate the body. This is
                  necropolitics as the study of life's inherence to
                  death, of bodies continuous with their violent
                  environment, or better `death world'. Its ontology
                  is the wounded body, drawn from the flesh as
                  outlined by Merleau-Ponty and conatus by Spinoza.
                  Inspired by the former, the wound inscribes death on
                  the flesh and renders it inseparable from the death
                  world; while, following the latter, the body stays
                  death to go on living despite its violent surrounds.
                  Through testimonies of inhabitants in Michoac{\'a}n,
                  necropolitics moves beyond transcendental
                  abstraction and toward an engagement with lived
                  experience. Testimonies are emergent reconstructions
                  of meaning, wherein inhabitants reveal how violent
                  death is not simply imposed on them, but how the
                  body-as-wound is composed of, and composes, the
                  death world.},
  date-added   = {2025-08-24 17:55:42 +0300},
  date-modified= {2025-08-24 17:55:42 +0300},
}

