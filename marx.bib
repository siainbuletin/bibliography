@article{boucheran-ideolog,
  author       = {Boucher, Geoff},
  date	       = {2016-10-01},
  issn	       = {0301-7605},
  journal      = {Critique},
  keywords     = {Jacques Lacan,Louis
                  Althusser,Religion,Theology,Zizek},
  number       = {4},
  pages	       = {451--463},
  publisher    = {Routledge},
  title	       = {An {{Ideological Conception}} of
                  {{Politics}}---{{Critique}} of {{Zizek}} on
                  {{Political Theology}}},
  volume       = {44},
  abstract     = {For some time now, Slavoj Zizek has provocatively
                  maintained that the radical left needs a `politics
                  of universal Truth' whose model is Pauline
                  theology's transformation of the Hellenistic world.
                  Furthermore, in light of the worldwide resurgence of
                  religious militancy after 9/11, Zizek also contends
                  that political theology provides the conceptual
                  resources for thinking historical materialism today.
                  Zizek here represents the leading wing of a
                  `theological turn' amongst radical intellectuals,
                  for whom religion is a last resource of hope
                  following the collapse of historical communism. In
                  this article, I show that this rather desperate
                  position leads to an ideological conception of
                  politics, one that introduces mystified
                  representations of social antagonism and class
                  struggle into the heart of progressive theory.
                  Through an imminent critique of Zizek's work that
                  draws upon its Althusserian foundations, I
                  demonstrate that, although Zizek makes some
                  important contributions to the critique of ideology,
                  his theoretical position contains a significant
                  problem. The idea that ideology and politics are
                  structurally the same, which is what allows him to
                  discuss problems of socialist strategy in the medium
                  of political theology, is seriously flawed. It leads
                  Zizek inevitably towards metaphysical notions of the
                  subject of history, and away from theoretical
                  engagement with rethinking the concept of class
                  struggle for the new century.},
  bdsk-url-1   = {https://doi.org/10.1080/03017605.2016.1236487}
}

@incollection{pelcherintroducti,
	author = {Pelcher, Brandon},
	booktitle = {Dada's {{Subject}} and {{Structure}}: {{Performing Ideology Poorly}}},
	date = {2023},
	date-added = {2025-03-18 21:34:54 +0200},
	date-modified = {2025-08-22 14:38:30 +0300},
	editor = {Pelcher, Brandon},
	isbn = {978-3-031-26610-2},
	langid = {english},
	location = {Cham},
	pages = {1--28},
	publisher = {Springer International Publishing},
	shorttitle = {Introduction},
	title = {Introduction: {{Taking Dada}} and {{Ideology Seriously}}},
	urldate = {2024-02-01},
	abstract = {``Taking Dada and Ideology Seriously'' introduces the study of Dada's contentious relationship with ideological subject formation. After a critical summarization of Louis Althusser's concept of interpellation and subject formation within ideological apparatuses, the introduction recognizes previous intersections between Dada and ideological content, but shifts the critical focus towards ideological processes. This introduction, then, both highlights Dada's preoccupation with subject formation through material signification (signs, manifestos, photographic images, commodities) and sees elements such as paradox, montage, irony, self-contradiction, etc. that have been traditionally associated with Dadaist works as subversions of that formation's smooth function. This double movement, which this book calls Dadaist praxis, underpins Dadaist works, and simultaneously prefigures structuralist conceptions of ideological subject formation (e.g. Althusser, Lacan) and pre-performs poststructuralist critiques of those conceptions (e.g. Butler, de Man).},
	bdsk-url-1 = {https://doi.org/10.1007/978-3-031-26610-2_1}}

@article{oksala-2023-neolib-subjec,
  author       = {Oksala, Johanna},
  journal      = {Critical Inquiry},
  year 	       = {2023},
  number       = 4,
  pages	       = {581-604},
  shortjournal = {Critical Inquiry},
  title	       = {Neoliberal {{Subjectivation}}: {{Between Foucault}}
                  and {{Marx}}},
  urldate      = {2024-01-25},
  volume       = 49,
  abstract     = {This article defends the theoretical centrality of
                  Michel Foucault's account of subjectivation for
                  critical responses to neoliberalism against those
                  Marxist critics who claim that his focus on the
                  subject pushed the Left into the fraught terrain of
                  identity politics. A key contention is that a
                  theoretically sophisticated account of
                  subjectivation is a requisite for any
                  philosophically coherent and politically effective
                  theorization of resistance against neoliberalism.
                  Critical accounts of neoliberal subjectivation must
                  be recognized as indispensable for understanding the
                  conditions of possibility for class struggle and not
                  as an alternative theoretical frame to it. The
                  article also relates Foucault's and Karl Marx's
                  thought on the question of power and its
                  relationship to the subject. It presents a reading
                  of Foucault as a post-Marxist who modified,
                  rejuvenated, and extended Marx's views on power and
                  subjectivation. While Foucault developed his
                  understanding of subjectivation as a critical
                  response to the problems he identified in the French
                  Marxist accounts of his time---particularly in the
                  work of Louis Althusser---his appropriation of Marx
                  should be recognized as decisive for the development
                  of his account of productive power and the
                  concomitant understanding of the subject.},
  doi   = {10.1086/725022}
}

