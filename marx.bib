@review{novismarx-with-,
	author = {Novis, Kenneth},
	date-modified = {2025-03-10 15:04:18 +0100},
	journal = {Production, Alienation, History},
	reviewed-author = {Fischbach, Franck},
	title = {Marx with Spinoza},
	abstract = {Attempts to combine Marx and Spinoza have been ubiquitous in so-called French Theory since the 1960s, beginning with the works of Gilles Deleuze, Alexandre Matheron and the various scholars associated with Louis Althusser's Groupe Spinoza. Among these attempted combinations, some features have remained broadly consistent. Chief among them is a preference for Marx's later, `mature' works, on the basis that they represent his abandonment of a humanist viewpoint which is assumed to be antithetical to Spinozism. Many of the seminal texts of this tradition remain untranslated today -- most glaringly of all, Alexandre Matheron's 1969 Individu et communaut{\'e} chez Spinoza.{\ldots}},
	bdsk-url-1 = {https://marxandphilosophy.org.uk/reviews/21199_marx-with-spinoza-production-alienation-history-by-franck-fischbach-reviewed-by-kenneth-novis/}}

