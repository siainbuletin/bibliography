@article{bartel2014art-and-po,
	author = {Bartel, Christopher},
	date-added = {2025-08-24 17:55:42 +0300},
	date-modified = {2025-08-24 17:55:42 +0300},
	issn = {0007-0904},
	journal = {The British Journal of Aesthetics},
	keywords = {pornography},
	month = {04},
	number = {4},
	pages = {510-512},
	title = {Art and Pornography},
	url = {https://academic.oup.com/bjaesthetics/article-pdf/54/4/510/32551/ayt043.pdf},
	volume = {54},
	year = {2014},
	abstract = {{Philosophical discussions of pornography have largely been dominated by moral and political concerns. However, the past decade has seen an increase of attention for aesthetic concerns. While the moral and political issues remain, some aesthetic issues arise independently of those. The central point of much recent debate is whether pornographic works should count as works of art. On the surface, many pornographic works share obvious similarities to works of art. Moreover, at least some pornographic works would seem to satisfy the conditions required to be art on most respectable definitions. Arguably, interest in this topic could be traced to an exchange between Matthew Kieran and Jerrold Levinson. In `Pornographic Art', Kieran argues that there is no principled reason to deny that some pornography might be art, while Levinson (`Erotic Art and Pornographic Pictures') attempts to offer a three-part distinction between art, pornography, and erotic art, which he claims would save the intuition that pornography is not art while yet leaving space for strongly sexual art---or, erotic art.1 This debate, and in particular the distinction that Levinson defends, has become a focal point for aesthetician's concern for pornography. While many of the chapters in this collection comment further on Levinson's distinction, this collection also makes it clear that there is much more to say about pornography that would concern the aesthetician.}},
	bdsk-url-1 = {https://doi.org/10.1093/aesthj/ayt043}}

