@inbook{hopkins2024aesthetic-,
  title        = {Aesthetic Engagement, Imagining, and the Draw of the
                  Real},
  keywords     = {imagination, aesthetic engagement, beauty, Immanuel
                  Kant, pleasure},
  abstract     = {Paradigm cases of aesthetic engagement are
                  perceptual: we engage with the aesthetic character
                  of things by perceiving them. But is perception the
                  only home for aesthetic engagement, or can we also
                  aesthetically engage with things in imagination?
                  Intuition suggests so. And intuition may seem to
                  find support in Kant's claim that what matters to
                  aesthetic engagement is the character of our
                  representations alone, not whether there is anything
                  they capture. This chapter argues otherwise.
                  Beginning with some simple thoughts about pleasure's
                  motivational structure, and what it motivates in the
                  very different contexts of imagining and perceiving,
                  it argues that imagining supports at best a pale
                  shadow of engagement, and perhaps nothing worthy of
                  the name. In consequence, if Kant's claim is to be
                  true, it will need careful interpreting.},
  chapter      = {8},
  crossref     = {hopkins2024the-profil},
  date-added   = {2025-08-24 17:55:42 +0300},
  date-modified= {2025-08-24 17:55:42 +0300},
}

@book{hopkins2024the-profil,
  author       = {Hopkins, Robert},
  title        = {The Profile of Imagining},
  booktitle    = {The Profile of Imagining},
  publisher    = {Oxford University Press},
  year         = {2024},
  month        = {03},
  doi          = {10.1093/oso/9780198896173.001.0001},
  isbn         = {9780198896173},
  keywords     = {imagination},
  abstract     = {{What is sensory imagining and what role does it
                  play in our lives? How does visualizing, imagining
                  sounds, etc. relate to perceiving such things, or to
                  remembering them? What are the connections between
                  imagining and agency, and how does it relate to
                  emotion and other affect? This book offers a theory
                  that answers these and other questions. It argues
                  that sensory imagining involves the redeployment of
                  resources central to perception, albeit in a
                  radically different context and to very different
                  effect. The view explains central features of
                  imagining's phenomenology and functional role,
                  including its capacity to capture what it would be
                  like to perceive its objects, while acknowledging
                  many important differences between imagining and
                  sensing. It shows how the view can be extended to
                  give an account of imagining in other forms,
                  especially the imagining of affect; and uses it to
                  argue, amongst other things, that imagining
                  something is not a way to engage with its aesthetic
                  character; and that imagining provokes real feeling
                  much less often than is usually thought.}},
  date-added   = {2025-08-24 17:55:42 +0300},
  date-modified= {2025-08-24 17:55:42 +0300},
}

