@article{ewenstein2007beyond-wor,
  author       = {Ewenstein, Boris and Whyte, Jennifer},
  title        = {Beyond {{Words}}: {{Aesthetic Knowledge}} and
                  {{Knowing}} in {{Organizations}}},
  journaltitle = {Organization Studies},
  volume       = {28},
  number       = {5},
  pages        = {689-708},
  publisher    = {SAGE Publications Ltd},
  year         = {2007-05-01},
  doi          = {10.1177/0170840607078080},
  issn         = {0170-8406},
  url          = {https://doi.org/10.1177/0170840607078080},
  urldate      = {2024-03-16},
  file         = {Accepted
                  Version:/Users/siainbuletin/Zotero/storage/R3KS6NMM/Ewenstein
                  and Whyte - 2007 - Beyond Words Aesthetic Knowledge
                  and Knowing in O.pdf:application/pdf},
  abstract     = {Aesthetic knowledge comes from practitioners
                  understanding the look, feel, smell, taste and sound
                  of things. It is vital to work in many
                  organizational contexts. In this paper, we explore
                  aesthetic knowledge and knowing in organizations
                  through detailed observation of design work in the
                  architectural practice Edward Cullinan Architects.
                  Through our research, we explore aesthetic knowledge
                  in the context of architectural work, we unpack what
                  it is, how it is generated, and how it is applied in
                  design projects, shared between practitioners and
                  developed at the level of the organization. Our
                  analysis suggests that aesthetic knowledge plays an
                  important part in organizational practice, not only
                  as the symbolic context for work, but as an integral
                  part of the work that people do. It suggests that
                  aesthetic reflexivity, which involves an opening up
                  and questioning of what is known, is experienced as
                  part of practice as well as a `time out' from
                  practice.},
  date-added   = {2025-08-24 17:55:42 +0300},
  date-modified= {2025-08-24 17:55:43 +0300},
  language     = {en},
  shorttitle   = {Beyond {{Words}}},
  bdsk-url-1   = {https://doi.org/10.1177/0170840607078080},
}

