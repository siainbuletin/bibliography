@incollection{matasova-2021-post-soviet-popul,
  author       = {Matasova, Iuliana},
  editor       = {Gurke, Thomas and Winnett, Susan},
  title        = {Post-{{Sovietness}} of the {{Popular}}: {{The
                  West}}, the {{Post-Soviet Ukrainian Audience}}, and
                  the {{Major Ukrainian Pop Star}} (1990s)},
  booktitle    = {Words, {{Music}}, and the {{Popular}}: {{Global
                  Perspectives}} on {{Intermedial Relations}}},
  series       = {Palgrave {{Studies}} in {{Music}} and
                  {{Literature}}},
  pages        = {179--200},
  publisher    = {Springer International Publishing},
  year         = 2021,
  isbn         = {978-3-030-85543-7},
  keywords     = {1990s,Minor popular
                  culture,Post-Sovietness,Ukrainian popular
                  music,Women singer-songwriters},
  abstract     = {Popular music of the 1990s and its particular
                  phenomenon of women singer-songwriters constitute
                  the broad focus of this chapter. The author performs
                  an analysis of this development by relating the
                  minor Ukrainian popular culture to the major
                  American popular culture industry. This comparison
                  engages the disruption of the 1990s as inherent to
                  the event of post-Sovietness. The following provides
                  a close reading of the Ukrainian-language legacy of
                  Iryna Bilyk, independent Ukraine's first pop
                  superstar and singer-songwriter. Recognizing the
                  impact that Bilyk experienced from the mainstreamed
                  subversive operation present in 1990s alternative
                  singer-songwriters, the author asserts the
                  necessarily political labor of the minor actors of
                  popular culture. With the arrival of the post-Soviet
                  condition, their creative efforts unpack the
                  problematic structure of the imaginary West. The
                  artists' work helps illuminate, in the Ukrainian
                  circumstances, the failing libidinal logic of
                  becoming-West and, in the case of the West, the
                  turning of being-West into an incessantly deferred
                  experience. Unable to further perform the affective
                  reproduction of the imaginary West in a vein of the
                  constructed post-Sovietness, Ukraine's major woman
                  singer-songwriter goes astray (as rendered by her
                  audience), offering instead an emancipatory praxis
                  of embracing the unrecognized post-Soviet difference
                  in search of a nomination other than post-Soviet.},
  date-modified= {2025-03-18 21:51:46 +0200},
  place        = {Cham},
  shorttitle   = {Post-{{Sovietness}} of the {{Popular}}},
  bdsk-url-1   = {https://doi.org/10.1007/978-3-030-85543-7_9},
}

