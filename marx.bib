@article{bennett2004the-postmo,
	address = {Melbourne, VIC},
	author = {Bennett, David},
	date-added = {2025-08-24 17:55:42 +0300},
	date-modified = {2025-08-24 17:55:42 +0300},
	issue_date = {2004},
	journal = {Southern Review},
	keywords = {post-modernism},
	number = {1},
	numpages = {14},
	pages = {62--75},
	publisher = {RMIT University},
	title = {The Postmodern Ends of Obscenity: Pornography, Self-parody and Aesthetics},
	volume = {37},
	year = {2004},
	abstract = {Writing of \enquote{The Pornographic Imagination} in the early 1980s, Susan Sontag argued that \enquote{pornography isn}t a form that can parody itself. A parody of pornography, so far as it has any real competence, always remains pornography'. Since the eighteenth century, the pornographic and the aesthetic have been constructed as mutually exclusive and mutually defining categories, both philosophically and legally. This article considers a recent trend in academic criticism of pornography which seeks to rehabilitate hardcore heterosexist pornographic imagery by discovering in its putatively graphic realism the \enquote{aesthetic} strategies of irony and self-parody. The article traces constructions of the aesthetic/ pornographic dichotomy through modernism to postmodernism, demonstrating its imbrication with such oppositions as ironic/realistic and art/commodity, and asks whether contemporary criticism that collapses the dichotomy signals the terminal exhaustion of either the discourse of aesthetics or that of pornography, or both.},
	bdsk-url-1 = {https://search.informit.org/doi/10.3316/informit.848606502949841}}

