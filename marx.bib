@article{glotmanphotograph,
  author       = {Glotman, Shuka},
  title        = {\enquote{Photograph others as if you were taking
                  your own picture.}},
  subtitle     = {On David Perlov, the Photographer who Took his own
                  Picture},
  abstract     = {In his last movie, My Stills 1952/2002,1 which is a
                  cinematic essay on stills photography, against the
                  background of photographs in which he himself
                  appears, David Perlov makes the following remark:
                  \enquote{Photography---photograph others as if you
                  were taking your own picture, [or taking a picture
                  of] all of nature.} This assertion addresses at one
                  and the same time both the spectator and Perlov
                  himself, who was well aware of the invasive power of
                  the photographic medium, and it hints at the
