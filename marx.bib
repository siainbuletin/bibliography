@review{hamiltonlate-fasci,
	author = {Hamilton, Conrad},
	date-modified = {2025-03-11 22:02:40 +0200},
	reviewed-author = {Toscano, Alberto},
	title = {Late Fascism: Race, Capitalism and the Politics of Crisis},
	abstract = {For better or worse, the canonisation of critical theorists over the past century has tended to follow a familiar pattern: affix to them a signature concept, as well as one -- or, at most, two -- `essential' works. In spite of having written extensively after 1930, Luk{\'a}cs' latter-day forays into everything from the dangerously snafued Schellingian lineage to social ontology are largely forgotten. Instead he's a thinker of `reification,' the truth of whose work must be sought in the shotgun marriage of Hegelian Marxism and classical sociology found in History and Class Consciousness (or, for literature majors, in his writings{\ldots}},
	bdsk-url-1 = {https://marxandphilosophy.org.uk/reviews/21315_late-fascism-race-capitalism-and-the-politics-of-crisis-by-alberto-toscanoterms-of-disorder-keywords-for-an-interregnum-by-alberto-toscano-reviewed-by-conrad-hamilton/}}

