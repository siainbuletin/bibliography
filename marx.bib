@article{newall2015is-seeing-,
  author       = {Newall, Michael},
  title        = {Is Seeing-In a Transparency Effect?},
  journal      = {The British Journal of Aesthetics},
  volume       = {55},
  number       = {2},
  pages        = {131-156},
  year         = {2015},
  month        = {06},
  doi          = {10.1093/aesthj/ayu101},
  issn         = {0007-0904},
  url          = {https://doi.org/10.1093/aesthj/ayu101},
  abstract     = {{Philosophers of art use the term `seeing-in' to
                  describe an important part of our experience of
                  pictures: we often `see' a picture's subject matter
                  `in' its surface. This paper proposes that seeing-in
                  is illuminated by a perceptual phenomenon that has
                  received extensive attention in perceptual
                  psychology: the perception of transparency. It is
                  generally accepted that transparency perception is
                  governed by laws of `scission'. I argue that some
                  instances of seeing-in can be straightforwardly
                  understood as a kind of transparency effect, and
                  that all seeing-in is illuminated by these laws.}},
  date-added   = {2025-08-24 17:55:42 +0300},
  date-modified= {2025-08-24 17:55:42 +0300},
  eprint       =
                  {https://academic.oup.com/bjaesthetics/article-pdf/55/2/131/4976518/ayu101.pdf},
}

