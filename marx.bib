@incollection{richmond2022on-the-imp,
	author = {Richmond, Scott C.},
	booktitle = {The Oxford Handbook of Film Theory},
	date-added = {2025-08-24 17:55:42 +0300},
	date-modified = {2025-08-24 17:55:42 +0300},
	eprint = {https://academic.oup.com/book/0/chapter/374916374/chapter-ag-pdf/46329624/book\_44429\_section\_374916374.ag.pdf},
	isbn = {9780190873929},
	keywords = {aesthetic experience},
	month = {08},
	publisher = {Oxford University Press},
	title = {On the Impersonality of Experience: Psychoanalysis, Interiority, and the Turn to Affect},
	year = {2022},
	abstract = {{Accounts of the fates of film theory after 1970 often, rightly, articulate a rupture between psychoanalytic film theory and its successors, especially the \enquote{turn to affect.} This chapter describes, across this rupture, a shared intellectual problem that animates both: that of the impersonality of experience. This chapter narrates the shift (paraphrasing Eugenie Brinkema) from the episteme of the spectator to the episteme of affect by focusing on how impersonality structures both. In so doing, it emphasizes film theory's basic project of sorting out what is personal and impersonal in our encounters with cinema; part of this project involves developing vocabulary to describe and theorize about the technical articulations and intimate structures of our horizons of experience. The history of film theory---the history of how we speak to one another about what is meaningful in movies and our experiences of them---is, then, one expression of the history of experience. Film theory both in its psychoanalytical phase and its subsequent turn toward affect remains a crucial intellectual inheritance and scholarly practice for reckoning with our present and the ways technical media structure our experience. In other words, the history of film theory since 1970 can be usefully understood as a series of schemes for articulating the intimate impersonality of our relations to technology. It is thus also a history of ways of articulating the political import of what's personal and impersonal about experience in the cinema, and our experience with technical media more broadly.}},
	bdsk-url-1 = {https://doi.org/10.1093/oxfordhb/9780190873929.013.43}}

