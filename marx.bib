@incollection{mcclanahan-2022-indus-cultur,
  author       = {McClanahan, Annie},
  editor       = {Nealon, Christopher and Lye, Colleen},
  title        = {Industry {{Culture}}: {{Labor}} and {{Technology}}
                  in {{Marxist Critical Theory}}},
  booktitle    = {After {{Marx}}: {{Literature}}, {{Theory}}, and
                  {{Value}} in the {{Twenty-First Century}}},
  series       = {After {{Series}}},
  pages        = {192-208},
  publisher    = {Cambridge University Press},
  location     = {Cambridge},
  date         = 2022,
  doi          = {10.1017/9781108776523.013},
  isbn         = {978-1-108-48928-7},
  url          =
                  {https://www.cambridge.org/core/books/after-marx/industry-culture-labor-and-technology-in-marxist-critical-theory/FF2084673A92DEA2E7A9A61DFFD3B4A2},
  keywords     = {Antonio Gramsci,automation,cultural
                  studies,deindustrialization,digital
                  economy,Frankfurt School,James
                  Boggs,technology,university,workers movements},
  abstract     = {This chapter takes up the ways Marxist cultural
                  theory has explored the intensified mechanization or
                  automation of labor. It suggests that the
                  relationship between labor-saving industrial
                  technology and cultural transformation has been
                  central to twentieth-century Marxist thought, from
                  Frankfurt School theorists Walter Benjamin and
                  Theodor Adorno; to mid-century forebearers of
                  cultural studies like Antonio Gramsci and Herbert
                  Marcuse; to activist thinkers C. L. R. James, Raya
                  Dunayevskaya, and James Boggs; to the Italian
                  autonomists. Despite and often alongside their
                  persistent interest in consumption and the
                  commodity, these thinkers have also explored the
                  ways transformations in the ``instruments of labor''
                  affect productive workers themselves. The chapter
                  concludes by drawing attention to the genre of the
                  workers' inquiry, which yokes structural analysis of
                  capital accumulation to a careful rendering of
                  workers' own experiences, and by calling for future
                  workers inquiries exploring technology and the
                  exploitation of university labor.},
  timestamp    = {2024-02-18T16:53:11Z},
}

