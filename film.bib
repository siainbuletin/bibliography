@article{stevensonSoundEffectStudy,
	author = {Stevenson, Ian Robert},
	file = {Stevenson - The Sound Effect a Study in Radical Sound Design.pdf:/Users/siainbuletin/Zotero/storage/49ZE8RIN/Stevenson - The Sound Effect a Study in Radical Sound Design.pdf:application/pdf},
	groups = {📼 There, there},
	keywords = {UNREAD},
	timestamp = {2023-05-24T08:34:27Z},
	title = {The {{Sound Effect}}: A {{Study}} in {{Radical Sound Design}}},
	abstract = {This research project combines a theoretical intervention into sound ontology, with an empirical investigation into listening experience, in parallel with two technologically focused, research-led creative practice projects. The design follows an iterative cycle of research and creative practice that integrates theory, practice and empirical approaches. The research makes an initial contribution to the field of sound studies by reappraising the work of pioneers in the field---Pierre Schaeffer and R. Murray Schafer---in light of the concept of the sonic effect. This concept was introduced by sociologist and musicologist Jean-Fran{\c c}ois Augoyard in the study of urban ambiences and is further developed here as an effective tool for both sound studies and sound design. This theoretical work attempts to critically and creatively examine the ontology or mode of existence of sonic phenomena and is informed by the post-structural theory of the effect. The theory of the sonic effect is empirically investigated by examining verbal accounts of listening experience elicited by semi-structured interview. Finally, having deconstructed sonic phenomena in terms of their potential to be actualised in diverse contexts, sonic effects are interrogated as a creative strategy in the field of sound design for performance and installed sonic art. Two projects are documented. One is a hybrid live performance installation utilising a novel software design for sound composition and projection. The other is a sound installation work demonstrating a novel loudspeaker design for the creation of very dense sound fields. In this context, design occurs as an effect at the intersection of new technologies of sound production and the production of audible sense. This approach enacts a radical pragmatism that underlies the radical sound design strategy outlined in the thesis.}}

@incollection{stewartMetacinematicSpectrumTechnique2021,
	author = {Stewart, Garrett},
	booktitle = {Metacinema: {{The Form}} and {{Content}} of {{Filmic Reference}} and {{Reflexivity}}},
	date = {2021-08-17},
	editor = {LaRocca, David},
	file = {Snapshot:/Users/siainbuletin/Zotero/storage/UTES7UX9/340156129.html:text/html},
