@article{taberhamGeneralAestheticsAmerican2018,
	author = {Taberham, Paul},
	date = {2018-07-01},
	file = {Taberham_2018_A General Aesthetics of American Animation Sound Design.pdf:/Users/siainbuletin/Zotero/storage/PG2DKMMC/Taberham_2018_A General Aesthetics of American Animation Sound Design.pdf:application/pdf},
	groups = {📼 There, there},
