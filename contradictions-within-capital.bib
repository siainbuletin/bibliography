@incollection{hewittMarxPrescientTheory2019,
  title = {Marx’s {{Prescient Theory}} of {{Centralization}} of {{Capital}}: {{Crises}} and an {{Nkrumahist Response}}},
  booktitle = {Karl {{Marx}}’s {{Life}}, {{Ideas}}, and {{Influences}}: {{A Critical Examination}} on the {{Bicentenary}}},
  author = {Hewitt, Cynthia Lucas},
  editor = {Gupta, Shaibal and Musto, Marcello and Amini, Babak},
  date = {2019},
  series = {Marx, {{Engels}}, and {{Marxisms}}},
  pages = {319--344},
  publisher = {Springer International Publishing},
  place = {Cham},
  doi = {10.1007/978-3-030-24815-4_15},
  url = {https://doi.org/10.1007/978-3-030-24815-4_15},
  urldate = {2024-01-25},
  abstract = {Karl Marx’s projection of the global centralization of capital in the hands of fewer and fewer owners through expansionary cycles is affirmed by an analysis of the IMF Financial Access Survey Data (FAS). FAS data shows the rapid incorporation of the populations of semi-periphery and periphery areas into market transactions via financial institution access, such that soon no areas external to the system will be available for new market expansion. This analysis also reveals a bifurcation process occurring, whereby control over centralized capital by the core capitalist structure in place since the start of the system is being challenged from within by the rise of China, with contending socialist principles and a different path to dominance than the European core. Based on the Nkrumahist theory of revolution, the possibilities of African peripheral isolate systems with communal principles generalizing in a period of core system collapse are discussed.},
  isbn = {978-3-030-24815-4},
  keywords = {Capitalist world-system,Centralization of capital,China’s rise,Financial access analysis,Nkrumahism,UNREAD},
  timestamp = {2024-01-25T09:52:52Z}
}

