	file = {/Users/siainbuletin/Zotero/storage/XLN2QFPP/Phillips_Pierson_1997_Cognitive loads and the empowering effect of music composition software.pdf},
	issn = {1365-2729},
	journal = {Journal of Computer Assisted Learning},
	keywords = {composition,enabling environment,Information technology,music psychology,UNREAD},
	langid = {english},
	number = {2},
	pages = {74--84},
	title = {Cognitive Loads and the Empowering Effect of Music Composition Software},
	urldate = {2022-05-26},
	volume = {13},
	year = {1997},
	abstract = {An investigation of music composition software in classrooms was used to study some ways in which open software can support problem solving and thinking. Students of different abilities and ages were observed doing music composition with the software in a variety of teaching contexts. The observations, and the resulting compositions, often showed a level of sophistication in musical structure which could not have been achieved unaided. A number of explanations are considered for this: it is argued that an explanation based on cognitive loads is most convincing in this case. The removal of cognitive loads does nothing positive to help students, but simply gives more space to think by transferring low level cognitive burdens to the software.},
	bdsk-url-1 = {https://onlinelibrary.wiley.com/doi/abs/10.1046/j.1365-2729.1997.00010.x},
	bdsk-url-2 = {https://doi.org/10.1046/j.1365-2729.1997.00010.x}}

