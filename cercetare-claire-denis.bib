  title = {Musicalized {{Sound Design}} and the {{Erotics}} of {{Cinema}}},
  booktitle = {Sound {{Design}} Is the {{New Score}}: {{Theory}}, {{Aesthetics}}, and {{Erotics}} of the {{Integrated Soundtrack}}},
  author = {Kulezic-Wilson, Danijela},
