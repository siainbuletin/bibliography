	date = {2017},
	doi = {10.1007/978-3-319-64858-3_3},
	editor = {Lehmann, Olga V. and Chaudhary, Nandita and Bastos, Ana Cecilia and Abbey, Emily},
	groups = {2.3: Poezia și adev{\u a}rul},
	isbn = {978-3-319-64858-3},
	keywords = {Poetic Expression,Poetic Message,Poiesis,Recent Social Movements,Societal Creativity,UNREAD},
	location = {Cham},
	pages = {43--62},
	publisher = {Springer International Publishing},
	series = {Palgrave {{Studies}} in {{Creativity}} and {{Culture}}},
	timestamp = {2024-02-04T11:48:02Z},
	title = {Poetry in and for {{Society}}: {{Poetic Messages}}, {{Creativity}}, and {{Social Change}}},
	url = {https://doi.org/10.1007/978-3-319-64858-3_3},
	urldate = {2024-02-04},
	abstract = {Poetry is far from being an escapist type of activity, removed from society and reduced to a personal form of expression. On the contrary, poetic expressions are not only social endeavors, they also create something with the potential to question society and engage people in political action. In making this claim, we trace back poetry to its etymological roots, the Greek term poiesis, designating the activity of ``making'' or ``bringing into existence.'' In this chapter, we illustrate the political power of poetic expressions or, more broadly, of creative making (poiesis), at the level of society. Concretely, we will take the case study of a recent social movement in Mexico, YoSoy132, which uses poetic messages, among other art forms, to protest against the political establishment.}}

