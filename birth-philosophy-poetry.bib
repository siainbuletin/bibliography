@article{gunaydinCharacterizationAttemptLogos2022,
	author = {G{\"u}naydin, {\.I}brahim},
	date = {2022-08-30},
	doi = {10.20981/kaygi.1085365},
	file = {Full Text:/Users/siainbuletin/Zotero/storage/962JESII/G{\"u}naydin - 2022 - Characterization Attempt on Logos in Heidegger.pdf:application/pdf},
	groups = {2.3: Poezia și adev{\u a}rul},
	issn = {2645-8950},
	journal = {Kaygı. Uluda{\u g} {\"U}niversitesi Fen-Edebiyat Fak{\"u}ltesi Felsefe Dergisi},
	keywords = {UNREAD},
	shortjournal = {Kaygı},
	timestamp = {2024-02-03T18:26:48Z},
	title = {Characterization Attempt on Logos in Heidegger},
	url = {https://dergipark.org.tr/tr/doi/10.20981/kaygi.1085365},
	urldate = {2024-02-03},
	abstract = {This study is an attempt to characterize the word logos. In this research process, Heidegger's phenomenological method will be taken into account as much as possible. Explanations on the logos in the ``Second Chapter'' of Heidegger's ``Preface'' of Being and Time, published in 1927, will form the scope of the study. The study will present its research in three stages. In the first of these stages, the following subjects will be investigated: how Heidegger handles the word logos in his book Being and Time, what method he follows here, and what are the main theses on which this method is based. In the second stage, the terms ``al{\^e}theia'', ``signifier'', ``signified'', ``phenomenon'', ``appearance'' will be discussed in Heidegger's phenomenology understanding. As a matter of fact, each of these are terms with which this study directly or indirectly relates. In addition, what this study has done is essentially a phenomenological exposition of the logos. Therefore, this exposition will also be included in the scope of the study. The words ``explain'' and ``interpret'' will be used to aid this exposition. In the third stage, ``Recharacterization of the Logos'', the main issue of the study, the word logos, will be discussed and it will be questioned how it can be expressed in accordance with its original form.           ,              Bu {\c c}alı{\c s}ma logos s{\"o}zc{\"u}{\u g}{\"u}n{\"u}n karakterizasyonuna dair giri{\c s}im niteli{\u g}inde bir ara{\c s}tırmadır. Ara{\c s}tırma s{\"u}recinde m{\"u}mk{\"u}n mertebe Heidegger'in fenomenolojik y{\"o}ntemi dikkate alınacaktır. Heidegger'in 1927 yılında yayımlanmı{\c s} eseri Varlık ve Zaman'ın ``Mukaddime''sinin ``{\.I}kinci B{\"o}l{\"u}m{\"u}''nde ge{\c c}en ``logos''a dair a{\c c}ıklamalar {\c c}alı{\c s}manın kapsamını olu{\c s}turacaktır. {\c C}alı{\c s}ma {\"u}{\c c} a{\c s}amada ara{\c s}tırmasını ortaya koyacaktır. Bu a{\c s}amaların ilkinde Heidegger'in, Varlık ve Zaman isimli kitabında logos s{\"o}zc{\"u}{\u g}{\"u}n{\"u} nasıl ele aldı{\u g}ı, hangi y{\"o}ntemi izledi{\u g}i ve bu y{\"o}ntemin dayandı{\u g}ı temel tezler soru{\c s}turmaya tabi tutulacaktır. {\.I}kinci a{\c s}amada Heidegger'in fenomenoloji anlayı{\c s}ı {\"o}zelinde ``al{\^e}theia'', ``g{\"o}steren'', ``g{\"o}sterilen'', ``fenomen'', ``g{\"o}r{\"u}n{\"u}{\c s}'' gibi terimler fenomenolojik ili{\c s}kiler {\"o}zelinde tartı{\c s}ılacaktır. Bunun yanında bu {\c c}alı{\c s}manın yapmı{\c s} oldu{\u g}u {\c s}ey {\"o}z{\"u}nde logosa dair fenomenolojik bir a{\c c}ımlama oldu{\u g}u i{\c c}in fenomenolojik a{\c c}ımlamayı a{\c c}ımlama, {\c c}alı{\c s}manın kapsamına ayrıca girecektir. Bu a{\c c}ımlamaya yardımcı olması i{\c c}in ``explain'' ve ``interpret'' s{\"o}zc{\"u}kleri devreye sokulacaktır. ``Logosun Yeniden Karakterizasyonu'' adlı {\"u}{\c c}{\"u}nc{\"u} a{\c s}amadaysa {\c c}alı{\c s}manın asıl meselesi olan logos s{\"o}zc{\"u}{\u g}{\"u} ele alınarak aslına uygun bir {\c s}ekilde nasıl ifade edilebilir oldu{\u g}u sorgulanacaktır.}}

@article{gurevitchDialecticalDialogueStruggle2001,
	author = {Gurevitch, Zali},
	date = {2001},
	doi = {10.1080/00071310020023046},
	file = {Snapshot:/Users/siainbuletin/Zotero/storage/DW6G4FHR/00071310020023046.html:text/html},
	groups = {2.3: Poezia și adev{\u a}rul},
	issn = {1468-4446},
	journal = {The British Journal of Sociology},
	keywords = {dialectics,Dialogue,ethics,multiplicity,silence,UNREAD},
	number = {1},
	pages = {87--104},
	timestamp = {2024-02-03T20:49:12Z},
	title = {Dialectical Dialogue: The Struggle for Speech, Repressive Silence, and the Shift to Multiplicity},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1080/00071310020023046},
	urldate = {2024-02-03},
	volume = {52},
	abstract = {In the present essay I intend to explore `dialectical dialogue' in three distinct moments: the battle for recognition, the ethics of giving recognition, and the multiplicity of conversation. The essay begins with Hegel's figures of Master and Slave portraying the struggle of speech for recognition. This struggle culminates in a duel for mastery, which implies the repression and silencing of the other's speech. Ethical dialogue comes as a response to repressive silence, calling the other into egalitarian exchange. Ethical dialogue as such, however, remains within the dialectical framework of agonistic relations. To shift from dialectics to multiplicity, the essay turns from the politics of recognition to the poetics of conversation, to polyphony and to passage. I will follow the three moments both separately, through particular dialogic instances and theoretical perspectives, and as they develop, respond to, and shift from one to the other. Together they will portray an idea of the `social' as a critical dialogic stance with its inherent dialectical betweenness and potential opening and expanding multiplicity.}}

