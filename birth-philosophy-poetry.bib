	timestamp = {2024-02-01T19:00:07Z},
	title = {``{{What}} Is This World?'': {{Chaucer}}, {{Realism}}, and {{Metaphysics}}},
	url = {https://doi.org/10.1007/978-3-031-12330-6_8},
	urldate = {2024-02-01},
	abstract = {What is Chaucer's metaphysics? The possibilities span the debate between nominalists and realists in the fourteenth century. In this essay, three interrelated puzzles are explored: the metaphysics of beauty in The Parliament of Fowls; the nature of the rocks in The Franklin's Tale; and the ontology of narrative in The Nun's Priest's Tale. These studies show that Chaucer's appreciation of the reality of things underpins the sensate detail evident in his poetry. Throughout, Chaucer's affinities with Wittgenstein's thinking will be noted, including the shared insight that all projects to grasp the ``incomparable essence of language'' are vain.}}

