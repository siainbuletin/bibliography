@incollection{walserFoolingMaterialMeaningMaking2022,
	author = {Walser, Hannah},
	booktitle = {Literature and Its {{Language}}: {{Philosophical Aspects}}},
	date = {2022},
	doi = {10.1007/978-3-031-12330-6_10},
	editor = {Hagberg, Garry L.},
	isbn = {978-3-031-12330-6},
	keywords = {Deception,Epistemic injustice,Fooling,Huckleberry Finn,Mark Twain,UNREAD,William Wells Brown},
	location = {Cham},
	pages = {187--205},
	publisher = {Springer International Publishing},
	timestamp = {2024-02-01T19:00:06Z},
	title = {Fooling: {{Material Meaning-Making Under Conditions}} of {{Epistemic Injustice}}},
	url = {https://doi.org/10.1007/978-3-031-12330-6_10},
	urldate = {2024-02-01},
	abstract = {Through readings of Mark Twain's Adventures of Huckleberry Finn and William Wells Brown's Clotelle, this article identifies a practice that I call ``fooling'': a form of non-linguistic deception that creates tableaux filled with clues intended to activate a misguided behavioral schema. Like children's pretend play, fooling is grounded in what I call material misreading: a substantial alteration of an object's meaning and/or identity through performance. Unlike pretend play, however, fooling is asymmetrical and involves at least one nonconsenting party. Because fooling, unlike lying, does not require the victim to trust the deceiver, fooling is especially well-suited to deception across a power or status differential. In this respect, fooling both emerges from and offers potential resistance to epistemic injustice as Miranda Fricker has defined it: an unfair distribution of epistemic resources and authority that characterizes both Twain's Gilded Age and our own.}}

