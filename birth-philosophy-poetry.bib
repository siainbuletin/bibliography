	doi = {10.1007/978-3-031-12314-6_11},
	editor = {Bassler, O. Bradley},
	isbn = {978-3-031-12314-6},
	keywords = {Catastrophe Theory,Jacques Derrida,Jacques Lacan,Poetic Reason,Ren{\'e} Thom,UNREAD},
	location = {Cham},
	pages = {327--346},
