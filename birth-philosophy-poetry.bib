@incollection{basslerAnalysisOpposedWhat2022,
	author = {Bassler, O. Bradley},
	booktitle = {The {{Legitimacy}} of {{Poetic Reason}}},
	date = {2022},
	doi = {10.1007/978-3-031-12314-6_5},
	editor = {Bassler, O. Bradley},
	isbn = {978-3-031-12314-6},
	keywords = {Analytic Rationality,Jacques Lacan,Philosophical Praxis,Psychoanalysis,UNREAD},
	location = {Cham},
	pages = {109--131},
	publisher = {Springer International Publishing},
	timestamp = {2024-02-01T18:56:58Z},
	title = {Analysis as {{Opposed}} to {{What}}?},
	url = {https://doi.org/10.1007/978-3-031-12314-6_5},
	urldate = {2024-02-01},
	abstract = {In this chapter I move from the rudiments of a theory of the poetic subject to a report from the field. Just as psychoanalysis must be understood in terms of the fundamental, praxical role played by the analysis itself, so creative reason must be understood as grounded in an analogous praxis. What the psychoanalytic praxis and poetic praxis have in common is that they are both what I call paraphilosophical praxes. In principle any praxis may be understood as one in which desire is enlisted in a praxis which is on its way to philosophical reflection. Analytic work and poetic work are exemplary in this regard, and each in its own way sheds light on the question what rationality could be involved in such a work. The irony of psychoanalysis is that, while cultivating one of the most powerful models of analytic rationality, it paves the way for seeing the poetic rationality implicated in the very transaction of analysis itself. This provides a leading clue for identifying poiesis, making governed by poetic reason, in more general terms and answering the question, ``analysis as opposed to what?''}}

@incollection{basslerBenjaminSchlegelCavell2022,
	author = {Bassler, O. Bradley},
	booktitle = {The {{Legitimacy}} of {{Poetic Reason}}},
	date = {2022},
	doi = {10.1007/978-3-031-12314-6_2},
	editor = {Bassler, O. Bradley},
	groups = {X: Adjacent},
	isbn = {978-3-031-12314-6},
	keywords = {Friedrich Schlegel,Jean-Luc Nancy,Philippe Lacoue-Labarthe,Stanley Cavell,UNREAD,Walter Benjamin,Wittgenstein},
	location = {Cham},
	pages = {27--43},
	publisher = {Springer International Publishing},
	timestamp = {2024-02-01T18:56:59Z},
	title = {Benjamin/{{Schlegel}}: {{Cavell}}/{{Wittgenstein}}},
	url = {https://doi.org/10.1007/978-3-031-12314-6_2},
	urldate = {2024-02-01},
	abstract = {In this chapter I look at two receptions of ideas from German Idealism developed in the Athenaeum circle around Friedrich Schlegel: Walter Benjamin's discussion of Schlegel's aesthetic theory and Stanley Cavell's reception of Emerson and Wittgenstein, where both of these latter two are understood in the light of work by Philippe Lacoue-Labarthe and Jean-Luc Nancy on the literary absolute in German Romanticism. In each case, a crucial piece is identified for the project of legitimating poetic reason. Benjamin isolates a core insight from Schlegel concerning the work of art understood as a reflective medium, and extricates it from the theological context in which Schlegel presents it. The structure of the work as reflective medium will become central for the account of the poetic medium as a core structure within the poetic subject. Cavell identifies a way in which Emerson and Wittgenstein can both be understood as extending strategies of transcendental justification deriving from the Kantian background in German Idealism, and these strategies will contribute to the legitimation of poetic reason in later chapters.}}

@incollection{basslerEsotericGeometryPoetic2022,
	author = {Bassler, O. Bradley},
	booktitle = {The {{Legitimacy}} of {{Poetic Reason}}},
