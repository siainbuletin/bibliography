@incollection{wongFluxTime2022,
	author = {Wong, Kwok Kui},
	booktitle = {Time and {{Poetic Speech}}: {{A Philosophical Investigation}}},
	date = {2022},
	doi = {10.1007/978-3-031-12455-6_2},
	editor = {Wong, Kwok Kui},
	isbn = {978-3-031-12455-6},
	keywords = {Being,Distentio animi,Extension,Flux,Flux of consciousness,Infinite division,Inner sense,Unmoving "I",UNREAD,Zeitigung},
	location = {Cham},
	pages = {9--31},
	publisher = {Springer International Publishing},
	timestamp = {2024-02-01T19:08:02Z},
	title = {The {{Flux}} of {{Time}}},
	url = {https://doi.org/10.1007/978-3-031-12455-6_2},
	urldate = {2024-02-01},
	abstract = {In Western philosophy, time has often been described as or compared with flux, a flow, or a river. These philosophical metaphors can be traced back to Heraclitus, whose metaphysical doctrines, ``you cannot step twice into the same stream'' and ``everything flows'' (πάντα ῥεῖ), can best be illustrated by the example of time. Plato, for example, quotes Heraclitus in his speculation about the etymology of the names of the gods Chronos and Rhea in Cratylus: while both are rivers, the former means time, while the latter, interestingly, is etymologically related to rheo, which means ``to speak'' and also ``to flow.'' Plato asks, ``Is the giving of the names of streams to both of them purely accidental?'' The same goes for the river Oceanus, and we are reminded that these speculations about river names are inspired by Heraclitus. This crust of the issue is the gigantomachy between Heraclitus and the Eleatic School, Parmenides in particular, who imagines a world of pure space with no change, no movement, and thus no time. It is indeed true that in time nothing abides, for if anything does abide, it will remain the same and therefore contradict the nature of time, which is constant change and difference. It has also to be remarked that when Heraclitus says that ``you cannot step twice into the same stream,'' this stream metaphor for time does not mean that the stream itself must show any visible or real change, but only that it, in principle, has become different over time because it is in different points of time. What has really moved does not have to be the flux itself but time, which guarantees movement at every instant. Time can therefore be conceived as ``ideal'' flux, a universal movement overarching all other movements and permanence. This idea has lived on in modern philosophy, as Kant and Husserl, among others, have also used the metaphors ``flux'' and ``stream'' to describe time as inner consciousness in which nothing abides.}}

