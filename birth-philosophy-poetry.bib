@article{hernerCosmicSoulHeraclitus,
	author = {Herner, M{\'a}t{\'e}},
	file = {Herner - COSMIC SOUL IN HERACLITUS.pdf:/Users/siainbuletin/Zotero/storage/JB9B5LZL/Herner - COSMIC SOUL IN HERACLITUS.pdf:application/pdf},
	groups = {4.4: Heraclit ca Poet},
	keywords = {🌟,UNREAD},
	timestamp = {2024-02-02T12:23:59Z},
	title = {Cosmic {{Soul}} in {{Heraclitus}}},
	abstract = {In his 2007 article ``On the Physical Aspect of Psych{\=e} in Heraclitus''1 G{\'a}bor Betegh presents a new picture about the place of the soul in Heraclitus' metaphysical landscape. He suggests that in Heraclitus, the term ``soul'' can refer not only to individual entities, but also to ``a kind of stuff'', which then could be present not only in human beings, but also outside us. Thus, although the goal of the paper is to give an alternative account about what kind of an entity the soul is, the cosmological implications of this new interpretation also bring an old question back into the light, namely ``Is there a world soul in Heraclitus' cosmos?''.}}

