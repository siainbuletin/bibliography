	doi = {10.1007/978-3-031-12330-6_12},
	editor = {Hagberg, Garry L.},
	isbn = {978-3-031-12330-6},
	keywords = {Alain Badiou,Anticipation,Declarative event,Entrainment,Expectation,Poetic utterance,Rhythm,Sound,Uncanny,UNREAD},
	location = {Cham},
	pages = {245--274},
	publisher = {Springer International Publishing},
	timestamp = {2024-02-01T19:00:08Z},
	title = {Rehearsing the {{Unexpected}}: {{Poetry}} and {{Rhythm}} in the ({{New}}) {{Age}} of the {{Poets}}},
	url = {https://doi.org/10.1007/978-3-031-12330-6_12},
	urldate = {2024-02-01},
	abstract = {This essay explores the recent debates taking place among Continental philosophers to do with the significance for philosophy of poetry, the poetic utterance. Philosophy, Alain Badiou has argued, has been in crisis since the dethroning of the cogito, and needs to explore the way poetry can provide access to new forms of truth. Crucial to the poetic utterance, which is always a declarative ``event'', is the role of rhythm and sound, what Mallarm{\'e} called ``the song beneath the text''. In their disruption of signification, it is well recognized, the formal features of the poem free language up to impact on the senses. But exactly how this comes about is a complex and usually avoided question. This essay attempts some tentative answers to do with involuntary bodily responses, entrained and internalized social rhythms, and the role of anticipation and expectation in poetic reading. Drawing on work in philosophy, psychoanalysis, aesthetics, political ecology and the musicology of perception, it attempts to understand how so much poetry can arouse a ``chills'' effect.}}

