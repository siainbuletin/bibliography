	url = {https://www.cambridge.org/core/product/identifier/9781139547376/type/book},
	urldate = {2024-02-02},
	abstract = {The Cambridge History of Gay and Lesbian Literature presents a global history of the field and is an unprecedented summation of critical knowledge on gay and lesbian literature that also addresses the impact of gay and lesbian literature on cognate fields such as comparative literature and postcolonial studies. Covering subjects from Sappho and the Greeks to queer modernism, diasporic literatures, and responses to the AIDS crisis, this volume is grounded in current scholarship. It presents new critical approaches to gay and lesbian literature that will serve the needs of students and specialists alike. Written by leading scholars in the field, The Cambridge History of Gay and Lesbian Literature will not only engage readers in contemporary debates but also serve as a definitive reference for gay and lesbian literature for years to come.}}

@article{mccreaPoetryGoodEvil2010,
	author = {McCrea, Lawrence},
	date = {2010-10-01},
	doi = {10.1007/s10781-010-9098-4},
	issn = {1573-0395},
	journal = {Journal of Indian Philosophy},
	keywords = {Bilha{\d n}a,Court epic,Panegyric,Patron,R{\=a}va{\d n}a,UNREAD,Vikram{\=a}ditya VI},
	number = {5},
	pages = {503--518},
	shortjournal = {J Indian Philos},
	timestamp = {2024-02-01T19:07:15Z},
	title = {Poetry {{Beyond Good}} and {{Evil}}: {{Bilha{\d n}a}} and the {{Tradition}} of {{Patron-centered Court Epic}}},
	url = {https://doi.org/10.1007/s10781-010-9098-4},
	urldate = {2024-02-01},
	volume = {38},
	abstract = {The eleventh century poet Bilha{\d n}a's magnum opus, his Vikram{\=a}{\.n}kadevacarita, quickly became one of the most admired and quoted examplars of a newly emergent genre in second millennium Sanskrit poetry, the patron-centered court epic---an extended verse composition dedicated to relating the deeds and celebrating the virtues of the pet's own patron. But Bilha{\d n}a's verse biography of his patron, the C{\=a}lukya monarch Vikram{\=a}ditya VI, while ostensibly singing his praises, is colored throughout by darker suggestions that Vikram{\=a}ditya may be less than the moral paragon it proclaims him to be, and that the power of poetry lies precisely in its ability to fabricate royal virtue where none exists, and to wash clean the reputation of any king, regardless of his actual deeds. He makes these insinuatons through a variety of formal and narrative techniques, most strikingly by his persistent suggestions that Vikram{\=a}ditya has perhaps less in common with R{\=a}ma, the archetypal paragon of royal virtue, than with his demonic antagonist R{\=a}va{\d n}a, and, even more corrosively, that R{\=a}ma's own reputation may owe more to his panegyrist's skill than to his own virtue.}}

