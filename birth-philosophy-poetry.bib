@article{bjorkWomenPhilosophyDesire2006,
	author = {Bj{\"o}rk, Ulrika},
	date = {2006-11},
	doi = {10.1080/08038740701211096},
	file = {Bj{\"o}rk - 2006 - Women, Philosophy and Desire ---A Reflection on Philosophical Didactics1.pdf:/Users/siainbuletin/Zotero/storage/4DVB5Z8B/Bj{\"o}rk - 2006 - Women, Philosophy and Desire ---A Reflection on Philosophical Didactics1.pdf:application/pdf},
