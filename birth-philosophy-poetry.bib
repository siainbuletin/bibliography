@article{wrethedAmPlaceAletheia2015,
	author = {Wrethed, Joakim},
	date = {2015-01-01},
	doi = {10.3402/jac.v7.28020},
	file = {Full Text PDF:/Users/siainbuletin/Zotero/storage/N8QT7DQN/Wrethed - 2015 - ``I am a place'' Aletheia as aesthetic and political resistance in Margaret Atwood's Surfacing.pdf:application/pdf},
	groups = {2.3: Poezia și adev{\u a}rul},
	issn = {null},
	journal = {Journal of Aesthetics \& Culture},
	keywords = {aesthetics,ecocriticism,enframing,epistemology,martin heidegger,Merleau-Ponty,perception,phenomenology,Ranci{\`e}re,the flesh,UNREAD},
	number = {1},
	pages = {28020},
	publisher = {Routledge},
	timestamp = {2024-02-03T18:08:37Z},
	title = {``{{I}} Am a Place'': {{Aletheia}} as Aesthetic and Political Resistance in {{Margaret Atwood}}'s {{Surfacing}}},
	url = {https://doi.org/10.3402/jac.v7.28020},
	urldate = {2024-02-03},
	volume = {7},
	abstract = {The article investigates the aesthetic and political power of Margaret Atwood's 1972 novel Surfacing. It argues that the novel's perennial vitality is partly explained by Jacques Ranci{\`e}re's theory about the aesthetic regime of art that highlights the tension between art for art's sake and art as a political instrument. By means of phenomenological methodology and concepts, mainly derived from Martin Heidegger and Maurice Merleau-Ponty, the examination uncovers an experiential aesthetics intimately intertwined with the protagonist's perceptions throughout the narrative. These perceptions and impressions are permeated by a sense of semi-religious revelation. But here they are primarily seen from an epistemological perspective through the dominance of immediacy (denoted by the Greek aletheia) over verificational dimensions (denoted by the Roman veritas). These predominantly sensory aspects of Surfacing make up the aesthetic nerve that is linked to the political impact of the work. Aletheia functions as a promise of emancipation since it transcends the political division of the sensory, that is, art for art's sake and art as life. But, Atwood's work also upholds this separation since aletheia is ultimately autonomous, which in turn sustains the autonomy of the novel. It is claimed that the persistent status of Surfacing---and thereby its sustained political impact---is ultimately due to its aesthetic integrity. The novel's more explicit political concerns of ecocriticism and feminism are secondary in relation to the force of aletheia.}}

