@incollection{greeneWhatThisWorld2022,
  title = {“{{What}} Is This World?”: {{Chaucer}}, {{Realism}}, and {{Metaphysics}}},
  booktitle = {Literature and Its {{Language}}: {{Philosophical Aspects}}},
  author = {Greene, Darragh},
  editor = {Hagberg, Garry L.},
  date = {2022},
  pages = {149--171},
  publisher = {Springer International Publishing},
  location = {Cham},
  doi = {10.1007/978-3-031-12330-6_8},
  url = {https://doi.org/10.1007/978-3-031-12330-6_8},
  urldate = {2024-02-01},
  abstract = {What is Chaucer’s metaphysics? The possibilities span the debate between nominalists and realists in the fourteenth century. In this essay, three interrelated puzzles are explored: the metaphysics of beauty in The Parliament of Fowls; the nature of the rocks in The Franklin’s Tale; and the ontology of narrative in The Nun’s Priest’s Tale. These studies show that Chaucer’s appreciation of the reality of things underpins the sensate detail evident in his poetry. Throughout, Chaucer’s affinities with Wittgenstein’s thinking will be noted, including the shared insight that all projects to grasp the “incomparable essence of language” are vain.},
  isbn = {978-3-031-12330-6},
  keywords = {Broader narrative,Chaucer,Everyday detail,Metaphysics,Nominalist,Realist,UNREAD},
  timestamp = {2024-02-01T19:00:07Z}
}

@incollection{hagbergStateMindMeaning2022,
  title = {A {{State}} of {{Mind}} as the {{Meaning}} of a {{Word}}: {{J}}. {{M}}. {{Coetzee}}’s {{Disgrace}}},
  booktitle = {Literature and Its {{Language}}: {{Philosophical Aspects}}},
  author = {Hagberg, Garry L.},
  editor = {Hagberg, Garry L.},
  date = {2022},
  pages = {207--242},
  publisher = {Springer International Publishing},
  location = {Cham},
  doi = {10.1007/978-3-031-12330-6_11},
  url = {https://doi.org/10.1007/978-3-031-12330-6_11},
  urldate = {2024-02-01},
  abstract = {Coetzee’s central character David Lurie, in his novel Disgrace, can be read as a layered and instructively complex study in moral psychology in literary form. It is that—but also more. It can also be read as a study in the philosophy of language, as a study in why our words mean what they do, how they come to acquire that meaning, and what it is to understand—to deeply and richly understand—their meaning. To come to an understanding of the mind of Lurie is to come to an understanding of the lived experience, and what one might call the psychological pragmatics, that give the word “disgrace” its content. As we see in this chapter, it is thus a novel that shows how it is that we come to fathom the intricate intertwinings of a life, a mind, and what can be a life-encompassing word.},
  isbn = {978-3-031-12330-6},
  keywords = {Acquired meaning,J. M. Coetzee,Life-encompassing words,Pragmatics,Understanding,UNREAD,Word-meaning},
  timestamp = {2024-02-01T19:00:08Z}
}

@incollection{morganAposiopesisComfortsRhetoric2019,
  title = {Aposiopesis and the {{Comforts}} of {{Rhetoric}}},
  booktitle = {Turn-Taking in {{Shakespeare}}},
  author = {Morgan, Oliver},
  editor = {Morgan, Oliver},
  date = {2019-08-15},
  pages = {0},
  publisher = {Oxford University Press},
  doi = {10.1093/oso/9780198836353.003.0006},
  url = {https://doi.org/10.1093/oso/9780198836353.003.0006},
  urldate = {2024-02-01},
  abstract = {This chapter explores the relationship between turn-taking and syntax by studying Shakespeare’s use of aposiopesis in 1 Henry IV. More specifically, it questions how adequately this term describes what happens when Hotspur dies part way through a sentence at the Battle of Shrewsbury (5.4). The chapter reviews what a sixteenth-century schoolboy is likely to have understood by ‘aposiopesis’ and argues that, although the term is inadequate, its inadequacy is instructive. We can use it to develop a more precise vocabulary with which to talk about the relationship between syntax and turn-taking. Three new terms are proposed for this purpose (suspension, completion, and addition) and the chapter ends by showing how they can be used to arrive at a more nuanced reading of Hotspur’s final moments.},
  isbn = {978-0-19-883635-3},
  keywords = {aposiopesis,UNREAD},
  timestamp = {2024-02-01T20:54:24Z},
  file = {Snapshot:/Users/siainbuletin/Zotero/storage/WQQH4DSE/353223090.html:text/html}
}

@incollection{pierceConsentingEthicalAct2022,
  title = {Consenting as an {{Ethical Act}}: {{On}} the {{Meaning}} of a {{Word}}},
  booktitle = {Literature and Its {{Language}}: {{Philosophical Aspects}}},
  author = {Pierce, Robert B.},
  editor = {Hagberg, Garry L.},
  date = {2022},
  pages = {173--185},
  publisher = {Springer International Publishing},
  location = {Cham},
  doi = {10.1007/978-3-031-12330-6_9},
  url = {https://doi.org/10.1007/978-3-031-12330-6_9},
  urldate = {2024-02-01},
  abstract = {What is this creature that we call “consent”? Is it a specific decision at a moment of time, or is it some sort of mental process that leads to some overt act? What role does consent play when a couple decide to get married or to have sexual relations or indeed to fall in love? These questions matter to us today when we try to work out the ethical principles that should govern us as we live our romantic lives. Shakespeare lived in a very different time, but his insights in Romeo and Juliet can help as we try to decide what “consent” means and how it matters for our choices about how to act.},
  isbn = {978-3-031-12330-6},
  keywords = {🌟,Consent,Defining-by-showing,Ethical principles,Romantic life,Romeo and Juliet,Shakespeare,UNREAD},
  timestamp = {2024-02-02T12:32:50Z}
}

@incollection{sheffieldSocratesSpeechNature2006,
  title = {2  {{Socrates}}' {{Speech}}: {{The Nature}} of {{Erōs}}},
  booktitle = {Plato's {{Symposium}}: {{The Ethics}} of {{Desire}}},
  author = {Sheffield, Frisbee C. C.},
  editor = {Sheffield, Frisbee},
  date = {2006-07-20},
  pages = {0},
  publisher = {Oxford University Press},
  doi = {10.1093/acprof:oso/9780199286775.003.0003},
  url = {https://doi.org/10.1093/acprof:oso/9780199286775.003.0003},
  urldate = {2024-02-03},
  abstract = {This chapter begins with Socrates' account of the nature of eros. The first part of the chapter explores Socrates' account of eros as an intermediate psychological state. The desire for beautiful and good things confronts us with something beautiful and good that our mortal natures lack (an experience of aporia), and yet we awaken a more than human ability to transcend that nature and to strive towards a divine state of possession (euporia). The second part of the chapter explores Socrates' claim that we desire the good and beautiful things we lack in more detail. Socrates singles out wisdom as one of the most beautiful things, and goes on to sketch an account of how eros' nature manifests itself in the pursuit of wisdom. The chapter concludes by arguing that eros' intermediate nature, as manifested in the pursuit of wisdom in particular, is exemplified in the behaviour of Socrates and his alter ego Diotima at this symposium.},
  isbn = {978-0-19-928677-5},
  keywords = {UNREAD},
  groups = {Erotismul și Vorbirea},
  timestamp = {2024-02-03T19:41:17Z},
  file = {NQ69866.pdf:/Users/siainbuletin/Zotero/storage/FXLBYKPG/NQ69866.pdf:application/pdf;GemelliMarcianoCatafalque.pdf:/Users/siainbuletin/Zotero/storage/LYT3QYIR/GemelliMarcianoCatafalque.pdf:application/pdf;An_Ontology_Based_Approach_to_Informatio.pdf:/Users/siainbuletin/Zotero/storage/M2YCRUSM/An_Ontology_Based_Approach_to_Informatio.pdf:application/pdf;Snapshot:/Users/siainbuletin/Zotero/storage/GZ5MSUYT/147237953.html:text/html}
}

