@incollection{basslerLacanFreudianSubject2022,
  title = {Lacan’s {{Freudian Subject}} in the {{Écrits}}},
  booktitle = {The {{Legitimacy}} of {{Poetic Reason}}},
  author = {Bassler, O. Bradley},
  editor = {Bassler, O. Bradley},
  date = {2022},
  pages = {47--76},
  publisher = {Springer International Publishing},
  location = {Cham},
  doi = {10.1007/978-3-031-12314-6_3},
  url = {https://doi.org/10.1007/978-3-031-12314-6_3},
  urldate = {2024-02-01},
  abstract = {In this chapter, I initiate the task of securing an account of the subject adequate to the legitimation of poetic reason. Much as I have identified Henrich’s account of constructive reason in Chap. 1as the closest precursor to poetic reason, here I identify the Lacanian subject as the most adequate antecedent to the full account of the poetic subject that must eventually be supplied. Lacan’s subject, however, remains an analytic subject (specifically, of the psycho-analytic type), and so a deduction of the poetic subject from the analytic (Lacanian) subject must be provided. This makes the status of the Lacanian subject critical for this project, and for that reason I follow it out in the requisite detail. At the heart of Lacan’s treatment of the psychoanalytic subject lie the diagrams he uses to indicate its structure, and so in this chapter I follow out Lacan’s most fundamental diagram in detail.},
  isbn = {978-3-031-12314-6},
  keywords = {Jacques Lacan,Lacanian diagrams,Psychoanalysis,Psychoanalytic Subject,UNREAD},
  timestamp = {2024-02-01T18:57:01Z}
}

@incollection{basslerLookingBackGenealogy2022,
  title = {Looking {{Back}}: {{A Genealogy}} of the {{Subject-}}(Dis)-Continuum from {{Pascal}} to {{Lacan}}},
  booktitle = {The {{Legitimacy}} of {{Poetic Reason}}},
  author = {Bassler, O. Bradley},
  editor = {Bassler, O. Bradley},
  date = {2022},
  pages = {77--107},
  publisher = {Springer International Publishing},
  location = {Cham},
  doi = {10.1007/978-3-031-12314-6_4},
  url = {https://doi.org/10.1007/978-3-031-12314-6_4},
  urldate = {2024-02-01},
  abstract = {In this chapter I initiate the transposition of the Lacanian subject to the field of poiesis, understood as the locus of creative work. Since creative work is traditionally assigned to a subject—admittedly possibly inspired from outside—it is a significant but not implausible step to suggest instead that creative work occurs in the (now, philosophically non-traditional) subject insofar and only insofar as the subject is understood as the field of creative work itself. I refer to this field of creative work as the subject-(dis)-continuum, with the parenthetical term recognizing that, as in the case of modern physical theories, the extensive field of creative work is itself likely to contain discontinuous, singular ruptures. Like a quantum field, it is a “field” incorporating aspects of both continuity and discontinuity. The structure of the subject-(dis)-continuum that Lacan identifies is anticipated in Paul de Man’s reading of Pascal, which I use to establish a genealogy of the subject-(dis)-continuum. This promotes an identification of the subject-(dis)-continuum as the subject of the drive and establishes its relation to the dynamics of desire. In this way a connection is prepared between Lacan’s psychoanalytic treatment of desire and the desire at work in poetic creation.},
  isbn = {978-3-031-12314-6},
  keywords = {Jacques Lacan,Pascal,Paul de Man,Psychoanalytic subject,UNREAD},
  timestamp = {2024-02-01T18:57:00Z}
}

@incollection{basslerPsychoanalysisStructuralism2022,
  title = {Between {{Psychoanalysis}} and {{Structuralism}}},
  booktitle = {The {{Legitimacy}} of {{Poetic Reason}}},
  author = {Bassler, O. Bradley},
  editor = {Bassler, O. Bradley},
  date = {2022},
  pages = {133--154},
  publisher = {Springer International Publishing},
  location = {Cham},
  doi = {10.1007/978-3-031-12314-6_6},
  url = {https://doi.org/10.1007/978-3-031-12314-6_6},
  urldate = {2024-02-01},
  abstract = {In this chapter I address two figures who help move us toward the legitimation of poetic reason in distinct ways. Norman O. Brown’s post- or anti-modernist Freudianism is a vigorous promotion of Gnostic tendencies that stands in the strongest opposition to Blumenberg’s legitimation of the modern age. Since, on the one hand, I use Blumenberg’s legitimation argument as a starting point for the legitimation of poetic reason, and, on the other hand, I enlist Lacan’s cultivation of the Freudian subject as a candidate for the subject to which poetic reason is ascribed, Brown’s reading of Freud poses the most extreme challenge to be met. In the second half of this chapter, I begin to develop the tools to meet this challenge. Lacan’s reception of the Freudian subject is structuralist in orientation, and in reading James Boon’s work on structuralism and symbolist poetry I begin to articulate a structuralist methodology which recognizes poetry as part of its own heritage.},
  isbn = {978-3-031-12314-6},
  keywords = {🌟,Freud,James Boon,Norman O. Brown,Structuralism,Symbolist Poetry,UNREAD},
  timestamp = {2024-02-02T12:27:32Z}
}

