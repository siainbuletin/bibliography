@article{wolenskiAletheiaGreekThought2004,
  title = {Aletheia in {{Greek}} Thought until {{Aristotle}}},
  author = {Woleński, Jan},
  date = {2004-06-01},
  journal = {s of Pure and Applied Logic},
  shortjournal = {Annals of Pure and Applied Logic},
  series = {Provinces of Logic Determined. {{Essays}} in the Memory of {{Alfred Tarski}}. {{Parts IV}}, {{V}} and {{VI}}},
  volume = {127},
  number = {1},
  pages = {339--360},
  issn = {0168-0072},
  doi = {10.1016/j.apal.2003.11.020},
  url = {https://www.sciencedirect.com/science/article/pii/S0168007203001283},
  urldate = {2024-02-03},
  abstract = {This paper investigates the concept of aletheia (truth) in ancient philosophy from the pre-Socratics until Aristotle. The meaning of aletheia in archaic Greek is taken as the starting point. It is followed by remarks about the concept of truth in the Seven Sages. The author discusses this concept as it appears in views and works of philosophers and historians. A special section is devoted to the epistemological and ontological understanding of truth. On this occasion, influential views of Heidegger are examined. The paper is concluded by a review of various meanings of truth in Aristotle.},
  keywords = {Correspondence,Epistemology,Ontology,UNREAD},
  timestamp = {2024-02-03T18:39:01Z},
  file = {ScienceDirect Full Text PDF:/Users/siainbuletin/Zotero/storage/HVA8Q785/Woleński - 2004 - Aletheia in Greek thought until Aristotle.pdf:application/pdf;ScienceDirect Snapshot:/Users/siainbuletin/Zotero/storage/TR8AV3SS/S0168007203001283.html:text/html;Aletheia in Greek thought until Aristotle | Semantic Scholar:/Users/siainbuletin/Zotero/storage/WM8NK82M/22ba7d2964ed6bb761c07a12cb320f598dec94a7.html:text/html}
}
