@incollection{arguellomanresaPoetrySocietyPoetic2017,
  title = {Poetry in and for {{Society}}: {{Poetic Messages}}, {{Creativity}}, and {{Social Change}}},
  booktitle = {Poetry {{And Imagined Worlds}}},
  author = {Argüello Manresa, Gemma and Glăveanu, Vlad},
  editor = {Lehmann, Olga V. and Chaudhary, Nandita and Bastos, Ana Cecilia and Abbey, Emily},
