@article{karamercanHeideggerAntigoneEthos2021,
  title = {Heidegger's {{Antigone}}: {{The Ethos}} of {{Poetic Existence}}},
  author = {Karamercan, Onur},
  date = {2021-01-01},
  journal = {lhikme An International Journal of Philosophy},
  shortjournal = {beytulhikme},
  volume = {11},
  pages = {1063--1077},
  issn = {1303-8303},
  doi = {10.18491/beytulhikme.1770},
  url = {http://www.beytulhikme.org/DergiTamDetay.aspx?ID=1770},
  urldate = {2024-02-02},
  abstract = {In this article, I elucidate Martin Heidegger’s interpretation of Sophocles’ tragedy Antigone from a topological point of view by focusing on the placecharacter of Antigone’s poetic ethos. Antigone’s decision to defy Creon’s order and bury her brother Polynices is discussed as a movement that underpins her poetic disposition as a demigod. Antigone’s situatedness between gods and humans is identified as the place of poetic dwelling, and the significance of Antigone’s relation to the polis is explained. The main argument of the article is twofold: 1) When we read Antigone focusing on the notion of dwelling, we can better make sense how Heidegger’s engagement with the question of finitude closes the envisioned gap between ontology and ethics. 2) The idea of poetic dwelling is a confrontation with spatio-temporal limits of human existence, and requires a more holistic way of thinking about the place of humans in the world, thinking beyond being-action dichotomy.},
  issue = {11:3},
  keywords = {UNREAD},
  timestamp = {2024-02-02T15:50:48Z},
  file = {Karamercan - 2021 - Heidegger's Antigone The Ethos of Poetic Existence.pdf:/Users/siainbuletin/Zotero/storage/3UJFDK7Y/Karamercan - 2021 - Heidegger's Antigone The Ethos of Poetic Existence.pdf:application/pdf}
}

