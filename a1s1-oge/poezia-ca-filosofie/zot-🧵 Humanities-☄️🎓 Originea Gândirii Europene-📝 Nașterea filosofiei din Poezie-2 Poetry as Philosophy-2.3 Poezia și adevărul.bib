@article{freemanCultureNarrativePoetic1999,
  title = {Culture, {{Narrative}}, and the {{Poetic Construction}} of {{Selfhood}}},
  author = {Freeman, Mark},
  date = {1999-03-01},
  journal = {al of Constructivist Psychology},
  volume = {12},
  number = {2},
  pages = {99--116},
  publisher = {Routledge},
  issn = {1072-0537},
  doi = {10.1080/107205399266136},
  url = {https://doi.org/10.1080/107205399266136},
  urldate = {2024-02-03},
  abstract = {Recent explorations of the relationship between narrative and self, particularly those tied to social constructionism, have served as a valuable corrective to the still prevalent tendency in psychology to divorce the self from its social surround. Yet certain of these explorations, by privileging the social over the individual, have led to a vision of selfhood that is problematic in its own right. Specifically, it is argued that, even though the "tools" employed in the construction of selfhood are social in nature, the configurational acts through which this construction occurs are better conceived in poetic terms, as imaginative labor seeking to give form and meaning to experience. In considering the poetic construction of selfhood, this article attempts to articulate further the relationship between narrative and self, the cultural dimension of personal experience, and the importance of the idea of narrative for expanding the scope of psychological knowledge.},
  keywords = {UNREAD},
  timestamp = {2024-02-03T19:43:07Z}
}

