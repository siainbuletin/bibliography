	file = {Kumar Singh and Mishra - 2012 - Sense & Meaning A Second Order Analysis of Language.pdf:/Users/siainbuletin/Zotero/storage/UYLH99MI/Kumar Singh and Mishra - 2012 - Sense & Meaning A Second Order Analysis of Language.pdf:application/pdf},
