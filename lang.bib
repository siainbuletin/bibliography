@unpublished{witten2008dogwhistle,
	author = {Witten, Kimberly},
	date-added = {2025-06-02 11:40:08 +0300},
	date-modified = {2025-06-02 11:40:53 +0300},
	note = {Originally written and submitted for the Spring 2008 semester at San Francisco State University Courses: Narrative & Discourse Analysis, Professor & Advisor: Dr. Troi Carleton},
	title = {Dogwhistle Politics: the New Pitch of an Old Narrative},
	year = {2008},
	abstract = {In recent years, linguistic study in political discourse has been focused on metaphor structure and framing
(Lakoff, 1980, 2004; Nunberg, 2006). Application of these established linguistic theories to new, emerging
discursive strategies help us understand the ways that the landscape of political communication is evolving.
This work examines one new feature of discourse -- a complex type of coded speech found in lexical, phrasal or
thematic form. A dogwhistle is a speech act designed, with intent, to allow two plausible interpretations, with one
interpretation being a private, coded message targeted for a subset of the general audience, and concealed in such
a way that this general audience is unaware of the existence of the second, coded interpretation. It is a metaphor
modeled after the function of a literal dog whistle, which emits a noise at a pitch that only dogs can hear. While
the term `dogwhistle' has been established previously through common use, there is no dictionary definition for
this metaphorical understanding at this time. Dogwhistle politics --- the act of sending these types of messages for
political gains --- has been studied only briefly from a sociological perspective in recent years (Fear, 2007).
In this paper, several linguistic features of dogwhistles are outlined, addressing how these speech acts relate to
audience design (Bell, 1984), relevance (Grice, 1975), narrative coherence (Duranti, 2006), next turn proof (Hutchby
& Wooffitt, 1998), and other key aspects. This also demonstrates the crucial differences between dogwhistles and
similar tropes such as inside jokes, innuendos (Bell, 1997), and puns.
Examples of data found in political discourse show how this form of coded speech constructs two,
sometimes-contradictory narratives that can affect a politician's credibility. Both successful and failed dogwhistles
are examined in terms of their function and structure, as well as their impact on their audience and speaker's
narrative. For example, one piece of data examined here is a lexical form of a successfully delivered dogwhistle -- a
politician's use of the word ``uppity'' is shown to address different groups of constituents (audiences) and index the
speaker's stance on a new topic. This contributed to a cohesive, but divisive and negative narrative for the speaker,
regardless of the many available interpretations for selection by audience members. Other data show that alternative
speaker effects are possible, such as damage to credibility, perceived linguistic incompetence or mastery, and intent
to unify or divide audiences.
We must continue to add to our understanding of available discursive strategies and expand our theories to
account for them. Analysis of the role a dogwhistle plays in establishing narrative coherence is crucial to advancing
current conceptions of how we use tropes to communicate ideas to others and index solidarity, distance, and power.},
	bdsk-file-1 = {}}

