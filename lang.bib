@book{travis2021frege:-the,
	author = {Travis, Charles},
	doi = {10.1093/oso/9780198844129.001.0001},
	edition = {1},
	file = {Travis - 2021 - Frege The Pure Business of Being True.pdf:/Users/siainbuletin/Zotero/storage/RL7DSBPF/Travis - 2021 - Frege The Pure Business of Being True.pdf:application/pdf},
	isbn = {978-0-19-884412-9 978-0-19-187975-3},
	publisher = {Oxford University Press},
	title = {Frege: {{The Pure Business}} of {{Being True}}},
	url = {https://academic.oup.com/book/42108},
	year = {2021-06-10},
	abstract = {This book is about Frege and his contribution to philosophy. It has three parts. Part I presents his general picture of thought, that is, the               object               of a capacity for thought (what may be thought). The point is to stress the value of separating the business of               being               true from thinkers' engagement with such business, thus from issues specifically about language, and this as a model for philosophy in general. It also expands on Frege's case for the intrinsic publicity (sharability) of thought. Part II concerns some particular developments of the general view made by Frege with a view to serving the needs of his central project (after logic itself): showing arithmetic to be logic. Part III applies the general picture in presenting a view of truth (and its irreducibility), logic of logic's independence both of thinkers and of the world (its indifference to anything in how things happen to be), and of objectivity.}}

