	url = {https://www.jstor.org/stable/26485488},
	volume = {79},
	year = {2012},
	abstract = {Ockham's interest in logic is indubitable. His interest in metaphysics, as opposed to individual metaphysical issues, is less obvious. This paper seeks to compare and contrast Ockham's view of metaphysics and logic as scientiae on a number of points with the aim of calling attention to what is distinctive about the reach and content of metaphysical research. Whereas the logician studies terms, propositions, and syllogisms, the metaphysician sets out and defends a general ontology. Of particular note are two areas where metaphysics and logic overlap, namely the categories and the concept.}}

