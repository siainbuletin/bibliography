@article{currie1984freges-met,
	author = {Currie, Gregory},
	date-modified = {2025-03-02 09:52:30 +0100},
	doi = {10.2307/2218764},
	issn = {00318094},
	journal = {The Philosophical Quarterly},
	number = {136},
