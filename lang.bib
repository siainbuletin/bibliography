@article{rovelli2020neither-pr,
  author       = {Rovelli, Carlo},
  month	       = {02},
  title	       = {Neither Presentism nor Eternalism},
  year	       = {2020},
  abstract     = {Is reality three-dimensional and becoming real
                  (Presentism), or is reality four-dimensional and be-
                  coming illusory (Eternalism)? Both options raise
                  difficulties. I argue that we do not need to be
                  trapped by this dilemma. There is a third
                  possibility: reality has a more complex temporal
                  structure than either of these two naive options.
                  Fundamental becoming is real, but local and
                  unoriented. A notion of present is well defined, but
                  only locally and in the context of approximations.},
}

