	doi = {10.1007/978-3-030-77550-6_2},
	editor = {Moser, Aloisia},
	isbn = {978-3-030-77550-6},
	keywords = {Acts of the mind,Judgment,Performativity,Synthesis,Transcendental apperception,Transcendental deduction,,Vorstellung},
	pages = {21--38},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {A {{Connection Between Thought}} and {{Thing A Priori}}},
	url = {https://doi.org/10.1007/978-3-030-77550-6_2},
	year = {2021},
	abstract = {In this chapter, I show how the necessary link between thought and what it is about is made in the A-edition of the Transcendental Deduction of Kant's Critique of Pure Reason. I make a distinction between the synthesis of judgment made in general logic and in transcendental logic, and I argue that the transcendental apperception does not give us an a priori connection, in the sense of self-reflexivity, but a performative one, in the sense of a thought being thought. The concept of Vorstellung is elaborated as an act of the mind in which the manifold of intuition is re-presented before our mind. However, prior to this judgment in a concept that which comes in through the senses needs a transcendental judgment allowing the manifold of sense perception to share something with the concept.}}

@incollection{moser2021the-form-o,
	author = {Moser, Aloisia},
	booktitle = {Kant, {{Wittgenstein}}, and the {{Performativity}} of {{Thought}}},
	date-modified = {2025-03-02 09:52:30 +0100},
	doi = {10.1007/978-3-030-77550-6_5},
	editor = {Moser, Aloisia},
	isbn = {978-3-030-77550-6},
	keywords = {Elucidation,Fact,General form of the proposition,Mathematical equations,Projection,Tautology,,Variable},
	pages = {63--74},
	place = {Cham},
	publisher = {Springer International Publishing},
	title = {The {{Form}} of the {{Proposition}}},
	url = {https://doi.org/10.1007/978-3-030-77550-6_5},
	year = {2021},
	abstract = {This chapter introduces the world of the Tractatus as one in which a general propositional form is able to project the world. I show that the propositions of the Tractatus are set up like mathematical equations: what is on the left side equals what is on the right side. The sub-propositions serve to elucidate the right side of the equation in a new equation. The chapter describes two perspectives on the proposition in the Tractatus. The first perspective views the proposition as a variable of a general form that represents a fact. The second perspective considers the proposition to be an elucidation. However, in order for the proposition to be a fact, it must be projected onto the world. Philosophical or mathematical propositions are tautologies; they are true or false without needing to be projected.}}

