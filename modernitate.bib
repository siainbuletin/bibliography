@article{downie2001science-an,
	author = {Downie, Robin},
	date-added = {2024-12-28 21:35:23 +0200},
	date-modified = {2024-12-28 21:35:23 +0200},
	doi = {10.1136/mh.27.2.58},
	eprint = {https://mh.bmj.com/content/27/2/58.full.pdf},
	issn = {1468-215X},
	journal = {Medical Humanities},
	number = {2},
	pages = {58--63},
	publisher = {Institute of Medical Ethics},
	title = {Science and the imagination in the age of reason},
	url = {https://mh.bmj.com/content/27/2/58},
	volume = {27},
	year = {2001},
	abstract = {The eighteenth century is commonly thought of as the {
              \textquotedblleft}age of reason{\textquotedblright}, an age in
              which the imagination was not given a central role in the arts, far
              less in science. But in Hume{\textquoteright}s attempts to account
              for our belief in a continuing external world he is forced into
              invoking the activity of the imagination. His views on the activity
              of the imagination greatly influenced Adam Smith, who adapted them
              to fashion a theory of the psychology of scientific discovery. In
              this theory the imagination is shown to be active in creating
              systematic explanations of the phenomena of nature, to the extent
              that Smith depicts the aim of scientific theory as that of
              satisfying the imagination. Smith{\textquoteright}s account of the
              logic of scientific theory can be defended even in contemporary
              philosophy of science. In particular, it can be maintained that all
              scientific theories are works of the imagination and that the
              concept of truth does not directly apply to them.},
	bdsk-file-1 = {}}

@book{nikulin2002matter-ima,
