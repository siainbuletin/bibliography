	shorttitle = {The Creation of the World},
	timestamp = {2023-12-20T14:38:36Z},
	title = {The Creation of the World: Philosophy between Art and Science},
	url = {https://www.cairn-int.info/article-E_RMM_084_0517--the-creation-of-the-world-philosophy.htm},
	volume = {60},
	year = {2008},
	abstract = {Contemporary philosophy is pulled between the two apparently
              irreconcilable poles of literature and the hard sciences.
              Nevertheless, a possibility of reconciliation and of fusion is
              conceivable by returning to Descartes who, in his treatise The
              World, saw no discontinuity between philosophy and science and who
              uses fable and fiction to set out a universal scientific truth.
              This truth is expounded by means (experimental derealization of the
              world, geometrization of space, the power of a mind that is
              expressed by an \&\#8220;I\&\#8221;, analogy permitting an account
              of humanity) which are also those employed by modern artists such
              as Marcel Proust and Stanley Kubrick. By comparing Descartes\&\#
              8217; The World with Proust\&\#8217;s In Search of Lost Time and
              with Kubrick\&\#8217;s and Clarke\&\#8217;s 2001: A Space Odyssey,
              it is possible to show the fraternal bonds of these works, despite
              the different times in which they were written and the difference
              in their styles and their aims, and to highlight the unity of their
              claim to truth, whether it be scientific, artistic, or
              philosophical. The differences between these disciplines coalesce
              in these works, which always have as their ultimate aim the
              remaking of the real in the image of human understanding, in order
              to better explain it.},
	bdsk-file-1 = {}}

