@inbook{garber2009complete-i,
	chapter = {5},
	crossref = {garber2009leibniz:-b},
	date-added = {2025-03-15 13:23:18 +0200},
	date-modified = {2025-03-15 13:24:29 +0200},
	keywords = {Leibniz, Predicate-in-Notion principle, substance, causality, interaction, Complete Individual Concept, occassionalism},
	pages = {181-224},
	title = {Complete Individual Concepts, Non-Communication, and Causal Connection},
	abstract = {This chapter explores the notion of a Complete Individual Concept
              and Leibniz's celebrated Predicate-in-Notion principle, they
              feature in the `Discours de m{\'e}taphysique', a text drafted with
              some care in the mid-1680s. In that text, and others that start
              from this conception of substance, Leibniz draws out many of the
              same kinds of consequences that he drew from the other approaches
              to substance that we have already seen. But this conception of
              substance is especially useful for leading us to certain insights
              about activity and causality in the world of created substances. In
              particular, they lead Leibniz to the somewhat surprising view that
              there is no genuine interaction among substances. The chapter ends
              with an extended discussion of the difficult doctrine of causality
              in terms of distinct and confused expression that is closely linked
              to that view.}}

