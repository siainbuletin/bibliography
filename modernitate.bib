@article{pozdniakovepistemolo,
	author = {Pozdniakov, Mikhail},
	date-added = {2024-12-28 21:35:23 +0200},
	date-modified = {2024-12-28 21:35:23 +0200},
	timestamp = {2024-03-16T11:20:59Z},
	title = {Epistemology of the {{Cartesian Image}}},
	abstract = {This study is an examination of the epistemological history of the
              image. Its first strands are to be found in the Christian concept
              of profanity, in the difference of the world to the divine. The
              highest form of intelligibility profanity could have, second only
              to theology, was mathematics. Derived from the problems surrounding
              this concept are the techniques of inquiry that eventually resulted
              in the development of analytic geometry by Descartes. The latter
              marked a new sensibility regarding the physical universe and its
              constitution, one that is coterminous with the development of exact
              procedures in science. Being that exactitude regards the
              specificity of observed material as paramount, one of the results
              of the above series of processes was method of reasoning that
              allowed earthly ephemera, mental and material, to be recorded. The
              image is but one product of this history.},
	bdsk-file-1 = {}}

@inproceedings{mansbachheideggers,
	author = {Mansbach, Abraham},
	date-added = {2024-12-28 21:35:23 +0200},
	date-modified = {2024-12-28 21:35:23 +0200},
	eventtitle = {Twentieth {{World Congress}} of {{Philosophy}}},
	location = {Boston, MA},
	timestamp = {2023-12-18T10:49:42Z},
	title = {Heidegger's Critique of {{Cartesianism}}},
	url = {https://www.bu.edu/wcp/Papers/Cont/ContMans.htm},
	year = {1998-08-10/1998-08-15},
	abstract = {Heidegger is one of the few Western thinkers to have succeeded in
              going beyond the Western philosophic tradition. Because his radical
              criticism is believed to have fractured the foundations of modern
              philosophy, his thinking is usually at the center of the
              controversy between the defenders of the tradition and those who
              wish to break with it and start afresh. In the heat of this debate,
              the question of Heidegger's place in relation to that tradition in
              general and to Cartesianism in particular has been neglected. I
              wish to address the question by focusing on the major aspects of
              Heidegger's critique of Cartesian philosophy and the modern
              tradition. I will first show that the strength of his criticism
              lies in its all-encompassing penetration of the foundations of
              modern philosophy, running through both the ontological and
              epistemological channels. Ontologically, Heidegger presents a
              critique of subjectivism; epistemologically, he discredits the
              correspondence conception of truth and its underlying visual
              metaphor. I will then look at his view of history and the meaning
              of his concept of \enquote{overcoming} in order to show that his
              aim is not to destroy the tradition, but to provide a wider basis
              for it by rescuing forgotten elements imbedded in the tradition
              itself. Finally, I will show that in this process of \enquote{
              overcoming,} Heidegger did not really depart from the tradition,
              but absorbed some of its basic tenets, as his concept of death
              echoes major elements of Cartesian doubt.}}

@thesis{androne-nakanishiideea-comp,
	author = {Androne-Nakanishi, Sebastian Andrei},
	creationyear = {2023-12-18T00:00:00},
	date-added = {2024-12-28 21:35:23 +0200},
	date-modified = {2024-12-28 21:35:23 +0200},
	institution = {UNMB},
	keywords = {composition, creative development, creativity, idea formation, composition,creative development,creativity,idea formation},
	location = {Bucure\c sti},
	note = {\section{Reading Passages} \par \emph{date: [[2022-08-31 P]]} \par \enquote{ca informa\textcommabelow tie a menirii, a sensului acelei muzici, atribuit de c\u atre compozitor, interpret \textcommabelow si/sau public, stau la baza subsolului ontologic al fenomenului muzical.} (Androne-Nakanishi, p. 62) \par \begin{itemize} \item Aici putem discuta despre teoria intentionalista/anti-intentionalista? Roland Barthes? Lucrarea ca sa aiba sens trebuie sa aiba o finalitate? Dar ce rol a avut intentia in acest caz? \end{itemize} \par \enquote{ grani\textcommabelow te ontologice,} (Androne-Nakanishi, p. 62) - Sebi nu sustine ideea ontologiei unei idei \par Montajul, asemeni muzicii in acest caz, poate sa transforme complet sensul unei povestii. Insa Sebi sustine ca referentul este pastrat. \par Informatia continuta intr-un cadru de cinema nu este destula pentru mine, ar fi mult mai utila daca o poti combina cu alte idei. Informatiile se contamineaza una pe alta, cam acesta inseamna \emph{efectul Kuleshov}, nu-i asa? \par \begin{ itemize} \item de unde a luat sebi ideea ca informatia se transmite natural prin combinarea imaginilor? Well, if you were to listen to Sergei Eisenstein (Eisenstein, Sergei), art is the clash between nature and what the human can do when creating information \item montajul se poate simti natural, invizibil, analitic\dots? sau poate fi mai fortat, dar in cele din urma, trebuie sa stea in picioare \end{itemize} \par Transferul informational care se poate face prin film trebuie sa treaca si prin partea de decontaminare ca sa ramana valida \par Mise-en-scene poate sa reprezinte si mediul prin care se transmite informatia, ideea. Deci aceasta este foarte importanta in contextualizarea imaginilor. Dar era asa si in cazul lui claire denis?(Madin, 2012) \par Subiectivitatea si stilul, in general, pe care il are un artist, reprezinta si interactiunea dintre mediul lui interior si dintre idei, care sufera contagiune de la un capat la altul. \par Privitorul poate fi si el un mecanism de transfer informational. \par Este imposibil sa transmiti exact experienta pe care o ai odata, asa ca trebuie sa accepti ca montajul va fi o a doua regie, un alt mod de a transmite informatie.},
	shorttitle = {Ideea componistic\u a},
	title = {Ideea componistic{\u a}. Mecanisme de transfer informațional {\^\i}n muzica modern{\u a} si \^in propria crea\textcommabelow tie},
	year = {2017},
	bdsk-file-1 = {}}

