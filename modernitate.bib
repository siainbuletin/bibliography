@article{tratnik2015conception,
  author       = {Tratnik, Sebastian Korenic},
  journal      = {Estetyka i Krytyka},
  keywords     = {Slavoj {\v Z}i{\v z}ek, structuralism,
                  psychoanalysis, dialectical materialism, Stalinism,
