  date = {2002-07},
  journal = {Journal of Research in Music Education},
  shortjournal = {Journal of Research in Music Education},
  volume = {50},
  number = {2},
  pages = {94--110},
  issn = {0022-4294, 1945-0095},
  doi = {10.2307/3345815},
  url = {http://journals.sagepub.com/doi/10.2307/3345815},
  urldate = {2024-01-28},
  abstract = {The purpose of the study was to investigate the compositional processes of adolescents to clarify effective strategies for implementing composition activities in high school music programs. The study charted the progress of four high school music students as they completed two separate composition tasks. Data collection techniques consisted of semi-structured interviews, observation, and document analysis. Analysis consisted of studying the field note and interview texts, making marginal notes, sorting, and coding. A model was constructed that reflected the common processes of composition used by the four student participants. Important features of the model are the role played by listening, the necessity of individual thinking time, and the improvisatory character of the final products. Findings from the study suggest that although there may be common elements in student compositional processes, the nature of the compositional process is idiosyncratic.},

  timestamp = {2024-01-28T19:26:41Z}
}

@article{kladderMusicTeachersPerceptions2019,
  title = {Music {{Teachers Perceptions}} of {{Creativity}}: {{A Preliminary Investigation}}},
  shorttitle = {Music {{Teachers Perceptions}} of {{Creativity}}},
  author = {Kladder, Jonathan and Lee, William},
  date = {2019-10-02},
  journal = {Creativity Research Journal},
  shortjournal = {Creativity Research Journal},
  volume = {31},
  number = {4},
  pages = {395--407},
  issn = {1040-0419, 1532-6934},
  doi = {10.1080/10400419.2019.1651189},
  url = {https://www.tandfonline.com/doi/full/10.1080/10400419.2019.1651189},
  urldate = {2024-01-28},
  abstract = {Music teachers embrace perceptions of creativity across a diversity of music teaching and learning contexts. A review of literature revealed limited research has investigated these perceptions. The purpose of this preliminary investigation was to examine music teacher’s perceptions of creativity, including how it is defined, supported in the classroom, and how creative students are perceived. A researcher-developed questionnaire was built from similar investigations across different domains. The questionnaire was distributed electronically to a sample of music teachers in the southeastern region of the United States (n = 164). Respondents defined creativity as a novel or new idea resulting in a formalized product and believed that creative students are risker-takers, persistent, and often think outside the box. The classroom environment was perceived as important to the creative processes and providing space for collaboration enhanced creative thinking. Implications for the field of music education and further research are discussed in conclusion.},

  timestamp = {2024-01-28T19:24:38Z}
}

@article{leblerStudentasmasterReflectionsLearning2007,
  title = {Student-as-Master? {{Reflections}} on a Learning Innovation in Popular Music Pedagogy},
  shorttitle = {Student-as-Master?},
  author = {Lebler, Don},
  date = {2007-12},
  journal = {International Journal of Music Education},
  shortjournal = {International Journal of Music Education},
  volume = {25},
  number = {3},
  pages = {205--221},
  issn = {0255-7614, 1744-795X},
  doi = {10.1177/0255761407083575},
  url = {http://journals.sagepub.com/doi/10.1177/0255761407083575},
  urldate = {2024-01-28},
  abstract = {If the modern conservatorium is to prosper in a rapidly changing cultural and economic landscape, it will need to provide a learning experience that produces multi-skilled and adaptable graduates who are self-monitoring and self-directing. By implication, teaching practices that have dominated in the past will need to be re-thought, and alternatives considered that are likely to produce graduates with the abilities and attributes necessary to adapt readily to a changing environment. As a response to this imperative, one conservatorium has developed a pedagogical approach based on the creation of a scaffolded self-directed learning community, a master-less studio. It is embedded in a popular music programme that explicitly values the development of learning characteristics that will help graduates deal with an unpredictable future. Student feedback on the impact of these practices has been gathered during the evolution of this process. It includes survey data, formal and informal student feedback, and a number of interviews in which students describe how aspects of this learning-centred approach have interacted with their music-making and their career expectations. From this feedback, it is evident that greater student autonomy and self-efficacy result from the a-synchronous reflection on performance that is enabled through recording, the self-reflection that is required by self-assessing, and the reflections on the work of others that peer-based assessment demands.           , Apprenti-enseignant? Réflexions sur une innovation d'enseignement dans la pédagogie de la musique populaire Si le conservatoire moderne veut prospérer dans un paysage culturel et économique changeant rapidement, il va devoir fournir une expérience d'apprentissage qui produit des diplômés à compétences multiples et adaptables qui s'auto-évaluent et s'auto-gèrent. Ceci implique que les pratiques d'enseignement qui ont dominé par le passé vont devoir être repensées et il va falloir considérer des alternatives qui produiront probablement des diplômés avec les capacités et les attributs nécessaires pour s'adapter promptement à un environnement changeant. En réponse à cet impératif, un conservatoire a développé une approche pédagogique basée sur la création risquée d'une communauté d'apprentissage auto-gérée: un studio sans maître. Elle est ancrée dans un programme de musique populaire qui valorise explicitement le développement de caractéristiques d'apprentissage qui aideront les diplômés à gérer un futur imprévisible. Le feedback des étudiants sur l'impact de ces pratiques a été recueilli durant l'évolution de ce processus. Il inclut les données de l'enquête, du feedback formel et informel des étudiants et un nombre d'entretiens dans lesquels les étudiants décrivent comment certains aspects de cette approche, centrée sur l'apprentissage, ont interagi avec la réalisation de leur musique et leurs attentes professionnelles. Depuis ce feedback, il est évident que la plus grande autonomie des étudiants et que l'auto-efficacité résultent de la réflexion a-synchronisée de la performance qui est possible à travers l'enregistrement, l'auto-réflexion qui est requise par l'auto-critique et la réflexion sur le travail des autres qui est requise par la critique entre paires.           , Der Student als Lehrer? Reflektionen über Erneuerungen des Lernens in der pädagogik der Popularmusik Will ein heutiges Konservatorium erfolgreich sein, und dies in einem schnell wechselnden kulturellen und ökonomischen Umfeld, müssen Möglichkeiten geschaffen werden, um Lernerfahrungen zu sammeln, die es Absolventen ermöglichen, vielseitige Fertigkeiten zu entwickeln und anpassungsfähig zu werden, dies im Selbststudium und in Selbstbeobachtung. Daraus folgt, dass die Unterrichtspraktiken in der Vergangenheit vorgeherrscht haben überdenkt werden müssen und Alternativen in Betracht gezogen werden sollten, die geeignet sind, Absolventen mit dem Wissen und den Fähigkeiten auszustatten, die ihnen ermöglichen sich jederzeit an die wechselnden Umweltbedingungen anzupassen. Als Antwort auf diese Herausforderung hat ein Konservatorium einen pädagogischen Versuch entwickelt, basierend auf der Schaffung einer aufbauenden, sich selbst führenden Lerngemeinschaft, einem lehrerlosen Studio. Eingebettet in ein popularmusikalisches Programm, wird ein klares Schwergewicht auf die Entwicklung des Erwerbens von Eigenschaften gelegt, die Absolventen helfen sollen, sich der nicht voraussehbaren Zukunft stellen zu können. Rückmeldungen der Studierenden wurden während des Versuchs zu diesem neuen Entwicklungsprozess gesammelt. Sie beinhalten Kontrolldaten, formelle und informelle Studentenrückmeldungen und eine Anzahl Interviews in welchen Studierende beschreiben, wie diese Aspekte des lernzentrierten Zugangs sich auf ihr Musizieren und ihre Berufserwartungen ausgewirkt haben. Diese Feedbacks zeigen auf, dass durch eine a-synchrone Betrachtung der Auftritte, welche durch Aufnahmen, durch Selbstbetrachtungwelche eine Selbsteinschätzung verlangt-und durch das Anschauen und Bewerten Anderer, die Studierenden eine grössere Autonomie und Selbsteinschätzung erlangen.           , El estudiante como maestro? Reflexiones sobre una innovación educativa en la pedagogía de la música popular Si el conservatorio moderno quiere prosperar en un paisaje cultural y económico en rápido cambio, necesitará proporcionar experiencias de aprendizaje que produzcan graduados adaptables y con múltiples destrezas, capaces de supervisarse y dirigirse a sí mismos. En consecuencia, las prácticas docentes del pasado deberán ser repensadas, y deberán considerarse alternativas que desarrollen en los graduados las habilidades y los atributos necesarios para adaptarse a ese entorno cambiante. Como respuesta a dicho imperativo, un conservatorio desarrolló un enfoque pedagógico basado en la creación de una comunidad de aprendizaje auto-dirigida, con un andamiaje pero sin maestro. El enfoque surge en un programa de música popular que explícitamente valora el desarrollo de características de aprendizaje que ayuden a los graduados a hacer frente a un futuro impredecible. Las reacciones de los alumnos hacia el impacto de esas prácticas fueron recolectadas durante el proceso. Se incluyeron datos de cuestionarios, comentarios formales e informales de los alumnos, y una cantidad de entrevistas en las que los estudiantes describen cómo aspectos de ese enfoque centrado en el aprendizaje interactuaron con sus expectativas musicales y profesionales. En esos comentarios resulta evidente que la reflexión as íncrona sobre la interpretación posibilitada por las grabaciones, la autorreflexión requerida por la autoevaluación, y las reflexiones sobre el trabajo de los demás requeridas por la evaluación entre pares, llevan a una mayor autonomía y auto-eficacia.},

  timestamp = {2024-01-28T19:39:26Z},
  file = {Full Text:BVCIWQ64/Lebler - 2007 - Student-as-master Reflections on a learning innovation in popular music pedagogy.pdf:application/pdf}
}

