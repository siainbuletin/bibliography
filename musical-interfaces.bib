  url = {https://www.ingentaconnect.com/content/intellect/jmte/2021/00000013/f0020002/art00011},
  urldate = {2024-01-28},
  abstract = {This article discusses a proposed design and sound tool teaching and learning approach, with interesting solution-based challenges not immediately associated with traditional DAW instruction. By stepping outside of the usual boundaries of DAW use, music production teaching is presented with a number of novel learning challenges. There is potential for DAWs, especially in educational settings, to be used to enhance the discipline, encourage experimentation and stimulate design-based ideas that promote DAW use beyond the mixing and engineering type contexts. By shifting DAWs into areas of sound-based music, as proposed by Landy, this innovative approach, facilitates deeper, experiential learning where sound is treated as the basic musical unit, therefore allowing for a potentially greater range of designed outputs.},
  issue = {2-3},

