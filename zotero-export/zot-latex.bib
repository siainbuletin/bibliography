@article{engelenHowIncludeSVG,
  title = {How to Include an {{SVG}} Image in {{LaTeX}}},
  author = {Engelen, Johan B C},
  abstract = {How to make a LATEX document with vector images, where the text in the images has exactly the same font and size as in normal text? This article describes how this is done using the ‘PDF/EPS/PS + LaTeX’ output feature of Inkscape 0.48. Inkscape can export the graphics to PDF/EPS/PS, and the text to a LATEX file. When the LATEX file is input in the LATEX document, the PDF/EPS/PS image is included with overlaid text. Because typesetting of the text is done by LATEX, LATEX commands can be used in images, such as writing equations, references and shorthand macros.},
  keywords = {UNREAD},
  timestamp = {2024-03-10T19:20:51Z},
  file = {Engelen - How to include an SVG image in LaTeX.pdf:/Users/siainbuletin/Zotero/storage/W63HHGVP/Engelen - How to include an SVG image in LaTeX.pdf:application/pdf}
}

