  author = {Gorodeisky, Keren},
  date = {2017-01-02},
  journal = {Australasian Philosophical Review},
  shortjournal = {Australasian Philosophical Review},
  volume = {1},
  number = {1},
  pages = {79--84},
  issn = {2474-0500, 2474-0519},
  doi = {10.1080/24740500.2017.1296373},
  url = {https://www.tandfonline.com/doi/full/10.1080/24740500.2017.1296373},
  urldate = {2024-03-16},
  abstract = {While I welcome Mohan Matthen’s insistence that art is connected to aesthetic pleasure, I worry about his commitment to viewing pleasure as prior to, and constitutive of, the value of art. I raise my reservations by (i) dispelling his criticism of the reversed explanatory direction, and (ii) showing problems for his commitment. As an alternative, I offer an account of pleasure that explains it in terms of the independent value of art—an account that is free of the problems Matthen raises against this explanatory approach.},
  timestamp = {2024-03-16T13:27:51Z},
  file = {Gorodeisky - 2017 - Value First Comments on Mohan Matthen's ‘The Plea.pdf:/Users/siainbuletin/Zotero/storage/LVIWMVCA/Gorodeisky - 2017 - Value First Comments on Mohan Matthen's ‘The Plea.pdf:application/pdf}
}

