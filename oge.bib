@incollection{marxWorldAnotherBeginning1971,
  title = {The {{World}} in {{Another Beginning}}: {{Poetic Dwelling}} and the {{Role}} of the {{Poet}}},
  booktitle = {Reason and {{World}}: {{Between Tradition}} and {{Another Beginning}}},
  author = {Marx, Werner},
  editor = {Marx, Werner},
  date = {1971},
  pages = {97--111},
  publisher = {Springer Netherlands},
  place = {Dordrecht},
  doi = {10.1007/978-94-010-2994-0_6},
  url = {https://doi.org/10.1007/978-94-010-2994-0_6},
  urldate = {2024-02-03},
  abstract = {The concern of all of Heidegger’s later works is the preparation of the possibility of another beginning of creative human Being — “another” beginning as compared to the one which was brought about by the poetic philosophizing of the Presocratics. The necessity of such a new beginning follows for Heidegger from his insight into the “highest danger,” which lies in the essence ruling in technology. This ruling essence threatens to bring about a state of affairs in which man merely labors to produce “materials”* in a totally uncreative way and conceives of himself as nothing but material. The arrival of “another” beginning would be, in Hölderlin’s words, the arrival of “das Rettende” — that which would bring about a saving. “Das Rettende” would consist in creative dwelling which, again in Hölderlin’s words, would be a “poetic” dwelling: man would “… dwell poetically on this earth.”},
  isbn = {978-94-010-2994-0},
  language = {en},
  keywords = {Basic Trait,Essence Ruling,High Danger,Human Speaking,Indirect Communication,UNREAD},
  groups = {2.3: Poezia și adevărul},
}

@article{maslovGenealogyMusesInternal2016,
  title = {The {{Genealogy}} of the {{Muses}}: {{An Internal Reconstruction}} of {{Archaic Greek Metapoetics}}},
  author = {Maslov, Boris},
  date = {2016},
  journal = {The American Journal of Philology},
  volume = {137},
  number = {3},
  eprint = {26360881},
  eprinttype = {jstor},
  pages = {411--446},
  publisher = {The Johns Hopkins University Press},
  issn = {0002-9475},
  url = {https://www.jstor.org/stable/26360881},
  urldate = {2024-02-04},
  abstract = {This article puts forward a novel approach to the history of poetic forms in Archaic Greece. By investigating the evolution of the "diegetic frames" involving the figure of the Muse(s), it seeks to trace mutual influences between different genres (Homeric epic, catalogue poetry, the Homeric Hymns, early choral lyric) and, in the case of the Iliad and Hesiod's Theogony, to identify distinct strata in the composition of one text. This genealogical analysis of the invocation of the Muses demonstrates that choral lyric had a significant impact on the evolving forms of hexameter poetry.},
  keywords = {UNREAD},
  groups = {2.3: Poezia și adevărul},
}

