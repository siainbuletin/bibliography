	title = {A Way out of the {{Euthyphro}} Dilemma},
	url = {https://www.cambridge.org/core/product/identifier/S0034412510000752/type/journal_article},
	urldate = {2024-01-29},
	volume = {48},
	abstract = {I defend the view that morality depends on God against the Euthyphro dilemma by arguing that the reasons that God has for determining the moral--natural dependencies might be personal reasons that have non-moral content. I deflect the ` arbitrary whim' worry, but I concede that the account cannot extend to the goodness of God and His will. However, human moral--natural dependencies can be explained by God's will. So a slightly restricted version of divine commandment theory is defensible.},
	bdsk-url-1 = {https://www.cambridge.org/core/product/identifier/S0034412510000752/type/journal_article},
