	author = {Born, Georgina and Devine, Kyle},
	date = {2015-09},
	doi = {10.1017/S1478572215000018},
	file = {Full Text PDF:/Users/siainbuletin/Zotero/storage/7JCD9A6A/Born and Devine - 2015 - Music Technology, Gender, and Class Digitization, Educational and Social Change in Britain.pdf:application/pdf},
