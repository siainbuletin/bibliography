	file = {Full Text PDF:/Users/siainbuletin/Zotero/storage/LBT9XXM2/Rose - 2023 - Songs in Isolation Social Commentary and Contagion, COVID-19, and Creative Practice in Electronic M.pdf:application/pdf},
	groups = {📝 AI in Music},
	issn = {2653-5939},
	issue = {2},
