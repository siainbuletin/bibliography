@article{ZangwillA-Way-out-,
	author = {Zangwill, Nick},
	date = {2012-03},
	doi = {10.1017/S0034412510000752},
	file = {Zangwill - 2012 - A way out of the Euthyphro dilemma.pdf:/Users/siainbuletin/Zotero/storage/CJF5PLR4/Zangwill - 2012 - A way out of the Euthyphro dilemma.pdf:application/pdf},
