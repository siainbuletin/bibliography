@article{MarchReview:-Vi,
	author = {March, Lucy},
	date = {2023-09-01},
	doi = {10.1525/jpms.2023.35.3.138},
	groups = {📝 AI in Music},
	journal = {Journal of Popular Music Studies},
	number = {3},
	pages = {138--140},
	publisher = {University of California Press},
	shortjournal = {Journal of Popular Music Studies},
	title = {Review: {{Virtual Music}}: {{Sound}}, {{Music}}, and {{Image}} in the {{Digital Era}}, by {{Shara Rambarran}}},
	url = {https://online.ucpress.edu/jpms/article/35/3/138/196987/Review-Virtual-Music-Sound-Music-and-Image-in-the},
	urldate = {2024-01-17},
	volume = {35},
	abstract = {Given the near impossibility of separating discussions of popular music trends from the digital environments that increasingly shape them, it is hard to approach music and virtuality from a fresh perspective. With her first single-authored book Virtual Music: Sound, Music and Image in the Digital Era, Shara Rambarran offers a unique contribution to these conversations. In this highly readable monograph, Rambarran illustrates how popular music technologies are shaped by cultural and industrial forces through a wide variety of case studies, from video game soundtracks to gender-bending disco icon Grace Jones. Throughout the book, Rambarran takes a particular interest in ``why, when we hear and view music, there are aspects of the creation in which we are reminded of the past'' and how musical consumption can create a ``futuristic experience'' through listeners' engagement with digital technology (6).Virtual Music's opening chapter provides a historical overview of the technologies that have been used to create, listen to, and disseminate music. According to Rambarran, these technologies lowered the barrier to entry for ``wannabe musicians'' with professional aspirations (21). While outlining the book's theoretical frameworks in chapter two, Rambarran foregrounds philosopher Mark Fisher's notion of hauntology in order to posit that listeners of virtual music ``are experiencing the `after the future' where, in this context, music has reached a point where unique innovations are pretty much nonexistent because we cannot avoid acknowledging the music's past'' (43). Rambarran's engagement with hauntology importantly serves to situate her work in conversation with other scholars who have taken an interest in popular music's current retrofuturist tendencies, including Jean Hogarty and Simon Reynolds.1 At the same time, through Rambarran's considerations of virtual performers in particular, we can see glimmers of new possibilities, identities, and meanings afforded by digital environments.After mapping out the project's historical and theoretical terrain, Rambarran shifts her focus to close examinations of what she refers to as ``digital virtual'' music genres. She begins by tracing experimental music's history and its influences on popular music, arguing that music producers' adoption of digital tools has helped facilitate sonic experimentation, generic hybridity, and stylistic innovation (46). Chapter four explores the musical remix as an evolving concept shaped by technological change by focusing on Danger Mouse's The Grey Album, a mashup record that seamlessly braids the Beatles' White Album with Jay-Z's Black Album. But Rambarran's assertion in this chapter that the remix ``is not tied to digital technology alone'' warrants further unpacking (64). For example, Aram Sinnreich claims that unlike musical quotations from previous centuries, thanks to new technologies, the modern-day remix's ``locus of action is no longer limited to the idea of the music, located within conceptual mechanisms such as melody, chord changes, or composition. What is acted on in these new practices is the musical expression itself.''2 Rambarran does not go quite as far as Sinnreich does in thinking of musical culture and technology as now entirely symbiotic. She does, however, credit technology with ``enabling'' or ``encouraging'' these trends, an important distinction from Sinnreich's more technological determinist take.Of the case studies, chapter five's examination of video game music is the strongest. Rambarran presents Cuphead, the first video game to occupy the top of Billboard's jazz chart as a compelling example of video game music's retro aesthetics. She elegantly weaves analyses of the game's score with its hand-drawn aesthetics, which were designed to evoke early twentieth-century animation practices. At the same time, while the game's composer, Kristofer Maddigan, wanted the music to ``sound like the 1930s, he did not want it to be a direct simulation of it'' (85). By adding musical references to franchises such as Final Fantasy, the composer allows the golden age of jazz and video games to co-exist, creating a world that Rambarran describes as ``the unimaginable, unthinkable, and unexpected---that is, the virtual'' (6).In the final chapters, Rambarran shifts focus to identity, fans, and networks. She brilliantly applies Mike Featherstone's typification of postmodern identities by recognizing ``inauthentic authenticity'' in the work of musicians who play with multiple identities through the use of simulated images.3 Rambarran applies this concept to Grace Jones's post-human play with gender in the music video for ``Love You to Life,'' which layers undulating fluorescent lights over her face, in order to demonstrate virtual music's dependence upon immersive visual language. Rambarran's analysis weakens in her discussion of Hatsune Miku, where she argues that the Japanese virtual idol is better received in Japan than, for instance, by her students, because ``people [in Japan] take technology extremely seriously'' (123). This claim feels reductive and dismissive of Miku's substantial North American fan base and collaborations with artists such as John Legend and Lady Gaga. Rambarran concludes by reflecting on the crucial role of platforms in both music consumption and production. But her extended discussion of ``album apps'' neglects more detailed consideration of major players such as YouTube and SoundCloud (137).Virtual Music is extremely accessible, a characteristic Rambarran intentionally sought to cultivate. Accordingly, Rambarran did not apply an overarching methodological framework to her analyses. At the same time, some statements merit additional empirical and theoretical examination. For example, Rambarran claims that artists today ``are able to take control of their work in a way that has never been possible before, having the freedom to determine how they create, perform, and share their music with their fans'' (3). This assertion overlooks the impact of algorithmically driven platforms on artists' livelihoods, such as Halsey's recent complaint that their former label Capitol Records pressured them to fabricate viral TikTok moments as a contingency for the release of their new single. In contrast, Rambarran's proposal that the music industry is now a collective of ``micro'' industries that must constantly keep up with developments in digital music practices accounts for these dynamics, and seems more reflective of the range of case studies covered in this book (4).Overall, Virtual Music is a valuable primer on popular music and digital culture for those looking to engage in their own research on these topics. It would be particularly useful as an introductory text for a graduate or advanced undergraduate seminar.},
	bdsk-url-1 = {https://online.ucpress.edu/jpms/article/35/3/138/196987/Review-Virtual-Music-Sound-Music-and-Image-in-the},
	bdsk-url-2 = {https://doi.org/10.1525/jpms.2023.35.3.138}}

