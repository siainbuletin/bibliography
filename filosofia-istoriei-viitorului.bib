@article{ZangwillDilemmas-a,
	author = {Zangwill, Nick},
	date = {1999-03},
	doi = {10.1017/S0953820800002272},
	file = {Zangwill - 1999 - Dilemmas and Moral Realism.pdf:/Users/siainbuletin/Zotero/storage/K5N5STKE/Zangwill - 1999 - Dilemmas and Moral Realism.pdf:application/pdf},
	groups = {📝 AI in Music},
	issn = {0953-8208, 1741-6183},
	journal = {Utilitas},
	number = {1},
	pages = {71--90},
	shortjournal = {Utilitas},
	title = {Dilemmas and {{Moral Realism}}},
	url = {https://www.cambridge.org/core/product/identifier/S0953820800002272/type/journal_article},
	urldate = {2024-01-29},
	volume = {11},
	abstract = {I distinguish two different arguments against cognitivism in Bernard Williams's writings on moral dilemmas. The first turns on there being a truth of the matter about what we ought to do in a moral dilemma. That argument can be met by appealing to our epistemic shortcomings and to               pro tanto               obligations. However, those responses make no headway with the second argument, which concerns the rationality of the moral regret that we feel in dilemma situations. I show how the rationality of moral regret can be explained on an `independent desire' model. And I show how Williams's second argument only appears to have force because of a certain faulty way of conceiving the issue over cognitivism. But Williams's argument rightly alerts us to the rational role of desire in our moral thought.},
	bdsk-url-1 = {https://www.cambridge.org/core/product/identifier/S0953820800002272/type/journal_article},
	bdsk-url-2 = {https://doi.org/10.1017/S0953820800002272}}

