@video{AI-Music-Creativity-2020Music-from,
	date = {2020-10-01},
	editor = {{AI Music Creativity 2020}},
	editortype = {director},
	entrysubtype = {video},
	groups = {📝 AI in Music},
	title = {Music from {{EDSAC}}, Mvt. 1 (circa 1960)},
	url = {https://www.youtube.com/watch?v=gogIM2kKB1U},
	urldate = {2024-01-16},
	abstract = {``Music from EDSAC'' was composed sometime around 1960 using the ``Electronic delay storage automatic calculator'' -- or EDSAC for short -- a computer at Cambridge University (UK). The music-generation programs were written by Professor of Economics, D. G. Champernowne -- a friend and collaborator of Alan Turing with whom he programmed the first chess playing computer in the 1950s. Very little is written about ``Music from EDSAC''. Aspects of it seems to have been first discussed in a technical report of the University of Illinois School of Music, Experimental Music Studio, ``Report on Contemporary Experimental Music, 1961'' by L. A. Hiller, Jr. This report was assembled by Hiller after traveling to Europe to learn about the state of contemporary music there. Hiller visited Cambridge University in November of 1961, so presumably that is where he became aware of Champernowne and his work. Hiller assembled a score from parts sent to him by Champernowne in 1961. This score was found in the archives of Hiller at the University at Buffalo, NY. Hiller writes that he had the work performed and made a recording of it, but that is lost. Permission for the performance of this work is granted by the Champernowne family. Funding for the performance comes from MUSAiC - Music at the Frontiers of Artificial Creativity and Criticism" (ERC-2019-COG No. 864189). Musicians: Gentilia Pop K{\aa}rfors (1st violin), Kent Carlsson (2nd violin), Ulf Larsson (viola), Per-Ola Claesson (violoncello), Sofia Winiarski (conductor). More information: https://highnoongmt.wordpress.com/202...},
	bdsk-url-1 = {https://www.youtube.com/watch?v=gogIM2kKB1U}}

