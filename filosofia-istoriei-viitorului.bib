@book{MagnussonSonic-Writ,
	author = {Magnusson, Thor},
	date = {2019},
	doi = {10.5040/9781501313899},
	edition = {1},
	file = {Thor Magnusson - Sonic Writing_ Technologies of Material, Symbolic, and Signal Inscriptions-Bloomsbury Academic (2019).pdf:/Users/siainbuletin/Zotero/storage/X8PGI7YA/Thor Magnusson - Sonic Writing_ Technologies of Material, Symbolic, and Signal Inscriptions-Bloomsbury Academic (2019).pdf:application/pdf},
