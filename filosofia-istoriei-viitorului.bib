@article{FennerThe-Aesthe,
	author = {Fenner, David},
	date = {2024-01-09},
	doi = {10.1093/jaac/kpad061},
	file = {Snapshot:/Users/siainbuletin/Zotero/storage/DAYGHPPY/7513677.html:text/html},
	groups = {📝 AI in Music},
	issn = {0021-8529},
	journal = {The Journal of Aesthetics and Art Criticism},
	pages = {kpad061},
	shortjournal = {The Journal of Aesthetics and Art Criticism},
	title = {The {{Aesthetic Analysis}} of a {{Garden}}},
	url = {https://doi.org/10.1093/jaac/kpad061},
	urldate = {2024-01-30},
	abstract = {Offering aesthetic judgments of gardens is common. These judgments follow an evidentiary structure that is common to the evaluation of other aesthetic objects: summary judgments evidenced by the attribution of narrow formal aesthetic properties, ``formal-adjacent'' aesthetic properties, and relevant contextual relations. Yet, in a garden, these evidencing properties and relations take on forms that are different from those of other aesthetic and/or art objects. In this article, I consider these differences and consider whether aesthetic analyses of gardens rest on one or more conceptual mistakes. In the end, I conclude that we can meet all challenges.},
	bdsk-url-1 = {https://doi.org/10.1093/jaac/kpad061}}

