	url = {https://www.youtube.com/watch?v=BTLONBQiYFs},
	urldate = {2024-01-30},
	abstract = {This performance demonstrates an AI-composed piece of music played in Ars Electronica's Deep Space 8K. The music was composed by the software Ricercar, an AI-based music composition system being developed at the Ars Electronica Futurelab by Ali Nikrang. We fed Ricarcar a few measures from Franz Schubert -- Grande Sonate in B flat for piano duet, D. 617 2nd movement and composed a piece of music based on this initial musical idea. The result was arranged for piano trio and performed by Daniela M{\"u}lleder (violin), Yishu Jiang (cello), Ali Nikrang (piano) and visualized by Cori O'Lan. The recording was part of the premiere event of the documentary NAKED AI: What happens when Artificial Intelligence and Human Creativity meet?  produced by Cisco Systems Italy S.r.l and Logotel S.p.A. ------------------------------------------------------ Performance: Violine: Daniela M{\"u}lleder Cello: Yishu Jiang Piano: Ali Nikrang Visualization: Cori O'Lan Music: Ricercar (Ali Nikrang, Ars Electronica Futurelab) Video: Camera: Yazdan Zand Sound: Joschi Viteka Director: Thomas Schwarz Deep Space 8K (Ars Electronica Center) A project by Cisco Systems Italy S.r.l and Logotel S.p.A ------------------------------------------------------ Ricercar: https://ars.electronica.art/futurelab... NAKED AI: What happens when Artificial Intelligence and Human Creativity meet? https://naked-ai.com/ ------------------------------------------------------ Ars Electronica https://ars.electronica.art/ ~~/~arselectronica~~ ~~/~arselectronica~~ ~~/~arselectronica~~ https://www.flickr.com/photos/arselec...},
	bdsk-url-1 = {https://www.youtube.com/watch?v=BTLONBQiYFs}}

@video{Ars-ElectronicaDeep-Space,
	date = {2022-05-12},
	editor = {{Ars Electronica}},
	editortype = {director},
	entrysubtype = {video},
	groups = {📝 AI in Music},
	title = {Deep {{Space EVOLUTION}} -- {{Sounding Letters}}},
	url = {https://www.youtube.com/watch?v=O1mO5qxRvvk},
	urldate = {2024-01-30},
	abstract = {What happens when artificial intelligence is used to give a sequence of individual letters a sound in order to compose music together with them? A captivating virtual experience: the new program "Sounding Letters" at Ars Electronica Center's Deep Space 8K shows how humans and AI create music together with a 3D piano concert. With his AI-based music composition system Ricercar, Ali Nikrang, artist and researcher at the Ars Electronica Futurelab, interpreted the initials A.E.F. (Ars Electronica Futurelab) and A.E.C. (Ars Electronica Center) as musical notes and composed a theme on that basis. The final composition Sounding Letters was created in close collaboration between man and machine. The artist's harmonic performance with a self-playing B{\"o}sendorfer CEUS piano expresses this creative alliance musically. Experience this unique performance in Deep Space 8K at the Ars Electronica Center -- virtually and in 3D. Visuals calculated in real time by Florian Berger react to the sounds of the human-AI composition and merge with the stereoscopic video by Raphael Schaumburg-Lippe in Deep Space 8K to create a unique experience.    Credit:     Florian Berger  Ali Nikrang  Raphael Schaumburg Lippe  ------------------------------------------------------ Ars Electronica https://ars.electronica.art/ ~~/~arselectronica~~ ~~/~arselectronica~~ ~~/~arselectronica~~ https://www.flickr.com/photos/arselec...},
	bdsk-url-1 = {https://www.youtube.com/watch?v=O1mO5qxRvvk}}

