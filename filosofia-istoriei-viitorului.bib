	eprinttype = {arxiv},
	file = {arXiv Fulltext PDF:/Users/siainbuletin/Zotero/storage/Y2Z3VCYK/Yan - 2023 - Generating Rhythm Game Music with Jukebox.pdf:application/pdf;arXiv.org Snapshot:/Users/siainbuletin/Zotero/storage/LXACGFIS/2401.html:text/html},
