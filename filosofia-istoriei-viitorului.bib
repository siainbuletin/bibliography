	date = {2020-06-01},
	doi = {10.1007/s00146-019-00888-w},
	groups = {4: Blackbox AI and Alienation},
	issn = {1435-5655},
	journal = {AI \& SOCIETY},
	keywords = {Artificial intelligence,Deep neural networks,GDPR,Instrumental reason,Machine learning,Philosophy of technology,XAI},
	number = {2},
