@article{CaballeroDancing-ou,
	author = {Caballero, Carlo},
	date = {2013},
	eprint = {23594801},
	eprinttype = {jstor},
	file = {Caballero - 2013 - Dancing out of Formalism On Peter Kivy's Theory and Its Limits.pdf:/Users/siainbuletin/Zotero/storage/E6LYZRRP/Caballero - 2013 - Dancing out of Formalism On Peter Kivy's Theory and Its Limits.pdf:application/pdf},
	groups = {📝 AI in Music},
	journal = {International Review of the Aesthetics and Sociology of Music},
	number = {2},
	pages = {277--301},
	title = {Dancing out of {{Formalism}}: {{On Peter Kivy}}'s {{Theory}} and {{Its Limits}}},
	url = {http://www.jstor.org/stable/23594801},
	volume = {44},
	abstract = {R{\'e}sum{\'e} »tnhanced formalism« is one of the central tenets of Peter Kivy's musical aesthetics. It frames his understanding of how to listen to instrumental music as well as his theories about the nature of emotion and meaning in music. Yet the internal coherence of Kivy's ideas has tended to mask their reliance on a description of »canonical listening« that is both idio syncratic and indifferent to historical and phenomeno logical conditions that speak against it. The present essay analyzes the stakes behind Kivy's defense of his own position in recent debates with other scholars and seeks to open up alternatives by recov ering the kinship of instru mental music with the expressive claims of genre and bodily motion.},
	bdsk-url-1 = {http://www.jstor.org/stable/23594801}}

