@video{Ars-ElectronicaFuture-Inn,
	date = {2018-02-05},
	editor = {{Ars Electronica}},
	editortype = {director},
	entrysubtype = {video},
	groups = {📝 AI in Music},
	title = {Future {{Innovators Summit}} 2017},
	url = {https://www.youtube.com/watch?v=GTQSpeLW-cQ},
	urldate = {2024-01-30},
	abstract = {Following its successful premiere at Ars Electronica Festival 2014, the Future Innovators Summit (FIS) has established itself as a dynamic think-tank and key program within Ars Electronica Festival. In September 2017, Future Innovators from different cultures and backgrounds and from different fields such as artists, designers, scientists, engineers, entrepreneurs, social activists and philosophers gathered in Linz to explore new ways of collective brainstorming and creative prototyping on the crucial questions of the future. Supported by experienced partners such as Hakuhodo and Internet Foundation Austria as well as outstanding experts from all over the world, the Future Innovators of the Future Innovators Summit 2017 was challenged to look for the ultimate Creative Question which will lead us to think about Missions for Tomorrow-- concepts which are inevitably linked to the main topic of the festival ``Artificial Intelligence -- The Other I''. https://www.aec.at/ai/en/fis/ Ars Electronica https://www.aec.at ~~/~arselectronica~~ ~~/~arselectronica~~ ~~/~arselectronica~~ https://www.flickr.com/photos/arselec...},
	bdsk-url-1 = {https://www.youtube.com/watch?v=GTQSpeLW-cQ}}

@video{Ars-ElectronicaInside-Fut,
	date = {2020-12-08},
	editor = {{Ars Electronica}},
	editortype = {director},
	entrysubtype = {video},
	groups = {📝 AI in Music},
	title = {Inside {{Futurelab}}: {{Ricercar}}},
	url = {https://www.youtube.com/watch?v=3x6A6onLBHE},
	urldate = {2024-01-30},
	abstract = {Futurelab Key Researcher \& Artist Ali Nikrang presents the project 'Ricercar', an interactive AI-based music composition system. The word Ricercar refers to\,a musical form of the Baroque and Renaissance and means ``to search out'' in its Italian origin. Composers used this term for pieces in which they experimented with a theme or musical idea and discovered its qualities such as permutation and variation possibilities as well as its harmonic potential. 'Ricercar: An AI-based Musical Companion' follows a similar idea. It aims to create an intuitive interface between human artists and an AI-based composition system, where human users and the AI system can discover the potential of a musical idea (given to the system by the users or initialized by the system itself) in a collaborative way. The interaction takes advantage of the benefits of artificial creativity, together with the ability to control and personalize the output of the system by human users. Find more information about the Ars Electronica Futurelab here: https://ars.electronica.art/futurelab... Ars Electronica  https://ars.electronica.art/  ~~/~arselectronica~~  ~~/~arselectronica~~  ~~/~arselectronica~~  https://www.flickr.com/photos/arselec...},
	bdsk-url-1 = {https://www.youtube.com/watch?v=3x6A6onLBHE}}

